{
  "name": "sngroup-nettsider",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test scripts/apptest-versjon.test.mjs scripts/apptest-passord.test.mjs scripts/apptest-innhold.test.mjs scripts/demo.test.mjs scripts/dokumenter.test.mjs scripts/app-lenker.test.mjs scripts/design-fasit.test.mjs scripts/tokens-avvik.test.mjs && node scripts/sjekk-lenker.mjs",
    "skjermbilder": "node scripts/skjermbilder.mjs",
    "skjermer": "node scripts/fiktive-skjermer.mjs",
    "kvalitet:k177": "node scripts/kvalitet-k177.mjs",
    "skjermbilder:vis": "node scripts/skjermbilder-vis.mjs",
    "rammer:vis": "node scripts/rammer-vis.mjs",
    "dev:sngroup": "npm run dev -w sites/sngroup",
    "dev:hengsel": "npm run dev -w sites/hengsel",
    "dev:byggem": "npm run dev -w sites/byggem",
    "dev:design": "npm run dev -w sites/design",
    "design:hent": "node scripts/hent-designsystem.mjs",
    "design:skjermbilder": "node scripts/skjermbilder-design.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "1.56",
    "wrangler": "^4.148.0"
  }
}

{
  "name": "sngroup-nettsider",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test scripts/apptest-versjon.test.mjs scripts/apptest-passord.test.mjs && node scripts/sjekk-lenker.mjs",
    "skjermbilder": "node scripts/skjermbilder.mjs",
    "skjermbilder:vis": "node scripts/skjermbilder-vis.mjs",
    "rammer:vis": "node scripts/rammer-vis.mjs",
    "dev:sngroup": "npm run dev -w sites/sngroup",
    "dev:hengsel": "npm run dev -w sites/hengsel",
    "dev:byggem": "npm run dev -w sites/byggem"
  },
  "devDependencies": {
    "playwright": "1.56",
    "wrangler": "^4.148.0"
  }
}

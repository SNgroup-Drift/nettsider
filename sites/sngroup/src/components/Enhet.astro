---
/**
 * Apple-ramme med skjermbilde. Bildet ligger under rammen og klippes til skjermhullet.
 * Rammene (public/enheter) er Apples og stilises ikke med CSS; CSS-en under gjelder bare plasseringen av bildet i skjermhullet.
 * Ingen tekst eller merker oppå enheten: bildetekst og knapper står ved siden av.
 */
export type EnhetType = "studio-display" | "macbook" | "iphone-18" | "ipad-liggende";

interface Props {
  type: EnhetType;
  /** Navn på skjermbildet i public/skjermbilder uten filtype, f.eks. «ute-i-dag» (<navn>.webp = 2×, <navn>@1x.webp = 1×, <navn>-mork… = mørk utgave) */
  bilde: string;
  /** Skjermen har mørk utgave (CRM og Hengsel Ute følger temaet; kundeportalen er alltid lys) */
  mork?: boolean;
  alt: string;
  loading?: "lazy" | "eager";
}

const MAL = {
  "studio-display": { ramme: "studio-display-ramme", b: 2160, h: 1664 },
  macbook: { ramme: "macbook", b: 2400, h: 1565 },
  "iphone-18": { ramme: "iphone-18", b: 1174, h: 2400 },
  "ipad-liggende": { ramme: "ipad-liggende", b: 2400, h: 1740 },
} as const;

const { type, bilde, alt, mork = false, loading = "lazy" } = Astro.props;
const sett = (n: string) => `/skjermbilder/${n}@1x.webp 1x, /skjermbilder/${n}.webp 2x`;
const m = MAL[type];
// Skjermbildets egne mål (2×): width og height, så ingenting hopper
const BILDE = { "studio-display": [2880, 1620], macbook: [2880, 1800], "iphone-18": [780, 1688], "ipad-liggende": [2360, 1640] } as const;
const [bb, bh] = BILDE[type];
---
<div class={`enhet enhet-${type}`}>
  <div class="hull">
    <picture>
      {mork && <source media="(prefers-color-scheme: dark)" srcset={sett(`${bilde}-mork`)} />}
      <img class="bilde" src={`/skjermbilder/${bilde}.webp`} srcset={sett(bilde)} width={bb} height={bh} alt={alt} loading={loading} decoding="async" />
    </picture>
  </div>
  <img class="ramme" src={`/enheter/${m.ramme}.png`} alt="" width={m.b} height={m.h} aria-hidden="true" />
</div>

<style>
  .enhet { position: relative; width: 100%; aspect-ratio: var(--ratio); }
  /* Mål fra delt/pakke-v3/INSTRUKS.md: rammens størrelse og skjermhullet som andel av rammen. Stil settes her, ikke inline (CSP). */
  .enhet-studio-display { --ratio: 2160 / 1664; --l: 2.59%; --t: 3.37%; --w: 94.81%; --h: 69.23%; --r: 0.7% / 0.9%; }
  .enhet-macbook { --ratio: 2400 / 1565; --l: 12.63%; --t: 14.19%; --w: 74.75%; --h: 71.63%; --r: 0.8% / 1.2%; }
  .enhet-iphone-18 { --ratio: 1174 / 2400; --l: 5.37%; --t: 2.5%; --w: 89.27%; --h: 95%; --r: 14% / 6.1%; }
  .enhet-ipad-liggende { --ratio: 2400 / 1740; --l: 5%; --t: 6.84%; --w: 90%; --h: 86.32%; --r: 4% / 5.5%; }
  .hull {
    position: absolute;
    left: var(--l);
    top: var(--t);
    width: var(--w);
    height: var(--h);
    overflow: hidden;
    border-radius: var(--r);
    background: var(--flate);
  }
  .hull picture { display: block; width: 100%; height: 100%; }
  .bilde { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .ramme { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
</style>

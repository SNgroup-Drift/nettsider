---
import BaseLayout from "@sngroup/design/components/BaseLayout.astro";
import "@sngroup/design/fonts.css";
import Toppfelt from "@sngroup/design/components/Toppfelt.astro";
import Familiebaand from "@sngroup/design/components/Familiebaand.astro";
import SiteFooter from "@sngroup/design/components/SiteFooter.astro";
import Logo from "../components/Logo.astro";
import { selskap } from "../content/selskap";

interface Props { title: string; description?: string; noindex?: boolean }
const {
  title,
  description = "SN Group – ES-HOLDING AS, Trondheim. Kjøkken og interiør, eiendom og egne digitale verktøy, blant annet montørappen Hengsel Ute.",
  noindex,
} = Astro.props;
const hjem = Astro.url.pathname === "/" ? "" : "/";
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <Toppfelt
    hjem="/"
    ordmerke={selskap.merkenavn}
    lenker={[
      { href: `${hjem}#virksomheter`, label: "Virksomheter" },
      { href: `${hjem}#hengsel`, label: "Hengsel" },
    ]}
    kontaktHref={`${hjem}#kontakt`}
    kontaktTekst="Kontakt"
  >
    <Logo slot="logo" />
  </Toppfelt>
  <slot />
  <Familiebaand gjeldende="sngroup.no" hengselLogo={{ lys: "/logo/hengsel-aksent-lys.svg", mork: "/logo/hengsel-aksent-mork.svg" }} />
  <SiteFooter
    selskap={selskap.navn}
    orgnr={selskap.orgnr}
    adresse={selskap.adresse}
    epost={selskap.epost}
    personvernTekst="Personvern · Hengsel"
    visDelAv={false}
  />
</BaseLayout>

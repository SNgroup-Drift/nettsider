---
/**
 * Ramme for design.hengsel.no (K-182): <head> med designsystemets tokens og skrifter (selvhostet), favicon og og:image med merket v3, Meny og Bunn.
 * Åpen men ikke indeksert: noindex i meta og i _headers (X-Robots-Tag). Ingen sporing, ingen eksterne ressurser.
 */
import "../styles/design.css";
import Meny from "../components/Meny.astro";
import Bunn from "../components/Bunn.astro";
import { lagFasitCss } from "../lib/tokens";
import type { MenyNokkel } from "../content/nav";

interface Props { title: string; description: string; aktiv?: MenyNokkel | ""; }
const { title, description, aktiv = "" } = Astro.props;
const sti = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
const canonical = new URL(sti, Astro.site).href;
const og = new URL("/og.png", Astro.site).href;
const css = lagFasitCss();
---
<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F2E9DB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1F1914" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="preload" href="/ds/assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/ds/assets/fonts/newsreader-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/ds/tokens/fonts.css" />
    <link rel="stylesheet" href="/ds/tokens/tokens.css" />
    <slot name="head" />
    <style is:inline set:html={css}></style>
  </head>
  <body>
    <a class="skip" href="#innhold">Hopp til innholdet</a>
    <div class="side">
      <Meny aktiv={aktiv} />
      <main id="innhold"><slot /></main>
      <Bunn />
    </div>
    <script>
      import "../scripts/tema";
    </script>
  </body>
</html>

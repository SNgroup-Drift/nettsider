---
/**
 * Ramme for design.hengsel.no (K-182): <head> med de delte tokens (@sngroup/hengsel-tokens, K-192) og skrifter (selvhostet), favicon og og:image med merket v3, Meny og Bunn.
 * Bare lys modus: ingen bryter, ingen mørk theme-color.
 * Åpen men ikke indeksert: noindex i meta og i _headers (X-Robots-Tag). Ingen sporing, ingen eksterne ressurser.
 */
import "@sngroup/hengsel-tokens/tokens.css";
import "@sngroup/hengsel-tokens/tokens-mork-prover.css"; // K-202: mørke fargeprøver, bare under .mork-prover (ikke :root)
import "@sngroup/hengsel-tokens/fonts.css";
import "../styles/design.css";
import schibsted from "@sngroup/hengsel-tokens/ds/assets/fonts/schibsted-grotesk-latin-wght-normal.woff2?url";
import tokens from "@sngroup/hengsel-tokens/tokens.json";
import Meny from "../components/Meny.astro";
import Bunn from "../components/Bunn.astro";
import { lagFasitCss } from "../lib/tokens";
import type { MenyNokkel } from "../content/nav";

interface Props { title: string; description: string; aktiv?: MenyNokkel | ""; }
const { title, description, aktiv = "" } = Astro.props;
const sti = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
const canonical = new URL(sti, Astro.site).href;
const og = new URL("/og.png", Astro.site).href;
const css = lagFasitCss();
---
<!doctype html>
<html lang="nb" data-produkt="nettsider">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={tokens.farge["flate-side"].lys} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-flis.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="preload" href={schibsted} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style is:inline set:html={css}></style>
  </head>
  <body>
    <a class="skip" href="#innhold">Hopp til innholdet</a>
    <div class="side mork-prover">
      <Meny aktiv={aktiv} />
      <main id="innhold"><slot /></main>
      <Bunn />
    </div>
  </body>
</html>

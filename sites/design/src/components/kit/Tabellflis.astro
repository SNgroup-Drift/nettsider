---
/**
 * Kitet (kopi fra N-3, utvidet i N-5): tabellflisen i to utgaver (regel 2c/2d, sidekartet 29-003 og 29-004).
 *  - «kompakt» (Tabell kompakt, ≤9 rader, 320/480): tittel med teller, søk i tittelfeltet, overskrift 36, rader 40, uten bunnfelt.
 *    Høyden velges med tabellHoyde(n) og settes på raden (Rad.astro).
 *  - «full» (Tabell, 640): tittel med antall til høyre, verktøylinje (søk 240 px til venstre, filter og handlinger til høyre for søket),
 *    overskrift 36, rader 44, sidevelger nederst.
 * Tall høyrejustert med tabulære sifre (kolonne `tall`), status som pille. Tekst som ikke får plass kuttes med … og står hel i tooltip.
 * Telefon: første og siste kolonne; raden åpner resten under seg. Søk, filter og rader som åpnes styres av kit.ts.
 */
import Flis from "./Flis.astro";
import Sok from "./Sok.astro";
import Pille, { type Tone } from "./Pille.astro";

export type Celle = string | { pille: string; tone?: Tone };
export interface Kolonne { navn: string; tall?: boolean; /** Bredde i prosent, 10–50 i steg på 5 */ bredde?: number }
export interface TabellRad { celler: Celle[]; /** Status for filteret i verktøylinja */ status?: string; /** Mer om raden: vises når raden åpnes */ mer?: string }
/** Trinnet i høydeskalaen for en Tabell kompakt med n rader (regel 2d, Eirik 17.10 kl. 13.36) */
export const tabellHoyde = (n: number) => (n <= 5 ? 320 : n <= 9 ? 480 : 640);

interface Props {
  id: string;
  tittel: string;
  kolonner: (string | Kolonne)[];
  rader: (Celle[] | TabellRad)[];
  variant?: "kompakt" | "full";
  /** «Søk · Filter» som tekst foran søket i tittelfeltet (29-004) */
  verktoyTekst?: string;
  /** full: antallet til høyre i tittelen (alle rader, ikke bare siden) */
  antall?: number;
  /** full: filterknappene (første er «Alle») og handlingene i verktøylinja */
  filter?: string[];
  butikker?: string[];
  handlinger?: string[];
  /** full: sidevelgeren */
  side?: { fra: number; til: number; sider: number };
  /** Lang tekst brytes over flere linjer i stedet for å kuttes (regeltabellene under mønstrene; høyden følger radene) */
  bryt?: boolean;
}
const { id, tittel, kolonner, rader, variant = "kompakt", verktoyTekst, antall, filter = [], butikker = [], handlinger = [], side, bryt = false } = Astro.props;
const full = variant === "full";
const kol: Kolonne[] = kolonner.map((k) => (typeof k === "string" ? { navn: k } : k));
const n = kol.length;
const liste: TabellRad[] = rader.map((r) => (Array.isArray(r) ? { celler: r } : r));
const midt = (i: number) => i > 0 && i < n - 1;
const tekstAv = (c: Celle) => (typeof c === "string" ? c : c.pille);
const butikkKol = kol.findIndex((k) => k.navn === "Butikk");
const fmt = (t: number) => t.toLocaleString("nb-NO").replace(/ /g, " ");
---
<Flis id={id} bredde="1/1" tittel={tittel} teller={full ? (antall !== undefined ? fmt(antall) : undefined) : liste.length} tellerHoyre={full} klasse={`k-tabellflis ${variant}`}>
  {!full && (
    <div slot="verktoy" class="k-tittelverktoy">
      {verktoyTekst && <span class="k-verktoytekst">{verktoyTekst}</span>}
      <Sok hva={tittel.replace(/\.$/, "")} />
    </div>
  )}
  {full && (
    <div class="k-verktoylinje">
      <Sok hva={tittel} bred />
      {filter.length > 0 && (
        <div class="k-filter" role="group" aria-label="Filter">
          <span class="k-filteretikett">Filter:</span>
          {filter.map((f, i) => (
            <Fragment>
              {i > 0 && <span class="k-prikk" aria-hidden="true">·</span>}
              <button type="button" class="k-filterknapp" data-filter={i === 0 ? "" : f} aria-pressed={i === 0 ? "true" : "false"}>{f}</button>
            </Fragment>
          ))}
          {butikker.length > 0 && (
            <Fragment>
              <span class="k-prikk" aria-hidden="true">·</span>
              <label class="k-butikk"><span class="skjult">Butikk</span>
                <select data-butikk-filter={butikkKol}>
                  <option value="">Butikk</option>
                  {butikker.map((b) => <option value={b}>{b}</option>)}
                </select>
              </label>
            </Fragment>
          )}
          {handlinger.map((h) => (
            <Fragment>
              <span class="k-prikk" aria-hidden="true">·</span>
              <button type="button" class="k-filterknapp" aria-disabled="true" title="Plassen for handlinger i verktøylinja (eksempel)">{h}</button>
            </Fragment>
          ))}
        </div>
      )}
    </div>
  )}
  <table class:list={["k-tabell", variant, { bryt }]} data-tabell>
    {kol.some((k) => k.bredde) && <colgroup>{kol.map((k) => <col class={k.bredde ? `w${k.bredde}` : undefined} />)}</colgroup>}
    <thead>
      <tr>{kol.map((k, i) => <th scope="col" class:list={{ midt: midt(i), tall: k.tall }}>{k.navn}</th>)}</tr>
    </thead>
    <tbody>
      {liste.map((r, ri) => {
        const harMidt = n > 2;
        const apnes = harMidt || !!r.mer;
        const detId = `${id}-rad-${ri}`;
        return (
          <Fragment>
            <tr data-rad data-status={r.status} data-bare-tlf={apnes && !r.mer ? "" : undefined}>
              {r.celler.map((c, i) => {
                const t = tekstAv(c);
                const innhold = typeof c === "string" ? <span class="k-celle" title={t}>{t}</span> : <Pille tone={c.tone}>{c.pille}</Pille>;
                return i === 0
                  ? <th scope="row">{apnes
                      ? <button type="button" class="k-apne" aria-expanded="false" aria-controls={detId} data-apne title={t}><span class="k-celle">{t}</span><svg class="k-pil" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path d="M6 8l4 4 4-4" /></svg></button>
                      : innhold}</th>
                  : <td class:list={{ midt: midt(i), tall: kol[i]?.tall }} data-verdi={t}>{innhold}</td>;
              })}
            </tr>
            {apnes && (
              <tr class:list={["k-detalj", { "bare-tlf": !r.mer }]} id={detId} data-detalj hidden>
                <td colspan={n}>
                  {harMidt && (
                    <dl class="k-midtfelt">
                      {kol.map((k, i) => midt(i) && <div><dt>{k.navn}</dt><dd>{tekstAv(r.celler[i])}</dd></div>)}
                    </dl>
                  )}
                  {r.mer && <p class="k-mer">{r.mer}</p>}
                </td>
              </tr>
            )}
          </Fragment>
        );
      })}
      <tr class="k-ingen" data-ingen hidden><td colspan={n}>Ingen treff.</td></tr>
    </tbody>
  </table>
  {full && side && (
    <div class="k-sidevelger">
      <p class="k-sideinfo">{side.fra}–{side.til} av {fmt(antall ?? liste.length)}</p>
      <div class="k-sider">
        <label class="k-perside"><span class="skjult">Rader per side</span>
          <select><option>10 per side</option><option>25 per side</option><option>50 per side</option></select>
        </label>
        <nav class="k-sidetall" aria-label={`Sider i ${tittel}`}>
          <button type="button" class="k-side" aria-label="Forrige side" disabled>‹</button>
          <button type="button" class="k-side valgt" aria-current="page">1</button>
          <button type="button" class="k-side" disabled>2</button>
          <button type="button" class="k-side" disabled>3</button>
          <span class="k-side tom" aria-hidden="true">…</span>
          <button type="button" class="k-side" disabled>{side.sider}</button>
          <button type="button" class="k-side" aria-label="Neste side" disabled>›</button>
        </nav>
      </div>
    </div>
  )}
</Flis>

<style>
  /* Høyden går opp i trinnet (2d): luft 16 over og under, tittelfelt 40 (full) og tittel 22 med søket i tittelfeltet (kompakt) */
  :global(.k-flis.k-tabellflis) { padding-block: 16px; }
  :global(.k-flis.k-tabellflis > .k-topp) { min-height: 40px; margin: 0; }
  :global(.k-flis.k-tabellflis > .k-finnhold) { margin-top: 0; }
  .k-tittelverktoy { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .k-verktoytekst { color: var(--tekst-dempet); white-space: nowrap; }
  .k-verktoylinje { display: flex; align-items: center; gap: 8px 12px; flex-wrap: wrap; min-height: 36px; margin-bottom: 8px; }
  .k-filter { display: flex; align-items: center; flex-wrap: wrap; gap: 0 4px; color: var(--tekst-dempet); }
  .k-filteretikett { margin-right: 2px; }
  .k-prikk { color: var(--tekst-svak); }
  .k-filterknapp { min-height: 32px; padding: 0 4px; border: 0; border-radius: var(--radius-felt); background: none; color: var(--tekst-dempet); font: inherit; cursor: pointer; }
  .k-filterknapp:hover { color: var(--tekst); background: var(--flate-hover); }
  .k-filterknapp[aria-pressed="true"] { color: var(--aksent-tekst); font-weight: var(--skrift-vekt-sterk); }
  .k-filterknapp[aria-disabled="true"] { cursor: default; }
  .k-butikk select, .k-perside select { height: 32px; padding: 0 8px; border: 1px solid var(--kant); border-radius: var(--radius-felt); background: var(--flate-kort); color: var(--tekst); font: inherit; font-size: 14px; }
  .k-butikk select { border-color: transparent; background: none; color: var(--tekst-dempet); padding: 0 4px; }

  .k-tabell { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 14px; line-height: 20px; }
  .k-tabell th, .k-tabell td { height: 40px; padding: 0 16px 0 0; box-sizing: border-box; text-align: left; vertical-align: middle; border-bottom: 1px solid var(--linje); text-transform: none; letter-spacing: 0; font-size: 14px; color: var(--tekst); white-space: normal; }
  .k-tabell.full th, .k-tabell.full td { height: 44px; }
  .k-tabell thead th { height: 36px; font-weight: var(--skrift-vekt-sterk); color: var(--tekst-dempet); }
  .k-tabell tbody th { font-weight: var(--skrift-vekt-sterk); }
  .k-tabell td { font-weight: var(--skrift-vekt-normal); }
  .k-tabell .tall { text-align: right; font-variant-numeric: tabular-nums; }
  .k-tabell th.tall + th:not(.tall), .k-tabell td.tall + td:not(.tall) { padding-left: 12px; }
  .k-tabell :global(.k-pille) { vertical-align: middle; }
  .k-tabell tr > :last-child { padding-right: 0; }
  .w10 { width: 10%; } .w15 { width: 15%; } .w20 { width: 20%; } .w25 { width: 25%; } .w30 { width: 30%; }
  .w35 { width: 35%; } .w40 { width: 40%; } .w45 { width: 45%; } .w50 { width: 50%; }
  .k-celle { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bryt .k-celle { white-space: normal; overflow: visible; }
  .k-tabell.bryt th, .k-tabell.bryt td { height: auto; min-height: 40px; padding-block: 10px; vertical-align: top; }
  .k-tabell.bryt thead th { padding-block: 8px; }
  .bryt .k-apne { min-height: 0; align-items: flex-start; }
  .k-apne { display: flex; align-items: center; gap: 6px; width: 100%; min-height: 40px; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .k-apne .k-celle { min-width: 0; }
  .k-pil { flex: none; fill: none; stroke: var(--tekst-dempet); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform 160ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .k-apne[aria-expanded="true"] .k-pil { transform: rotate(180deg); }
  .k-apne:disabled { cursor: default; }
  .k-apne:disabled .k-pil { display: none; }
  .k-tabell .k-detalj td { height: auto; padding: 0 0 12px; line-height: 22px; }
  .k-midtfelt { display: none; margin: 0; }
  .k-midtfelt div { display: flex; gap: 8px; }
  .k-midtfelt dt { color: var(--tekst-dempet); }
  .k-midtfelt dd { margin: 0; }
  .k-mer { margin: 0; max-width: 720px; color: var(--tekst-dempet); }
  .k-tabell .k-ingen td { color: var(--tekst-dempet); }

  .k-sidevelger { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; min-height: 44px; margin-top: auto; padding-top: 4px; }
  .k-sideinfo { color: var(--tekst-dempet); font-variant-numeric: tabular-nums; }
  .k-sider { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .k-sidetall { display: flex; gap: 4px; }
  .k-side { min-width: 32px; height: 32px; padding: 0 6px; display: inline-grid; place-items: center; border: 1px solid var(--kant); border-radius: var(--radius-felt); background: var(--flate-kort); color: var(--tekst); font: inherit; font-variant-numeric: tabular-nums; box-sizing: border-box; }
  .k-side:disabled { cursor: default; }
  .k-side.valgt { border-color: var(--aksent); background: var(--flate-valgt); color: var(--aksent-tekst); font-weight: var(--skrift-vekt-sterk); }
  .k-side.tom { border-color: transparent; background: none; }

  @media (max-width: 767.98px) {
    .k-tabell .midt, .k-tabell col { display: none; }
    .k-tabell thead th { width: auto; }
    .k-tabell thead th:first-child { width: 55%; }
    .k-midtfelt { display: flex; flex-direction: column; gap: 2px; padding-bottom: 4px; }
    .k-mer { color: var(--tekst); }
    .k-verktoytekst { display: none; }
    .k-sidetall .k-side:not(.valgt):not([aria-label]) { display: none; }
    .k-sidetall .k-side.tom { display: none; }
  }
  @media (min-width: 768px) {
    .k-detalj.bare-tlf { display: none; }
    tbody tr[data-bare-tlf] .k-pil { display: none; }
  }
  @media (scripting: none) and (max-width: 767.98px) { .k-detalj[hidden] { display: table-row !important; } .k-pil { display: none; } }
</style>

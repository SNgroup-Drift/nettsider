---
/**
 * Kitet (kopi fra N-3, sites/hengsel/src/components/kit, tilpasset 29 Felles mønster i N-5): flisen alle flisklassene bygger på.
 * Samme flate, kant, radius og skrift som CRM-flisene (regel 2 og 2c): tittel 16/600 med teller, innhold, handling nederst til høyre.
 * Bredde 1/4 (bare Tall), 1/3, 1/2 eller 1/1 av 12 kolonner. iPad (768–1199 px, 8 kolonner): 1/4 og 1/3 blir 1/2, og en 1/3 som blir til overs
 * på slutten av raden blir 1/1 (2b: aldri tomt felt). Telefon (under 768 px): alt 1/1. Luft 24 px på PC og 16 px på telefon.
 * Klassene har prefikset k- så de ikke kolliderer med design.css (.kort, .pille, .tabell …).
 */
export type Bredde = "1/4" | "1/3" | "1/2" | "1/1";
interface Props {
  bredde?: Bredde;
  tittel?: string;
  /** Telleren i flistittelen (antall), regel 9 */
  teller?: number | string;
  /** Telleren helt til høyre i tittelfeltet (Kortliste, Liste, Tavle, Uke, Plan) i stedet for rett etter tittelen */
  tellerHoyre?: boolean;
  klasse?: string;
  id?: string;
  /** Tilgjengelig navn når flere fliser på siden har samme tittel (landemerkene må ha ulike navn) */
  etikett?: string;
}
const { bredde = "1/1", tittel, teller, tellerHoyre = false, klasse, id, etikett } = Astro.props;
const b = { "1/4": "b14", "1/3": "b13", "1/2": "b12", "1/1": "b11" }[bredde];
const tittelId = id ? `${id}-tittel` : undefined;
const verktoy = Astro.slots.has("verktoy");
---
<section class:list={["k-flis", b, klasse]} id={id} aria-labelledby={etikett ? undefined : tittelId} aria-label={etikett}>
  {tittel && (
    <div class:list={["k-topp", { "med-verktoy": verktoy }]}>
      <h2 class="k-ftittel" id={tittelId}>{tittel}{teller !== undefined && !tellerHoyre && <span class="k-teller">{teller}</span>}</h2>
      {teller !== undefined && tellerHoyre && <span class="k-teller hoyre">{teller}</span>}
      {verktoy && <slot name="verktoy" />}
    </div>
  )}
  <div class="k-finnhold"><slot /></div>
  {Astro.slots.has("handling") && <div class="k-fhandling"><slot name="handling" /></div>}
</section>

<style>
  .k-flis { min-width: 0; box-sizing: border-box; display: flex; flex-direction: column; padding: 24px; background: var(--flate-kort); border: 1px solid var(--linje); border-radius: var(--radius-kort-stor); color: var(--tekst); font-size: 14px; line-height: 20px; }
  .b14 { grid-column: span 3; }
  .b13 { grid-column: span 4; }
  .b12 { grid-column: span 6; }
  .b11 { grid-column: span 12; }
  .k-topp { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 22px; position: relative; }
  .k-topp.med-verktoy { min-height: 40px; margin-top: -9px; margin-bottom: -9px; }
  .k-ftittel { margin: 0; min-width: 0; font-family: var(--skrift-familie-hengsel-tekst); font-size: 16px; line-height: 22px; font-weight: var(--skrift-vekt-sterk); letter-spacing: 0; text-wrap: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .k-teller { margin-left: 8px; font-size: 14px; font-weight: var(--skrift-vekt-normal); color: var(--tekst-dempet); font-variant-numeric: tabular-nums; }
  .k-teller.hoyre { margin-left: auto; }
  .k-finnhold { flex: 1; min-height: 0; display: flex; flex-direction: column; margin-top: 8px; }
  .k-fhandling { display: flex; justify-content: flex-end; align-items: center; gap: 12px; padding-top: 12px; }
  @media (min-width: 768px) and (max-width: 1199.98px) {
    .b14, .b13 { grid-column: span 6; }
    .b13:last-child:nth-child(odd) { grid-column: span 12; }
  }
  @media (max-width: 767.98px) {
    .k-flis { padding: 16px; }
    .b14, .b13, .b12, .b11 { grid-column: 1 / -1; }
  }
</style>

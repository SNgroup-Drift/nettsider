---
/** En komponent vist i lys og mørk ved siden av hverandre, med «brukes til» og «brukes ikke til». Demoen i slot tegnes to ganger (én per utgave). */
interface Props { id: string; navn: string; kode: string; tekst: string; bruk: string; ikke: string; }
const { id, navn, kode, tekst, bruk, ikke } = Astro.props;
---
<section class="sek" id={id} data-komponent={id}>
  <header>
    <h2>{navn}</h2>
    <p>{tekst} <span class="svak">I koden: <code>{kode}</code></span></p>
  </header>
  <div class="prove-par">
    <div class="prove-lys"><span class="prove-navn">Lys</span><slot /></div>
    <div class="prove-mork"><span class="prove-navn">Mørk</span><slot /></div>
  </div>
  <div class="bruk">
    <div><b>Brukes til</b>{bruk}</div>
    <div><b>Brukes ikke til</b>{ikke}</div>
  </div>
</section>

---
/** Bunnen: Hengsel-merket (aksent), hvilken versjon av designsystemet siden er generert fra, og selskapslinja som på hengsel.no. */
import Logo from "./Logo.astro";
import { designsystem } from "../lib/tokens";
---
<footer class="wrap bunn">
  <div class="rad">
    <Logo form="hengsel" hoyde={24} />
    <span>Designsystem {designsystem.versjon} · pinnet commit <code>{designsystem.commit.slice(0, 8)}</code></span>
  </div>
  <div class="rad">
    <span>Hengsel · ES-HOLDING AS · org.nr. 927 363 585</span>
    <span>Alle skjermer og navn på siden er oppdiktede. <a href="https://hengsel.no">hengsel.no</a></span>
  </div>
</footer>

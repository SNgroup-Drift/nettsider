---
/** Fast meny: Hengsel-merket (v3, aksent) til forsiden, sidene i fasiten . Siden er bare lys, uten bryter. */
import Logo from "./Logo.astro";
import { MENY, type MenyNokkel } from "../content/nav";
interface Props { aktiv?: MenyNokkel | ""; }
const { aktiv = "" } = Astro.props;
---
<header class="meny">
  <div class="wrap rad">
    <a class="logo" href="/" aria-label="Hengsel designfasit, til forsiden"><Logo form="hengsel" produkt hoyde={28} /></a>
    <nav aria-label="Hovedmeny">
      {MENY.map(([k, t, h]) => <a href={h} aria-current={k === aktiv ? "page" : undefined}>{t}</a>)}
    </nav>
  </div>
</header>

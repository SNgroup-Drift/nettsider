---
/** Skjermbilde i lys utgave (siden er bare lys). 2× brukes på skarpe skjermer. De mørke utgavene av appene vises ikke som skjermbilder; de mørke tokenene står som fargeprøver på /farger. */
import type { Skjerm } from "../lib/skjermer";
interface Props { s: Skjerm; }
const { s } = Astro.props;
const src = { x1: `/skjermer/${s.fil}@1x.webp`, x2: `/skjermer/${s.fil}.webp` };
---
<figure class="enhet" data-skjerm={s.fil}>
  <img src={src.x1} srcset={`${src.x1} 1x, ${src.x2} 2x`} width={s.b} height={s.h} alt={s.alt} loading="lazy" />
  <figcaption>{s.tittel}{s.mork ? "" : " · alltid lys"}</figcaption>
</figure>

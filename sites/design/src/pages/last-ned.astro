---
/** Last ned: tokens (css, ts, json), skriftene og logopakken. Alt kommer fra designsystemet, pinnet til en commit (designsystem.pin.json). */
import Side from "../layouts/Side.astro";
import pin from "@sngroup/hengsel-tokens/pin.json";
import { designsystem } from "../lib/tokens";
const FILER = [
  ["tokens/hengsel.tokens.json", "hengsel.tokens.json", "Eneste kilde: farger i lys og mørk, status, skrift, størrelser, radius, avstand, skygge og kundetema."],
  ["tokens/tokens.css", "tokens.css", "Web: CSS-variabler for alle roller, for appene og CRM-et (lys og mørk). Nettsidene bruker den delte fila i stedet, med bare lys."],
  ["tokens/tokens.ts", "tokens.ts", "CRM og Expo-montørappen: roller, status og kundetema som TypeScript."],
  ["tokens/fonts.css", "fonts.css", "@font-face for Schibsted Grotesk (variabel woff2, selvhostet)."],
  ["tokens/fonts-fri-liste.css", "fonts-fri-liste.css", "@font-face for kundetemaets frie skriftliste. Last bare de kunden har valgt."],
] as const;
---
<Side title="Last ned – Hengsel designfasit" description="Last ned designsystemets tokens (css, ts, json), skriftene logopakken (alle logoene og merkene fra palettpakke v2) og ikonsettet." aktiv="last-ned">
  <div class="wrap">
    <div class="hode">
      <span class="merkelapp">Last ned · versjon {designsystem.versjon}</span>
      <h1>Tokens, skrifter og logoer</h1>
      <p class="lede">Alt på denne siden er generert fra <code>hengsel.tokens.json</code>, den eneste kilden. Filene under er de samme som i designsystemet, pinnet til commit <code>{designsystem.commit.slice(0, 8)}</code> i designsystemets kilderepo. Rediger aldri utfilene for hånd: endre JSON-en og generer på nytt.</p>
    </div>
    <section class="sek" id="tokens">
      <header><h2>Tokens</h2></header>
      <div class="tabell" tabindex="0" role="region" aria-label="Tokens">
        <table>
          <thead><tr><th>Fil</th><th>Til</th><th>SHA-256</th></tr></thead>
          <tbody>
            {FILER.map(([sti, navn, tekst]) => (
              <tr>
                <td><a href={`/ds/${sti}`} download>{navn}</a></td>
                <td>{tekst}</td>
                <td><code>{(pin.filer as Record<string, string>)[sti].slice(0, 16)}…</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    <section class="sek" id="logopakke">
      <header>
        <h2>Logopakken</h2>
        <p>Alle logoene og merkene fra palettpakke v2 (Hengsel, CRM, Ute, Admin og Levering, i lys og mørk, pluss blekk, hvit, glass og tonet for Hengsel) som SVG, med lisensfilen for skriften. Ferdige og konturerte: ikke tegn dem om. De monokrome produktlogoene er foreslått og ikke med.</p>
      </header>
      <div class="rad-flex"><a class="knapp primaer" href="/last-ned/hengsel-logopakke.zip" download>Last ned hengsel-logopakke.zip</a></div>
    </section>
    <section class="sek" id="ikonpakke">
      <header>
        <h2>Ikonene</h2>
        <p>49 strekikoner (SVG med currentColor) i 16, 20 og 24 px, med navn, gruppe og SF Symbol i <code>ikoner.json</code>, sprite og tabell. Status: foreslått, venter på bekreftelse. Se <a href="/komponenter#ikoner">Komponenter</a>.</p>
      </header>
      <div class="rad-flex"><a class="knapp primaer" href="/last-ned/hengsel-ikoner.zip" download>Last ned hengsel-ikoner.zip</a></div>
    </section>
    <section class="sek" id="skrifter">
      <header>
        <h2>Skriftene</h2>
        <p>Schibsted Grotesk (variabel, vekt 400 til 800) som woff2, latin-delsett med æ, ø og å. SIL Open Font License; lisensteksten ligger ved siden av filen.</p>
      </header>
      <ul class="regler">
        <li><a href="/ds/assets/fonts/schibsted-grotesk-latin-wght-normal.woff2">Schibsted Grotesk (400–800)</a> · <a href="/ds/assets/fonts/LICENSE-Schibsted-Grotesk.txt">lisens</a></li>
      </ul>
    </section>
    <section class="sek" id="bruk">
      <header><h2>Slik brukes de</h2></header>
      <div class="tabell" tabindex="0" role="region" aria-label="Slik brukes de">
        <table>
          <thead><tr><th>Flate</th><th>Henter</th></tr></thead>
          <tbody>
            <tr><td>CRM og kundeportal (web)</td><td><code>tokens.css</code> og <code>fonts.css</code>; <code>tokens.ts</code> for farger i kode. Mørk utgave styres av CRM-et selv. Kundeportalen er aldri mørk.</td></tr>
            <tr><td>E-post og PDF</td><td><code>tokens.ts</code> (ingen CSS-variabler i e-post). Alltid lys utgave. Merke: <code>sendt-med</code> (PNG 2×) i e-post og <code>hengsel</code> ensfarget i PDF.</td></tr>
            <tr><td>Montørappen (Expo)</td><td><code>tokens.ts</code> (<code>roller</code>, <code>status</code>). Skriftene lastes av appen selv.</td></tr>
            <tr><td>Hengsel Ute (iOS)</td><td>Egen Swift-fil i designsystemet (<code>HengselTokens.swift</code>). Flatene bruker tokens; knapper, lister og kontroller følger iOS.</td></tr>
            <tr><td>hengsel.no, vis og denne siden</td><td>den delte fila <code>@sngroup/hengsel-tokens/tokens.css</code>, generert fra den pinnede <code>hengsel.tokens.json</code>. Bare lys modus.</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Side>

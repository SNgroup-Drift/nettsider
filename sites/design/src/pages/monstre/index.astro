---
/** N-5: oversikten over mønstersidene (menypunktet «Mønstre»): én Tekst-flis per mønster, 1/3 ×3 i to rader (120). */
import Side from "../../layouts/Side.astro";
import Sidetopp from "../../components/kit/Sidetopp.astro";
import Innhold from "../../components/kit/Innhold.astro";
import Rad from "../../components/kit/Rad.astro";
import Flis from "../../components/kit/Flis.astro";
import { MONSTRE } from "../../content/monstre";
const rader = [MONSTRE.slice(0, 3), MONSTRE.slice(3, 6)];
---
<Side title="Mønstre – Hengsel designfasit" description="Mønstersidene fra sidekartet (29-001–29-006): tilstander, dialoger, tabell, alle flisklassene, piller og tall, bygd med flisene de beskriver og med regelen fra designsystemet under." aktiv="monstre">
  <Sidetopp tittel="Mønstre" undertekst="Fasit for utviklere: hver side viser mønsteret med de samme flisene som i CRM, og under står regelen ordrett fra designsystemet." />
  <Innhold>
    {rader.map((r) => (
      <Rad hoyde={120}>
        {r.map((m) => (
          <Flis bredde="1/3" klasse="k-lenkeflis">
            <a class="k-lenke" href={`/monstre/${m.sti}`}><span class="k-nr">{m.nr}</span><span class="k-navn">{m.tittel}</span></a>
            <p class="k-om" title={m.undertekst}>{m.undertekst}</p>
          </Flis>
        ))}
      </Rad>
    ))}
  </Innhold>
</Side>

<style>
  .k-lenke { display: flex; flex-direction: column; color: var(--tekst); text-decoration: none; }
  .k-lenke::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius-kort-stor); }
  .k-lenke:hover .k-navn { text-decoration: underline; text-underline-offset: 3px; }
  :global(.k-lenkeflis) { position: relative; }
  :global(.k-lenkeflis:hover) { border-color: var(--kant); }
  .k-nr { font-size: 12px; line-height: 16px; color: var(--tekst-dempet); font-variant-numeric: tabular-nums; }
  .k-navn { font-size: 16px; line-height: 22px; font-weight: var(--skrift-vekt-sterk); }
  .k-om { margin-top: 4px; color: var(--tekst-dempet); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>

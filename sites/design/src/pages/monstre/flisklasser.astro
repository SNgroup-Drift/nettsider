    <Listeflis id="kortliste-3" bredde="1/3" tittel="Kortliste 1/3 · 320" etikett="Kortliste 1/3 · 320, eksempel 3 av 3" rader={[
      { navn: "Per og Liv Dahl", tekst: "Møte 10.00", pille: "Møte", tone: "pagar" },
    ]} />

---
/**
 * N-5 · 29-004 Flisklasser (alle), etter docs/sidekart/29-004.md i hengsel-crm (S-68) og regel 2b–2d. Rad 1–11 som i sidekartet; under står
 * regelen ordrett fra designsystemet (flisklasser.md, LAYOUT-REGLER.md, Flis.prompt.md). Eksempeldata er oppdiktet.
 */
import Monsterside from "../../components/kit/Monsterside.astro";
import Rad from "../../components/kit/Rad.astro";
import Tallflis from "../../components/kit/Tallflis.astro";
import Statusflis from "../../components/kit/Statusflis.astro";
import Listeflis from "../../components/kit/Listeflis.astro";
import Diagramflis from "../../components/kit/Diagramflis.astro";
import Skjemaflis from "../../components/kit/Skjemaflis.astro";
import Tekstflis from "../../components/kit/Tekstflis.astro";
import Tabellflis, { tabellHoyde } from "../../components/kit/Tabellflis.astro";
import Stegflis from "../../components/kit/Stegflis.astro";
import Tavleflis from "../../components/kit/Tavleflis.astro";
import Planflis from "../../components/kit/Planflis.astro";
import Tegningflis from "../../components/kit/Tegningflis.astro";
import Regelflis from "../../components/kit/Regelflis.astro";
import { flisklasser, siter } from "../../lib/ds-tekst";

const ordre = [
  { celler: ["O-2026-0412", "Ingrid og Ola Haugen", "257 700 kr", { pille: "Avvik", tone: "advarsel" as const }] },
  { celler: ["O-2026-0398", "Familien Sæther", "142 800 kr", { pille: "Venter på leverandør", tone: "venter" as const }] },
];
const klasser = flisklasser();
const regler = [
  { gjelder: "Alle fliser", sitater: [
    siter("components/layout/Flis.prompt.md", /Flis \(kort\) etter layout-reglene\. Én ting per flis\. Ikke fliser i fliser\./),
    siter("flisklasser.md", /Skrift i alle fliser: [^\n]*?vises hel i tooltip\./),
    siter("flisklasser.md", /Tom, laster og feil har samme høyde som fylt flis\./),
  ] },
  { gjelder: "Rutenett", sitater: [
    siter("dokumentasjon/LAYOUT-REGLER.md", /- PC 1440: 12 kolonner[^\n]*/),
    siter("dokumentasjon/LAYOUT-REGLER.md", /- iPad 1024: 8 kolonner[^\n]*/),
    siter("dokumentasjon/LAYOUT-REGLER.md", /- Telefon 390: 4 kolonner[^\n]*/),
  ] },
  { gjelder: "Bredder", sitater: [siter("dokumentasjon/LAYOUT-REGLER.md", /- Bredder: 1\/3 \(4 kol\.\)[^\n]*/)] },
  { gjelder: "En rad går opp (2b)", sitater: [
    siter("dokumentasjon/LAYOUT-REGLER.md", /- En rad fyller alltid hele bredden\.[^\n]*/),
    siter("dokumentasjon/LAYOUT-REGLER.md", /- Aldri rad med tomt felt\.[^\n]*/),
  ] },
  { gjelder: "Radhøyder (2d)", sitater: [
    siter("dokumentasjon/LAYOUT-REGLER.md", /- Radhøyder bare fra skalaen[^\n]*/),
    siter("dokumentasjon/LAYOUT-REGLER.md", /- Hele raden har én høyde:[^\n]*/),
    siter("dokumentasjon/LAYOUT-REGLER.md", /- Telefon: én flis per rad, flisen beholder sin høyde fra skalaen\./),
  ] },
];
---
<Monsterside sti="flisklasser" description="29-004 Flisklasser (alle): alle flisklassene fra regel 2c med radhøydene fra 2d, slik de tegnes i CRM, med regelen fra designsystemet under.">

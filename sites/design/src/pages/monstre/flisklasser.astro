      { etikett: "Telefon", verdi: "912 34 567", type: "tel" },
      { etikett: "Butikk", verdi: "Hamar", type: "velg", valg: ["Hamar", "Gjøvik", "Lillehammer"] },
    ]} />
    <Tekstflis bredde="1/2" tittel="Tekst 1/2 · følger raden" tekst="Hjelpetekst til høyre for et skjema (regel 3, A5) får skjemaets høyde. Ellers er Tekst 1/1 og 120, 320 eller 480 etter lengden." />

    <Listeflis id="kortliste-2" bredde="1/3" tittel="Kortliste 1/3 · 320" etikett="Kortliste 1/3 · 320, eksempel 2 av 3" rader={[
      { navn: "Marte Kolstad", tekst: "Tilbud sendt 09.10", pille: "Ikke åpnet", tone: "advarsel" },
      { navn: "Hege Lunde", tekst: "Svar i dag", pille: "Svar i dag", tone: "advarsel" },

    <Tallflis etikett="Tall 1/4 · 120" tall="1 240 000 kr" under="av 1 300 000 kr" />
    <Tallflis etikett="Tall 1/4 · 120" tall="9" under="åpne tilbud" />
    <Tallflis etikett="Tall 1/4 · 120" tall="44 %" under="tilbud til ordre" />
    <Tallflis etikett="Tall 1/4 · 120" tall="1" under="forfalt" haster />
  </Rad>
  <Rad hoyde={120}>
    <Statusflis tittel="Status 1/3 · 120" pille="Fredag 21.10" tone="advarsel" tekst="Endringsfrist. Etter fristen kan ordren ikke endres." />
    <Statusflis tittel="Status 1/3 · 120" pille="Mottatt 14.10" tone="ferdig" tekst="OB 88412 fra Nordli Kjøkken AS." />

  <Rad hoyde={480}>
    <Tavleflis id="tavle" tittel="Tavle 1/1 · 480" velger="Kolonne" kolonner={[
      { navn: "Lead", kort: ["Ola Bakken · bad", "Silje Brenna · kjøkken"] },
      { navn: "Tilbud sendt", kort: ["Marte Kolstad · 189 400 kr", "Hege Lunde · 142 000 kr", "Byggmester Hagen · 6 kjøkken", "Anders Rud · kjøkken", "Per og Liv Dahl · kjøkken", "Anne Berg · garderobe"] },

---
/** Farger: alle tokens i lys og mørk med hex og kontrast, de sju statustonene og regelen for kundens aksent. Genereres fra hengsel.tokens.json (src/lib/tokens.ts). */
import Side from "../layouts/Side.astro";
import { kontrast, fargeKlasse, fmtKontrast, kontrastRader, kundeAksentSjekk, kundeEksempler, palett, roller, status, statusKontrast, toneKlasse, MODI, tokens, tilHex, type TonePar } from "../lib/tokens";
const kontrastTabell = kontrastRader();
const sk = statusKontrast();
// N-7d (designsystem 2.12): kant mot pillens bg, minst 3:1 i vanlig kontrast og minst 4,5:1 i økt kontrast (KONTROLL.md 2.12). Verdiene fra JSON, ingen egen liste.
type ToneJson = { lys: TonePar; mork?: TonePar; "lys-okt-kontrast"?: TonePar; "mork-okt-kontrast"?: TonePar };
const toneJson = (navn: string) => (tokens.status as unknown as Record<string, ToneJson>)[navn];
const kantKontrast = (t: TonePar) => kontrast(t.kant, t.bg);
const kk = status.map((s) => {
  const j = toneJson(s.navn);
  return { lys: kantKontrast(s.lys), lysOkt: kantKontrast(j["lys-okt-kontrast"] ?? s.lys), mork: kantKontrast(s.mork), morkOkt: kantKontrast(j["mork-okt-kontrast"] ?? s.mork) };
});
const eksempler = kundeEksempler.map((t) => ({ ...t, sjekk: kundeAksentSjekk(t.aksent, t.paaAksent) }));
const fmt = (n: number) => fmtKontrast(n);
// N-7 (designsystem 2.5): produktpalettene fra hengsel.tokens.json (produkt). Kortene bruker data-produkt, så flatene og aksenten kommer fra variablene i den delte token-fila; hex-verdiene står som tekst.
type ProduktRolle = Record<string, string>;
// N-7d (2.11/2.12): statustonene per palett. CRM og Admin har egne status-verdier i JSON (produkt.<navn>.status.lys, skrevet til [data-produkt]-blokka i tokens.css); Ute og Nettsider arver grunnpaletten.
// Pillene i kortet bruker var(--status-*) under data-produkt, så det som vises er det den delte fila gir for paletten. Kant/bg regnes fra samme verdier.
const produktStatus = (nokkel: string) => {
  const egne = (tokens.produkt as unknown as Record<string, { status?: { lys?: Record<string, TonePar> } }>)[nokkel]?.status?.lys;
  return status.map((s) => { const t = egne?.[s.navn] ?? s.lys; return { navn: s.navn, egen: Boolean(egne?.[s.navn]), kantBg: kontrast(t.kant, t.bg) }; });
};
const produkter = Object.entries(tokens.produkt as Record<string, { navn: string; gjelder: string[]; modus: string[]; lys: ProduktRolle }>)
  .filter(([n]) => !n.startsWith("$"))
  .map(([nokkel, p]) => ({ nokkel, navn: p.navn, gjelder: p.gjelder, bareLys: !p.modus.includes("mork"), lys: p.lys, paaAksent: kontrast(p.lys["paa-aksent"], p.lys.aksent), tekstPaaGrunn: kontrast(p.lys.tekst, p.lys.grunn), status: produktStatus(nokkel) }));
// N-7b (2.10): alle rollene i produktets lys-blokk (crm og admin har 33, nettsider og ute 14). Fire heter noe annet i :root (som i scripts/lag-hengsel-tokens.mjs).
const PRODUKT_NAVN: Record<string, string> = { prikk: "merke-stift", grunn: "flate-side", "grunn-hevet": "flate-kort", "grunn-senket": "flate-senket" };
const produktVar = (r: string) => PRODUKT_NAVN[r] ?? r;
const produktRoller = (lys: ProduktRolle): [string, string][] => Object.keys(lys).filter((r) => !r.startsWith("$")).map((r) => [r, produktVar(r)]);
const produktCss = [...new Set(produkter.flatMap((p) => produktRoller(p.lys).map(([, css]) => css)))].map((css) => `.produkt-sv.pr-${css}{background:var(--${css})}`).join("");
---
<Side title="Farger – Hengsel designfasit" description="Alle fargetokens i lys og mørk med hex og kontrast, de sju statustonene og regelen for kundens aksentfarge." aktiv="farger">
  <style slot="head" is:inline set:html={produktCss}></style>
  <div class="wrap">
    <div class="hode">
      <span class="merkelapp">Farger · {roller.length} roller, {status.length} statustoner</span>
      <h1>Kjølige flater, blekk-tekst, furu som aksent</h1>
      <p class="lede">Merkevarefargene er råfarger. Komponentene bruker rollene (<code>--flate-side</code>, <code>--tekst</code>, <code>--aksent</code> …), så en mørk utgave bare bytter verdiene. Nettsidene er bare lyse; de mørke verdiene står her som fargeprøver til appene og CRM-et. Alt på denne siden er generert fra <code>hengsel.tokens.json</code>.</p>
    </div>

    <section class="sek" id="regler">
      <header><h2>Reglene</h2></header>
      <ul class="regler">
        <li>Mørk bakgrunn er <code>{roller.find((r) => r.navn === "flate-side")?.mork}</code>. Aldri rent hvitt, aldri rosa eller magenta, ingen gradienter.</li>
        <li>Bruk rollene, ikke råfargene, i komponenter.</li>
        <li>Furu er en aksent: primærknapp, fremdrift, fokusring og ett element per visning. Aktiv fane og meny er blekk, ikke furu. Furu som tekst (lenker) bruker alltid <code>--aksent-tekst</code>, aldri <code>--aksent</code>.</li>
        <li>Valgt og «i dag» er furutonet: <code>--flate-valgt</code>, <code>--aksent-svak</code> og <code>--aksent-valgt</code>.</li>
        <li>Varsler er furu (<code>--varsel-flate</code>), feil er rød (<code>--feil-flate</code>). Kort har ikke fargekant til venstre.</li>
        <li>Nettsidene er bare lyse. Appene og CRM-et har også en mørk utgave som følger enheten. Kundeportalen og alt som skrives ut eller blir PDF er alltid lyst.</li>
        <li>Status vises alltid med prikk og ord, aldri bare med farge.</li>
        <li>Tekst har minst 4,5:1 mot flaten den står på, grafikk minst 3:1. Tabellene under er beregnet fra verdiene på siden.</li>
      </ul>
    </section>

    <section class="sek" id="palett">
      <header>
        <h2>Merkevarefargene</h2>
        <p>De åtte fargene i profilen, pluss lys aksent for mørk flate. Råfarger: ikke bruk dem direkte i komponenter.</p>
      </header>
      <div class="palett">
        {palett.map((p) => (
          <div><span class={`sv stor ${fargeKlasse(p.navn)}`} role="img" aria-label={`${p.navn} ${p.hex}`}></span><b>{p.navn}</b><code>{p.hex}</code></div>
        ))}
      </div>
    </section>

    <section class="sek" id="produktpaletter">
      <header>
        <h2>Produktpaletter</h2>
        <p>Prikken i H-symbolet er plattformkoden: grønn er Hengsel Ute, oransje er Hengsel (merket og nettsidene), blå er Hengsel CRM og lilla er Hengsel Admin. Hver palett settes med <code>data-produkt="ute | nettsider | crm | admin"</code> på roten eller en innpakning, og bytter aksent, flater og tekst. Grunnpaletten over er Ute. Nettsider, CRM og Admin er bare lyse. Statustonene er de samme sju i alle fire; CRM og Admin har egne verdier for dem i sin blokk (2.10), Ute og Nettsider arver grunnpaletten. «ny» er gråblå i alle fire (2.11), og kantene har minst 3:1 mot bg (2.12). Fra designsystem {tokens.versjon}.</p>
      </header>
      <div class="produktkort">
        {produkter.map((p) => (
          <article class="produktkort-en" data-produkt={p.nokkel} id={`produkt-${p.nokkel}`}>
            <h3>{p.navn}</h3>
            <p class="dempet">Gjelder: {p.gjelder.join(", ")}. {p.bareLys ? "Bare lys." : "Lys og mørk."}</p>
            <div class="produkt-eksempel">
              <span class="produkt-prikk" role="img" aria-label={`Prikken i merket, ${p.lys.prikk}`}></span>
              <span class="produkt-knapp">Primærknapp</span>
              <a class="produkt-lenke" href={`#produkt-${p.nokkel}`}>Lenke</a>
            </div>
            <dl class="produkt-verdier">
              {produktRoller(p.lys).map(([rolle, css]) => (
                <div><dt><code>--{css}</code></dt><dd><span class={`produkt-sv pr-${css}`} role="img" aria-label={`${rolle} ${p.lys[rolle]}`}></span><code>{p.lys[rolle]}</code></dd></div>
              ))}
            </dl>
            <p class="dempet">Tekst på aksent {fmt(p.paaAksent)} · tekst på grunn {fmt(p.tekstPaaGrunn)}</p>
            <div class="tonerad produkt-status" aria-label={`Statustoner i ${p.navn}`}>
              {p.status.map((s) => <span class={`pille s-${s.navn}`} title={`kant/bg ${fmt(s.kantBg)}`}><i></i>{s.navn}</span>)}
            </div>
            <p class="dempet">{p.status.some((s) => s.egen) ? "Egne statusverdier for paletten" : "Statustonene fra grunnpaletten"} · kant/bg minst {fmt(Math.min(...p.status.map((s) => s.kantBg)))}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sek" id="roller">
      <header>
        <h2>Roller i lys og mørk</h2>
        <p>Hver rolle har en lys og en mørk verdi. Rader med lik verdi i begge utgaver er like i begge.</p>
      </header>
      <div class="tabell" tabindex="0" role="region" aria-label="Roller i lys og mørk">
        <table>
          <thead><tr><th>Token</th><th>Lys</th><th>Mørk</th><th>Brukes til</th></tr></thead>
          <tbody>
            {roller.map((r) => (
              <tr>
                <td><code>--{r.navn}</code></td>
                <td class="tall"><span class="verdi"><span class={`sv ${fargeKlasse(r.navn, "lys")}`} role="img" aria-label={`${r.navn} lys`}></span><code>{r.lys}</code></span></td>
                <td class="tall"><span class="verdi"><span class={`sv ${fargeKlasse(r.navn, "mork")}`} role="img" aria-label={`${r.navn} mørk`}></span><code>{r.mork}</code></span></td>
                <td>{r.bruk}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sek" id="kontrast">
      <header>
        <h2>Kontrast</h2>
        <p>Beregnet etter WCAG 2.x ved bygging. Gjennomsiktige farger er blandet over flaten de ligger på. Verdiene er rundet ned, så «4,5:1» aldri er en avrundet 4,46. Tekst krever 4,5:1 og grafikk 3:1.</p>
      </header>
      <div class="tabell" tabindex="0" role="region" aria-label="Kontrast">
        <table>
          <thead><tr><th>Par</th><th>Krav</th><th>Lys</th><th>Mørk</th></tr></thead>
          <tbody>
            {kontrastTabell.map((k) => (
              <tr data-par={k.id}>
                <td>{k.hva}<div class="svak"><code>--{k.fg}</code> på <code>--{k.bg}</code></div></td>
                <td class="tall">{fmt(k.krav)}</td>
                {MODI.map((m) => <td class="tall"><span class={k[m] >= k.krav ? "ok" : "feil-tekst"}>{fmt(k[m])} {k[m] >= k.krav ? "✓ ok" : "✗ under kravet"}</span></td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="svak">Fargen <code>--aksent</code> ({roller.find((r) => r.navn === "aksent")?.lys}) gir bare 4,0:1 mot <code>--flate-side</code> i lys utgave: den brukes til flater og grafikk, aldri til tekst direkte på flaten. Lenker bruker <code>--aksent-tekst</code>.</p>
    </section>

    <section class="sek" id="status">
      <header>
        <h2>Statustoner</h2>
        <p>Sju toner. Hver farge betyr det samme overalt i CRM, kundeportalen og Hengsel Ute. <b>fg</b> er tekst og prikk, <b>bg</b> er flaten og <b>kant</b> er rammen. «ny» er gråblå fra designsystem 2.11 (ikke lenger samme blå som aksenten i CRM). Fra 2.12 har kanten minst 3:1 mot pillens bg i vanlig kontrast og minst 4,5:1 i økt kontrast (<code>prefers-contrast: more</code>); bare lysheten på kanten er endret. «sannsynlig» er foreslått i K-186 runde 2 i samme stil som de andre og er ikke tatt i bruk i noen app ennå.</p>
      </header>
      <div class="prove-par">
        {MODI.map((m) => (
          <div class={`prove-${m}`}>
            <span class="prove-navn">{m === "lys" ? "Lys" : "Mørk"}</span>
            <div class="flate-kort tonerad">
              {status.map((s) => <span class={`pille ${toneKlasse(s.navn, m)}`}><i></i>{s.navn}</span>)}
            </div>
          </div>
        ))}
      </div>
      <div class="tabell" tabindex="0" role="region" aria-label="Statustoner">
        <table>
          <thead><tr><th>Tone</th><th>Lys: fg, bg, kant</th><th>Kontrast fg/bg</th><th>Kant/bg (lys · økt)</th><th>Mørk: fg, bg, kant</th><th>Kontrast fg/bg</th><th>Kant/bg (mørk · økt)</th></tr></thead>
          <tbody>
            {status.map((s, i) => (
              <tr data-tone={s.navn}>
                <td><b>{s.navn}</b></td>
                <td><code>{s.lys.fg}</code> <code>{s.lys.bg}</code> <code>{s.lys.kant}</code></td>
                <td class="tall"><span class={sk[i].lys >= 4.5 ? "ok" : "feil-tekst"}>{fmt(sk[i].lys)}</span></td>
                <td class="tall"><span class={kk[i].lys >= 3 ? "ok" : "feil-tekst"}>{fmt(kk[i].lys)}</span> · <span class={kk[i].lysOkt >= 4.5 ? "ok" : "feil-tekst"}>{fmt(kk[i].lysOkt)}</span></td>
                <td><code>{s.mork.fg}</code> <code>{s.mork.bg}</code> <code>{s.mork.kant}</code></td>
                <td class="tall"><span class={sk[i].mork >= 4.5 ? "ok" : "feil-tekst"}>{fmt(sk[i].mork)}</span></td>
                <td class="tall"><span class={kk[i].mork >= 3 ? "ok" : "feil-tekst"}>{fmt(kk[i].mork)}</span> · <span class={kk[i].morkOkt >= 4.5 ? "ok" : "feil-tekst"}>{fmt(kk[i].morkOkt)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sek" id="kundens-aksent">
      <header>
        <h2>Kundens aksentfarge</h2>
        <p>Kunden kan velge én aksent, men bare på det sluttkunden ser: tilbud og kontrakt (PDF), e-post til kunde og kundeportal. Disse flatene er alltid lyse. CRM, montørapp, Hengsel Ute og admin har alltid Hengsel-farger.</p>
      </header>
      <ul class="regler">
        <li>Aksenten må ha <b>minst 4,5:1 mot kortflaten</b> (<code>{roller.find((r) => r.navn === "flate-kort")?.lys}</code>), eller teksten på aksenten (<code>paaAksent</code>) må ha minst 4,5:1 mot aksenten.</li>
        <li>Den må i tillegg ha <b>minst 3:1 mot mørk flate</b> (<code>{roller.find((r) => r.navn === "flate-side")?.mork}</code>), siden den kan stå som grafikk i mørke visninger.</li>
        <li><b>Aksenten brukes ikke til liten brødtekst i mørk modus.</b> Den er en grafikkfarge der (knapper, streker, fremdrift), ikke en tekstfarge.</li>
        <li>Bare én aksent. Statusfargene og blekk-teksten er Hengsels og kan ikke byttes. Aldri hvitt, rosa eller gradienter.</li>
      </ul>
      <div class="tabell" tabindex="0" role="region" aria-label="Kundens aksentfarge">
        <table>
          <thead><tr><th>Eksempelkunde</th><th>Aksent</th><th>Mot kortflaten</th><th>Tekst på aksent</th><th>Mot mørk flate</th><th>Godkjent</th></tr></thead>
          <tbody>
            {eksempler.map((e) => (
              <tr data-kunde={e.id}>
                <td>{e.navn}</td>
                <td><span class="verdi"><span class={`sv f-kunde-${e.id}`} role="img" aria-label={`Aksent ${e.aksent}`}></span><code>{e.aksent}</code></span></td>
                <td class="tall">{fmt(e.sjekk.motLys)}</td>
                <td class="tall">{fmt(e.sjekk.tekstPaaAksent)}</td>
                <td class="tall">{fmt(e.sjekk.motMork)}</td>
                <td><span class={e.sjekk.lysOk && e.sjekk.morkOk ? "ok" : "feil-tekst"}>{e.sjekk.lysOk && e.sjekk.morkOk ? "✓ ok" : "✗ avvist"}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Side>

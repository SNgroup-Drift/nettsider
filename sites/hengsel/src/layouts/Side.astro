---
/**
 * Ramme for hengsel.no 2.0: familiens BaseLayout, den faste menyen (Meny.astro) og bunnen (Bunn.astro).
 * Fasit: docs/design/hengsel-no-2.0 (Meny.dc.html, Bunn.dc.html). Lys og mørk følger systemet (prefers-color-scheme).
 * Skriftene er Newsreader og Inter fra @sngroup/design/fonts.css. Alle sider bruker denne rammen, også /personvern, /apptest og 404.
 */
import BaseLayout from "@sngroup/design/components/BaseLayout.astro";
import "@sngroup/design/fonts.css";
import "../styles/tokens.css";
import "../styles/hengsel.css";
import Meny from "../components/Meny.astro";
import Bunn from "../components/Bunn.astro";
import type { MenyNokkel } from "../content/nav";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  aktiv?: MenyNokkel | "";
  /** Delingsbilde (og:image) som full URL */
  delingsbilde?: string;
}
const { title, description, noindex, aktiv = "", delingsbilde = "https://hengsel.no/og.png" } = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  delingsbilde={delingsbilde}
  temafarge={["#FBF9F6", "#1B1713"]}
  ikon={{ href: "/logo/favicon.svg", type: "image/svg+xml" }}
  ikon32="/logo/favicon-32.png"
  appleIkon="/logo/apple-touch-icon-180.png"
>
  <div class="side">
    <Meny aktiv={aktiv} />
    <slot />
    <Bunn />
  </div>
</BaseLayout>

<style>
  .side { min-height: 100vh; display: flex; flex-direction: column; background: var(--bg); color: var(--ink); }
  .side > :global(main) { flex: 1; }
</style>

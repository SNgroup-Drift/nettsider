---
/**
 * Ramme for hengsel.no 2.0: Hode.astro, den faste menyen (Meny.astro) og bunnen (Bunn.astro).
 * Fasit: docs/design/hengsel (Meny.dc.html, Bunn.dc.html); favicon og manifest fra merkepakkens favicon/head.html (brand/). Bare lys modus.
 * Ramme, tokens og skrifter kommer fra @sngroup/hengsel-tokens (Hode.astro). Alle sider bruker denne rammen, også /personvern, /apptest og 404.
 */
import Hode from "@sngroup/hengsel-tokens/Hode.astro";
import "../styles/hengsel.css";
import Meny from "../components/Meny.astro";
import Bunn from "../components/Bunn.astro";
import type { MenyNokkel } from "../content/nav";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Overstyrer robots-taggen, f.eks. «noindex,nofollow» for /apptest */
  robots?: string;
  aktiv?: MenyNokkel | "";
  /** Uten hovedmenyen: /apptest viser bare sitt eget sidehode (slot «hode») */
  utenMeny?: boolean;
  /** Delingsbilde (og:image) som full URL */
  delingsbilde?: string;
}
const { title, description, noindex, robots, aktiv = "", utenMeny = false, delingsbilde = "https://hengsel.no/og.png" } = Astro.props;
---
<Hode
  title={title}
  description={description}
  noindex={noindex}
  robots={robots}
  delingsbilde={delingsbilde}
  ikon={{ href: "/favicon.svg", type: "image/svg+xml" }}
  ikon32="/favicon-32.png"
  appleIkon="/favicon-180.png"
  manifest="/manifest.webmanifest"
>
  <div class="side">
    {utenMeny ? <slot name="hode" /> : <Meny aktiv={aktiv} />}
    <slot />
    <Bunn />
  </div>
</Hode>

<style>
  .side { min-height: 100vh; display: flex; flex-direction: column; background: var(--bg); color: var(--ink); }
  .side > :global(main) { flex: 1; }
</style>

---
/**
 * Ramme for hengsel.no 2.0: Hode.astro, den faste menyen (Meny.astro) og bunnen (Bunn.astro).
 * Fasit: docs/design/hengsel (Meny.dc.html, Bunn.dc.html); favicon og manifest fra merkepakkens favicon/head.html (brand/). Bare lys modus.
 * Ramme, tokens og skrifter kommer fra @sngroup/hengsel-tokens (Hode.astro). Alle sider bruker denne rammen, også /personvern, /apptest og 404.
 */
import Hode from "@sngroup/hengsel-tokens/Hode.astro";
import "../styles/hengsel.css";
import Meny from "../components/Meny.astro";
import Bunn from "../components/Bunn.astro";
import type { MenyNokkel } from "../content/nav";
import { kundeFra, kundeSti, tilKunde } from "../kunde";
import temaTokens from "@sngroup/kundetema-sigdal/tokens.css?raw";
import { FONTER } from "@sngroup/kundetema-sigdal/fonter.mjs";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Overstyrer robots-taggen, f.eks. «noindex,nofollow» for /apptest */
  robots?: string;
  aktiv?: MenyNokkel | "";
  /** Uten hovedmenyen: /apptest viser bare sitt eget sidehode (slot «hode») */
  utenMeny?: boolean;
  /** Uten den vanlige bunnen: /hjelp har sin egen bunn med opphavsrettslinjen (K-226) */
  utenBunn?: boolean;
  /** Delingsbilde (og:image) som full URL */
  delingsbilde?: string;
}
const { title: hengselTittel, description: hengselBeskrivelse, noindex, robots, aktiv = "", utenMeny = false, utenBunn = false, delingsbilde = "https://hengsel.no/og.png" } = Astro.props;

// K-223: under /kunde/sigdal er dette Sigdal-utgaven av siden (tema, meny, bunn, tekst og bilder). Hengsel-sidene er uendret.
const kunde = kundeFra(Astro.url.pathname);
const title = kunde ? (kunde.titler[kundeSti(kunde, Astro.url.pathname)] ?? hengselTittel) : hengselTittel;
const description = kunde ? tilKunde(hengselBeskrivelse, kunde) : hengselBeskrivelse;
const innhold = kunde ? tilKunde(await Astro.slots.render("default"), kunde) : "";
const hodeInnhold = kunde && utenMeny ? tilKunde(await Astro.slots.render("hode"), kunde) : "";
// Off White fra Sigdal-temaet (adressefeltet); verdien står bare i temaet
const temaFarge = /--sigdal-off-white:\s*(#[0-9A-Fa-f]{6})/.exec(temaTokens)?.[1] ?? "";
---
<Hode
  title={title}
  description={description}
  noindex={noindex || !!kunde}
  robots={kunde ? "noindex, nofollow" : robots}
  delingsbilde={kunde ? undefined : delingsbilde}
  ikon={{ href: "/favicon-32.png", type: "image/png" }}
  appleIkon="/favicon-180.png"
  manifest={kunde ? undefined : "/manifest.webmanifest"}
  forhandslast={kunde ? [FONTER.newsreader, FONTER.inter] : undefined}
  kunde={kunde ? { attributt: "data-kunde", verdi: kunde.nokkel, temaCss: `${kunde.sti}/tema.css`, temaFarge } : undefined}
>
  <div class="side">
    {kunde
      ? (utenMeny ? <Fragment set:html={hodeInnhold} /> : <Meny aktiv={aktiv} kunde={kunde} />)
      : (utenMeny ? <slot name="hode" /> : <Meny aktiv={aktiv} />)}
    {kunde ? <Fragment set:html={innhold} /> : <slot />}
    {!utenBunn && <Bunn kunde={kunde} />}
  </div>
</Hode>

<style>
  .side { min-height: 100vh; display: flex; flex-direction: column; background: var(--flate-side); color: var(--ink); }
  .side > :global(main) { flex: 1; }
</style>

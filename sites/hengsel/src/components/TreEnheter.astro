---
/**
 * N-6 / N-10: «Samme ordre på alle enheter». Studio Display og MacBook øverst, iPad og iPhone foran nede, med samme flyt på alle fire
 * (Min dag → Ordre → Kontrollmål). De fire bytter i takt (scripts/simulering.ts, data-sim-gruppe) og deler ett sett stegmerker under komposisjonen.
 * Bildene kommer fra biblioteket. På telefon (under 640 px) stables de: Studio Display, MacBook, iPad, iPhone.
 */
import Simulering from "./Simulering.astro";
import Stegmerker from "./Stegmerker.astro";
import { TRE_ENHETER, TRE_STEG } from "../content/simuleringer";
interface Props { forst?: boolean; class?: string }
const { forst = false, class: klasse } = Astro.props;
---
<div class:list={["tre", klasse]} data-sim-gruppe>
  <div class="scene">
    <div class="pc"><Simulering type="display" steg={TRE_ENHETER.display} forst={forst} merker={false} etikett="Studio Display" /></div>
    <div class="mac"><Simulering type="macbook" steg={TRE_ENHETER.macbook} merker={false} etikett="MacBook" /></div>
    <div class="ipad"><Simulering type="ipad" steg={TRE_ENHETER.ipad} merker={false} etikett="iPad" /></div>
    <div class="iphone"><Simulering type="iphone" steg={TRE_ENHETER.iphone} merker={false} etikett="iPhone" /></div>
  </div>
  <Stegmerker navn={TRE_STEG} etikett="Steg: samme flyt på Studio Display, MacBook, iPad og iPhone" />
</div>

<style>
  .tre { width: 100%; max-width: 960px; margin-inline: auto; }
  /* Studio Display til venstre og MacBook til høyre bak; iPad og iPhone foran nede. Høyden settes av .scene (62 % av bredden). */
  .scene { position: relative; width: 100%; padding-bottom: 62%; }
  .scene > div { position: absolute; }
  .pc { left: 0; top: 0; width: 52%; }
  .mac { right: 0; top: 6%; width: 50%; }
  .ipad { left: 12%; bottom: 0; width: 32%; }
  .iphone { right: 12%; bottom: 0; width: 14%; }
  @media (max-width: 639px) {
    .scene { padding-bottom: 0; display: flex; flex-direction: column; align-items: center; gap: 24px; }
    .scene > div { position: static; width: 100%; }
    .scene > .ipad { max-width: 420px; }
    .scene > .iphone { width: 200px; }
  }
</style>

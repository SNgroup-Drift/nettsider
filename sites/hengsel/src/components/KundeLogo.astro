---
/**
 * Kundens logo i menyen og bunnen (K-223). Kundens logo er transparent PNG fra merkevareprofilen:
 * public/<kunde>/logo/<kunde>-logo-warm-black.png på lyse flater og <kunde>-logo-off-white.png på mørke (flate="mork").
 * Uten logofil står kundens navn som tekstmerke i kundens overskriftsskrift.
 * «levert av Hengsel» står under som tekst; Hengsel Levering-logoen er ikke brukt fordi den har Hengsel-farger. Stilen (.kundelogo-*) ligger i kundetemaet (tokens.css).
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { Kunde } from "../kunde";
interface Props { kunde: Kunde; levertAv?: "under" | "ingen"; flate?: "lys" | "mork" }
const { kunde, levertAv = "under", flate = "lys" } = Astro.props;
const logoFil = `${kunde.sti}/logo/${kunde.nokkel}-logo-${flate === "mork" ? "off-white" : "warm-black"}.png`;
const harLogo = existsSync(join(process.cwd(), "public", logoFil));
---
<span class="kundelogo">
  {harLogo
    ? <img class="kundelogo-bilde" src={logoFil} alt={kunde.navn} width="70" height="30" />
    : <span class="kundelogo-navn">{kunde.navn}</span>}
  {levertAv === "under" && <span class="kundelogo-levert">levert av Hengsel</span>}
</span>

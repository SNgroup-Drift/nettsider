---
/**
 * Kundens merke i menyen og bunnen (K-223, K-231): «<Kunde> CRM · levert av Hengsel» som ett merke i én farge (merkepakke v2, hengsel_merke_v2/6-sigdal),
 * public/<kunde>/logo/<kunde>-crm-levert-av-hengsel-{warm-black|off-white}.png (1x, -2x og -3x). PNG, ikke SVG: SVG-ene i pakken mangler selve Sigdal-logoen (tomt <image>). Warm Black på lys flate, Off White på mørk flate (flate="mork").
 * Kundens logo og «levert av Hengsel» er ett bilde: ingen tekst under. Mangler filen, står kundens navn som tekstmerke i kundens overskriftsskrift,
 * med «levert av Hengsel» som tekst under. Stilen (.kundelogo-*) ligger i kundetemaet (tokens.css).
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { Kunde } from "../kunde";
interface Props { kunde: Kunde; flate?: "lys" | "mork" }
const { kunde, flate = "lys" } = Astro.props;
const grunn = `${kunde.sti}/logo/${kunde.nokkel}-crm-levert-av-hengsel-${flate === "mork" ? "off-white" : "warm-black"}`;
const harMerke = existsSync(join(process.cwd(), "public", `${grunn}.png`));
---
<span class="kundelogo">
  {harMerke
    ? <img class="kundelogo-merke" src={`${grunn}-2x.png`} srcset={`${grunn}.png 1x, ${grunn}-2x.png 2x, ${grunn}-3x.png 3x`} alt={`${kunde.produkt} · levert av Hengsel`} width="416" height="48" />
    : <Fragment><span class="kundelogo-navn">{kunde.navn}</span><span class="kundelogo-levert">levert av Hengsel</span></Fragment>}
</span>

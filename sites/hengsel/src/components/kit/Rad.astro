---
/**
 * Nettside-kitet: én rad med fliser. Regel 2b og 2d i regel-layout-hengsel.md: 12 kolonner med 24 px mellomrom, raden fyller alltid hele bredden,
 * og hele raden har én høyde fra skalaen 120/320/480/640. Fliser i raden får samme høyde (grid-auto-rows). Raden kan vokse hvis innholdet ikke får
 * plass (stor tekst i nettleseren), men innholdet i kitet er laget for å passe i høyden. «auto» bare der rapporten sier hvorfor (N-3).
 * Telefon (under 960 px): alle fliser 1/1 i samme rekkefølge og med samme høyde, 16 px mellomrom.
 */
export type Hoyde = 120 | 320 | 480 | 640 | "auto";
interface Props { hoyde: Hoyde }
const { hoyde } = Astro.props;
---
<div class="rad" data-hoyde={hoyde}><slot /></div>

<style>
  .rad { --h: auto; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: minmax(var(--h), auto); gap: 24px; }
  .rad[data-hoyde="120"] { --h: 120px; }
  .rad[data-hoyde="320"] { --h: 320px; }
  .rad[data-hoyde="480"] { --h: 480px; }
  .rad[data-hoyde="640"] { --h: 640px; }
  /* 120-raden (Status, Tekst på én–to linjer): litt mindre luft over og under, så tittel, pille og setning går opp i 120 */
  .rad[data-hoyde="120"] > :global(.flis) { padding-block: 20px; }
  @media (max-width: 959px) { .rad { grid-template-columns: minmax(0, 1fr); gap: 16px; } }
</style>

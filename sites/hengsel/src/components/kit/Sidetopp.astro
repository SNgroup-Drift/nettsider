---
/**
 * Nettside-kitet (N-3, sidekartet 25-001–25-012 «Rammen»): toppen på siden. Tittel 48 px (32 px på telefon) med ingress, og sidens egne
 * handlinger (regel 3: handlingene for hele siden står i toppen, aldri i fliser). Sporet «pille» står rett etter tittelen (status for siden).
 * Flaten er kortflaten med strek under, som i tegningene; radene (Innhold.astro) ligger på sideflaten under.
 * Sporet «komposisjon» (N-3c, regel 10 i docs/design/hengsel-regler.md): appen i enhetsrammer (Enhet.astro). På PC står den til høyre for tittel,
 * ingress og knapper (5 av 12 kolonner), på telefon under knappene. Sider uten sporet er uendret.
 * N-9: `produkt` viser produktlogoen (34 px) over tittelen; sider uten `produkt` er uendret.
 */
import Produktlogo from "../Produktlogo.astro";
import { PRODUKTER, type ProduktNokkel } from "../../content/produkter";
interface Props {
  tittel: string;
  ingress?: string;
  /** id på toppen, for ankere (25-007 er #demo på /priser-og-demo) */
  id?: string;
  /** h1 på sidens første topp, h2 når en side har to topper (25-006 + 25-007) */
  niva?: 1 | 2;
  /** N-9: produktsidene (crm, ute, admin, levering, kundeportal, telefon): produktlogoen over tittelen */
  produkt?: ProduktNokkel;
}
const { tittel, ingress, id, niva = 1, produkt } = Astro.props;
// Logoen er pynt (alt="") når tittelen alt sier produktnavnet; ellers er alt produktnavnet
const pyntet = produkt ? tittel.toLowerCase().includes(PRODUKTER[produkt].navn.toLowerCase()) : false;
const H = niva === 1 ? "h1" : "h2";
const komp = Astro.slots.has("komposisjon");
---
<div class:list={["sidetopp", { andre: niva === 2 }]} id={id}>
  <div class="k-ramme inn">
   <div class:list={["oppsett", { "med-komp": komp }]}>
    <div class="tekst">
      {produkt && <div class="produktrad"><Produktlogo produkt={produkt} hoyde={34} pyntet={pyntet} /></div>}
      <div class="tittelrad">
        <H class="tittel">{tittel}</H>
        <slot name="pille" />
      </div>
      {ingress && <p class="ingress">{ingress}</p>}
      {Astro.slots.has("default") && <div class="handlinger"><slot /></div>}
    </div>
    {komp && <div class="komp"><slot name="komposisjon" /></div>}
   </div>
  </div>
</div>

<style>
  .sidetopp { background: var(--flate-kort); border-bottom: 1px solid var(--linje); scroll-margin-top: var(--topp); }
  .sidetopp.andre { border-top: 1px solid var(--linje); }
  .inn { padding-block: 24px 48px; }
  .tekst { display: flex; flex-direction: column; gap: 12px; }
  /* Med komposisjon: tekst 7 og rammene 5 av 12 kolonner (24 px mellomrom), innenfor de 1280 px innholdet har */
  .med-komp { max-width: 1280px; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: center; }
  .med-komp .tekst { grid-column: span 7; }
  .komp { grid-column: span 5; min-width: 0; }
  .produktrad { display: flex; align-items: center; min-height: 34px; }
  .tittelrad { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; max-width: 1280px; }
  .tittel { font-size: 48px; line-height: 56px; letter-spacing: -0.02em; text-wrap: balance; }
  .ingress { max-width: 720px; font-size: 18px; line-height: 27px; color: var(--tekst-dempet); }
  .handlinger { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 12px; }
  @media (max-width: 959px) {
    .inn { padding-block: 16px 24px; }
    .tekst { gap: 8px; }
    .med-komp { display: flex; flex-direction: column; align-items: stretch; gap: 24px; }
    .tittel { font-size: 32px; line-height: 36px; }
    .ingress { font-size: 15px; line-height: 22px; }
  }
</style>

---
/**
 * Nettside-kitet: Status-flisen (regel 2c): tittel, verdi som pille og én setning på én linje, fast høyde 120. For lang setning kuttes med …
 * og står hel i tooltip. Finnes som 1/3, 1/2 og 1/1, så Status-raden alltid fyller raden (tre = 1/3 ×3, to = 1/2 + 1/2, én = 1/1).
 */
import Flis, { type Bredde } from "./Flis.astro";
import Pille, { type Tone } from "./Pille.astro";
interface Props { tittel: string; pille: string; tone?: Tone; tekst: string; bredde?: Bredde }
const { tittel, pille, tone, tekst, bredde = "1/3" } = Astro.props;
---
<Flis bredde={bredde} tittel={tittel} klasse="statusflis">
  <Pille tone={tone}>{pille}</Pille>
  <p class="setning" title={tekst}>{tekst}</p>
</Flis>

<style>
  .setning { margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--tekst); }
</style>

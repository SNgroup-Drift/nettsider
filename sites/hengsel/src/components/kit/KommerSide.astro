---
/**
 * Nettside-kitet: sidene merket KOMMER i sidekartet (25-008, 25-009, 25-010). Toppen og én rad (120) med Tekst-fliser: tre som 1/3 ×3, to som 1/2 + 1/2.
 * Fliser uten tekst viser «Kommer.». noindex og ikke i menyen til teksten er på plass (N-3b).
 * N-6: sporet kan ha simuleringer eller stillrammer (Simuleringsflis) under flisene.
 */
import Side from "../../layouts/Side.astro";
import Sidetopp from "./Sidetopp.astro";
import Innhold from "./Innhold.astro";
import Rad from "./Rad.astro";
import Tekstflis from "./Tekstflis.astro";
import type { MenyNokkel } from "../../content/nav";
import type { KommerSide } from "../../content/kommer";
interface Props { side: KommerSide; aktiv: MenyNokkel }
const { side, aktiv } = Astro.props;
const bredde = side.fliser.length === 3 ? "1/3" : side.fliser.length === 2 ? "1/2" : "1/1";
---
<Side title={`${side.tittel} – Hengsel`} description={side.beskrivelse} aktiv={aktiv} noindex>
  <main id="innhold">
    <Sidetopp tittel={side.tittel} ingress={side.ingress} />
    <Innhold>
      <Rad hoyde={120}>
        {side.fliser.map((f) => <Tekstflis bredde={bredde} tittel={f.tittel} tekst={f.tekst} kommer={!f.tekst} />)}
      </Rad>
      <slot />
    </Innhold>
  </main>
</Side>

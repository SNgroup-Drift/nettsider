---
/**
 * Nettside-kitet: flisen (kortet) alle flisklassene bygger på. Samme flate, kant, radius og skrift som CRM-flisene (regel 2 og 2c):
 * tittel 16/600 (med teller til høyre for tittelen), innhold, handling nederst til høyre. Bredde 1/3, 1/2 eller 1/1 (span 4, 6 eller 12 av 12).
 * Innvendig luft 24 px på PC og 16 px på telefon. Sporet «verktoy» står til høyre i tittelfeltet (søk i Tabell kompakt).
 */
export type Bredde = "1/3" | "1/2" | "1/1";
interface Props {
  bredde?: Bredde;
  tittel?: string;
  /** Telleren etter tittelen (antall rader), regel 9 */
  teller?: number;
  /** Telleren helt til høyre i tittelfeltet i stedet for rett etter tittelen (Kortliste/Liste) */
  tellerHoyre?: boolean;
  klasse?: string;
  id?: string;
}
const { bredde = "1/1", tittel, teller, tellerHoyre = false, klasse, id } = Astro.props;
const b = { "1/3": "b13", "1/2": "b12", "1/1": "b11" }[bredde];
const tittelId = id ? `${id}-tittel` : undefined;
const verktoy = Astro.slots.has("verktoy");
---
<section class:list={["flis", b, klasse]} id={id} aria-labelledby={tittelId}>
  {tittel && (
    <div class:list={["topp", { "med-verktoy": verktoy }]}>
      <h2 class="ftittel" id={tittelId}>{tittel}{teller !== undefined && !tellerHoyre && <span class="teller">{teller}</span>}</h2>
      {teller !== undefined && tellerHoyre && <span class="teller hoyre" aria-label={`${teller} rader`}>{teller}</span>}
      {verktoy && <slot name="verktoy" />}
    </div>
  )}
  <div class="finnhold"><slot /></div>
  {Astro.slots.has("handling") && <div class="fhandling"><slot name="handling" /></div>}
</section>

<style>
  .flis { min-width: 0; box-sizing: border-box; display: flex; flex-direction: column; padding: 24px; background: var(--flate-kort); border: 1px solid var(--linje); border-radius: var(--radius-kort-stor); color: var(--tekst); font-size: 14px; line-height: 20px; }
  .b13 { grid-column: span 4; }
  .b12 { grid-column: span 6; }
  .b11 { grid-column: span 12; }
  .topp { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 22px; position: relative; }
  .topp.med-verktoy { min-height: 40px; margin-top: -4px; }
  .ftittel { margin: 0; min-width: 0; font-family: var(--skrift-familie-hengsel-tekst); font-size: 16px; line-height: 22px; font-weight: var(--skrift-vekt-sterk); letter-spacing: 0; text-wrap: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .teller { margin-left: 8px; font-size: 14px; font-weight: var(--skrift-vekt-normal); color: var(--tekst-dempet); font-variant-numeric: tabular-nums; }
  .teller.hoyre { margin-left: auto; }
  .finnhold { flex: 1; min-height: 0; display: flex; flex-direction: column; margin-top: 8px; }
  .fhandling { display: flex; justify-content: flex-end; align-items: center; gap: 12px; padding-top: 12px; }
  @media (max-width: 959px) {
    .flis { padding: 16px; }
    .b13, .b12, .b11 { grid-column: 1 / -1; }
  }
</style>

---
/**
 * Nettside-kitet: flaten med radene under toppen. Første rad 24 px under toppen, siste 48 px over bunnen (regel 2d), 24 px mellom radene
 * (16 px på telefon). Innholdet er maks 1280 px bredt og venstrestilt i rammen (1440 px med 32 px marg, 16 px på telefon).
 */
interface Props { klasse?: string; /** N-7: produktpalett for flaten under toppen (ute, crm …); uten = arver siden (nettsider) */ produkt?: "ute" | "crm" | "admin" | "nettsider" }
import { kundeFra } from "../../kunde";
const { klasse, produkt } = Astro.props;
// Kundeutgaver (K-223) har kundens tema, ikke Hengsels produktpaletter
const data_produkt = kundeFra(Astro.url.pathname) ? undefined : produkt;
---
<div class:list={["innhold", klasse]} data-produkt={data_produkt}>
  <div class="k-ramme">
    <div class="rader"><slot /></div>
  </div>
</div>

<style>
  .innhold { padding-block: 24px 48px; }
  .rader { max-width: 1280px; display: flex; flex-direction: column; gap: 24px; }
  @media (max-width: 959px) { .innhold { padding-block: 16px 48px; } .rader { gap: 16px; } }
</style>

<script>
  import "../../scripts/kit";
</script>

---
/**
 * Hengsel Ute-motion (brand/hengsel-merke/motion/): 3 s sømløs loop, 1080 × 1080, uten lyd.
 * autoplay, muted, loop og playsinline. Kildene lastes først når videoen er nær synsfeltet (scripts/motion.ts), og ved
 * prefers-reduced-motion eller uten skript vises bare plakaten.
 */
interface Props { class?: string }
const { class: klasse } = Astro.props;
---
<video class:list={["motion", klasse]} data-motion autoplay muted loop playsinline preload="none" width="1080" height="1080" poster="/media/ute-motion-1080x1080-plakat.webp" aria-label="Hengsel Ute-ikonet: hengselet åpner seg">
  <source data-src="/media/ute-motion-1080x1080.webm" type="video/webm" />
  <source data-src="/media/ute-motion-1080x1080.mp4" type="video/mp4" />
</video>
<style>
  .motion { display: block; width: 100%; height: auto; aspect-ratio: 1; border-radius: 22%; object-fit: cover; background: var(--surface-highlight); }
</style>

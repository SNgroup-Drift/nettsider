---
/**
 * Skjermbilde i Apple-ramme (pakke v3 11.10.2026, INSTRUKS.md; se docs/bilder.md).
 *  - pc: Studio Display. mac: MacBook. phone: iPhone 18. ipad: iPad liggende.
 * Rammen er Apples Product Bezel som den er (ramme-*.webp, gjennomsiktig skjermhull). Skjermbildet ligger under den og
 * klippes med skjermens hjørner. Hullene (prosent av rammens bredde og høyde) er målt i rammefilene.
 * Rammen skaleres med container-enheter: bredden er min(største bredde, plassen, plassen × ratio × B/H), der ratio er
 * største høyde i forhold til bredden på plassen. Klikk på bildet åpner lysboksen (scripts/lysboks.ts) med bildet i full
 * størrelse (data-full), med mindre zoom er av. Bildet fyller hullet (object-fit: cover fra toppen, som i INSTRUKS); med
 * fit="contain" vises hele bildet med skjermens bakgrunn rundt (for bilder som ikke har hullets format).
 */
import { MAAL, RAMMER, src } from "../scripts/bilder";

interface Props {
  bilde: string;
  alt: string;
  type: "pc" | "mac" | "phone" | "ipad";
  ratio?: 0.75 | 0.8 | 1 | 1.1 | 1.4 | 1.8 | 2.1;
  /** Første skjermbilde på siden lastes med en gang, resten når de nærmer seg */
  forst?: boolean;
  /** Uten lysboks (sider som ikke har den): bildet er ikke en knapp */
  zoom?: boolean;
  /** cover: bildet fyller skjermhullet og klippes fra bunnen. contain: hele bildet vises. */
  fit?: "cover" | "contain";
}
const { bilde, alt, type, ratio = 0.75, forst = false, zoom = true, fit = "cover" } = Astro.props;
const [w, h] = MAAL[bilde] ?? [0, 0];
const [ramme, rw, rh] = RAMMER[type];
const r = { 0.75: "r75", 0.8: "r80", 1: "r100", 1.1: "r110", 1.4: "r140", 1.8: "r180", 2.1: "r210" }[ratio];
const lasting = forst ? "eager" : "lazy";
---
<div class:list={["enhet", r]}>
  <div class:list={["ramme", type]}>
    <div class:list={["hull", { inni: fit === "contain" }]}>
      {zoom
        ? (
          <button type="button" class="zoom" data-zoom aria-label={`Forstørr skjermbildet: ${alt}`}>
            <img src={src(bilde)} data-full={src(bilde)} alt={alt} width={w} height={h} loading={lasting} fetchpriority={forst ? "high" : undefined} decoding="async" />
          </button>
        )
        : <img src={src(bilde)} alt={alt} width={w} height={h} loading={lasting} fetchpriority={forst ? "high" : undefined} decoding="async" />}
    </div>
    <img class="bezel" src={src(ramme)} alt="" width={rw} height={rh} loading={lasting} decoding="async" aria-hidden="true" />
  </div>
</div>

<style>
  .enhet { container-type: inline-size; width: 100%; min-width: 0; display: flex; justify-content: center; }
  .r75 { --ratio: 0.75; } .r80 { --ratio: 0.8; } .r100 { --ratio: 1; } .r110 { --ratio: 1.1; } .r140 { --ratio: 1.4; } .r180 { --ratio: 1.8; } .r210 { --ratio: 2.1; }
  .ramme {
    --w: 2160; --h: 1664; --maks: 856px; position: relative; flex: none; min-width: 0; aspect-ratio: var(--w) / var(--h);
    width: min(var(--maks), 100cqw, calc(100cqw * var(--ratio) * var(--w) / var(--h)));
  }
  .ramme.mac { --w: 2400; --h: 1565; --maks: 856px; }
  .ramme.ipad { --w: 2400; --h: 1740; --maks: 1100px; }
  .ramme.phone { --w: 1174; --h: 2400; --maks: 414px; }

  /* Skjermhullet: left, top, width, height i prosent av rammen; hjørnene som i rammen */
  .hull { position: absolute; overflow: hidden; background: #F2E9DB; }
  .pc .hull { left: 2.59%; top: 3.37%; width: 94.81%; height: 69.23%; border-radius: 1.2% / 1.6%; }
  .mac .hull { left: 12.63%; top: 14.19%; width: 74.75%; height: 71.63%; border-radius: 1% / 1.4%; }
  .ipad .hull { left: 5%; top: 6.84%; width: 90%; height: 86.32%; border-radius: 1.2% / 1.6%; }
  .phone .hull { left: 5.37%; top: 2.5%; width: 89.27%; height: 95%; border-radius: 14% / 6.1%; }

  /* Knappen fyller hullet (en <button> sentrerer ellers innholdet loddrett) */
  .zoom { all: unset; display: block; width: 100%; height: 100%; cursor: zoom-in; box-sizing: border-box; }
  .zoom:focus-visible { box-shadow: inset 0 0 0 3px var(--accent); }
  .hull img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .hull.inni img { object-fit: contain; object-position: center; }

  /* Rammen over bildet; klikk går gjennom til bildet */
  .bezel { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
</style>

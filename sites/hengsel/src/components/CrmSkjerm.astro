---
/**
 * CRM-skjermene i demoen (CrmSkjerm.dc.html): Min dag, Ordre/avvik, Tilbud/import fra CET og Montasje, tegnet som ekte HTML i
 * naturlig størrelse (pc 1440 × 810, ipad 1180 × 796, telefon 402 × 874). Brukes i sporet til Enhet.astro, som skalerer den inn i rammen
 * (scripts/skala.ts). Tekst og data i content/crm.ts. «Din logo» i sidemenyen (PC, iPad) og toppen (telefon); Hengsel CRM-logoen (hengsel-crm-aksent, 16 px) nederst i sidemenyen.
 * Uten `interaktiv` er skjermen en ren illustrasjon (inert, role="img"); med `interaktiv` har den data-neste på raden og knappene
 * som går videre i demoen (scripts/crm.ts).
 */
import { PRODUKTLOGO } from "@sngroup/hengsel-tokens/produktlogo";
import { kundeFra } from "../kunde";
import { CRM_AKTIV_MENY, CRM_ALT, CRM_BRUKER, CRM_MENY, MINDAG_AVVIK, MINDAG_META, MINDAG_RADER, MINDAG_TALL, MONTASJE, ORDRE, TELEFON_FANER, TILBUD } from "../content/crm";
import type { CrmEnhet, Skjerm } from "../content/crm";

/** mac: PC-skjermen i MacBook-rammen (N-10), 1440 × 900 i stedet for 1440 × 810 */
interface Props { skjerm?: Skjerm; enhet?: CrmEnhet; interaktiv?: boolean; mac?: boolean }
const { skjerm = "minDag", enhet = "pc", interaktiv = false, mac = false } = Astro.props;
const tlf = enhet === "telefon";
const aktivMeny = CRM_AKTIV_MENY[skjerm];
const stat = interaktiv ? {} : { inert: true, role: "img", "aria-label": CRM_ALT };
const rader = MINDAG_RADER.slice(0, tlf ? 5 : 6);
const fanerAktiv = (f: string) => (f === "Min dag" && skjerm === "minDag") || (f === "Ordre" && skjerm !== "minDag");
import { APPTEST } from "../apptest-lenker";
---
<div class:list={["crm", enhet, skjerm, { mac }]} data-produkt={kundeFra(Astro.url.pathname) ? undefined : "crm"} data-skjerm={skjerm} data-enhet-type={enhet} {...stat}>
  {!tlf && (
    <aside class="side">
      <div class="logo"><span class="dinlogo"><span class="boks">Din logo</span></span></div>
      {CRM_MENY.map(([l, n]) => <div class:list={["mi", { aktiv: l === aktivMeny }]}><span>{l}</span><span class="n">{n}</span></div>)}
      <div class="bruker"><div class="ink">{CRM_BRUKER[0]}</div><div>{CRM_BRUKER[1]}</div></div>
      <div class="hengsel-crm">
        <picture>
          <img src={PRODUKTLOGO.crm.src} alt={PRODUKTLOGO.crm.alt} width={PRODUKTLOGO.crm.width} height={PRODUKTLOGO.crm.height} loading="lazy" decoding="async" />
        </picture>
        <span>v. {APPTEST.versjon}</span>
      </div>
    </aside>
  )}
  <div class="hoved">
    {tlf && (
      <>
        <div class="tomrom"></div>
        <div class="topp">
          <span class="dinlogo"><span class="boks">Din logo</span></span>
          <span class="kb">KB</span>
        </div>
      </>
    )}

    {skjerm === "minDag" && (
      <>
        <div class="hode"><span class="meta">{tlf ? MINDAG_META.telefon : MINDAG_META.pc}</span><div class="h">God morgen, Kristine.</div></div>
        <div class="grid2">
          <div class="kort liste">
            <div class="kh"><b>I dag</b><span class="meta">6 igjen</span></div>
            {rader.map(([t, s, p, tone, hast]) => {
              const inn = (<>
                <span class="ring"></span>
                <span class="tekst"><span class="t">{t}</span><span class="s">{s}</span></span>
                <span class={`pil ${tone}`}>{p}</span>
              </>);
              return hast
                ? <button type="button" class="rad hast" data-neste>{inn}</button>
                : <div class="rad">{inn}</div>;
            })}
          </div>
          {!tlf && (
            <div class="kort avvik">
              <div class="avvik-topp"><span class="serif">{MINDAG_AVVIK.tittel}</span><span class="pil bad">{MINDAG_AVVIK.pille}</span></div>
              <span class="meta">{MINDAG_AVVIK.under}</span>
              <div class="felter">{MINDAG_AVVIK.felt.map(([a, b]) => <div class="felt"><div class="fl">{a}</div><div class="fv">{b}</div></div>)}</div>
              <div class="knapperad"><button type="button" class="knapp" data-neste>{MINDAG_AVVIK.knapp}</button><span class="meta">{MINDAG_AVVIK.eller}</span></div>
            </div>
          )}
        </div>
        {!tlf && (
          <div class="tall">{MINDAG_TALL.map(([v, l]) => <div class="tk"><div class="tv">{v}</div><div class="fl">{l}</div></div>)}</div>
        )}
      </>
    )}

    {skjerm === "ordre" && (
      <>
        <div class="hode"><span class="meta">{ORDRE.brodsmule}</span><div class="h">{ORDRE.tittel}</div><span class="meta">{ORDRE.under}</span></div>
        <div class="banner bad"><b>{ORDRE.avvikTittel}</b> {ORDRE.avvikTekst}</div>
        <div class="grid2">
          <div class="kort ob">
            <b class="ktit">{ORDRE.obTittel}</b>
            <div class="obrad hd">{ORDRE.kolonner.map((k) => <span>{k}</span>)}</div>
            {ORDRE.linjer.map(([l, a, b, s, tone]) => <div class="obrad"><span>{l}</span><span>{a}</span><span>{b}</span><span class={`pil ${tone}`}>{s}</span></div>)}
            <div class="knapperad vis"><button type="button" class="knapp ring-fokus" data-neste>{ORDRE.be}</button><button type="button" class="knapp omriss">{ORDRE.godta}</button></div>
          </div>
          {!tlf && (
            <div class="kort logg">
              <b class="ktit">{ORDRE.loggTittel}</b>
              {ORDRE.logg.map(([t, x]) => <div class="lr"><span class="lt">{t}</span><span>{x}</span></div>)}
            </div>
          )}
        </div>
      </>
    )}

    {skjerm === "tilbud" && (
      <>
        <div class="hode"><span class="meta">{TILBUD.brodsmule}</span><div class="h">{TILBUD.tittel}</div><span class="meta">{TILBUD.under}</span></div>
        <div class="cet">
          <div class="cet-topp"><span class="serif stor">{TILBUD.kort}</span><span class="pil info">{TILBUD.pille}</span></div>
          <span class="meta">{TILBUD.tegning}</span>
          <div class="felter3">{TILBUD.felt.map(([a, b]) => <div class="felt"><div class="fl">{a}</div><div class="fv">{b}</div></div>)}</div>
          <b class="ktit">{TILBUD.endret}</b>
          {TILBUD.diff.map(([s, x, k]) => <div class="dr"><span class="ds">{s}</span><span class="dx">{x}</span><span class="dk">{k}</span></div>)}
          <div class="pris"><span>{TILBUD.prisEtikett}</span><span class="serif prisv">{TILBUD.pris}</span></div>
          <div class="knapperad vis"><button type="button" class="knapp ring-fokus-kort" data-neste>{TILBUD.importer}</button><button type="button" class="knapp ingen">{TILBUD.avbryt}</button></div>
        </div>
      </>
    )}

    {skjerm === "montasje" && (
      <>
        <div class="hode"><span class="meta">{MONTASJE.meta}</span><div class="h">{MONTASJE.tittel}</div></div>
        {!tlf && (
          <div class="kort plan">
            <div class="plrad hd"><span>{MONTASJE.kolonne}</span>{MONTASJE.dager.map((d) => <span>{d}</span>)}</div>
            {MONTASJE.rader.map(([navn, firma, celler]) => (
              <div class="plrad">
                <div class="pn"><span class="pt">{navn}</span><span class="s">{firma}</span></div>
                {celler.map((c) => c
                  ? <div class:list={["celle", c[2] || "std"]}><span class="ct">{c[0]}</span><span class="s2">{c[1]}</span></div>
                  : <div class="tom"></div>)}
              </div>
            ))}
          </div>
        )}
        {tlf && (
          <div class="kort pliste">
            {MONTASJE.liste.map(([t, s, p, tone]) => <div class="pl"><div class="tekst"><span class="t">{t}</span><span class="s">{s}</span></div><span class={`pil ${tone}`}>{p}</span></div>)}
          </div>
        )}
        <div class="banner ok"><b>{MONTASJE.ok}</b> {MONTASJE.okTekst}</div>
      </>
    )}
  </div>

  {tlf && (
    <div class="faner">{TELEFON_FANER.map((f) => <span class:list={["fane", { aktiv: fanerAktiv(f) }]}>{f}</span>)}</div>
  )}
</div>

<style>
  .crm { display: flex; background: var(--surface-app); color: var(--ink); font-family: var(--f-body); font-size: 16px; line-height: 1.4; overflow: hidden; position: relative; box-sizing: border-box; text-align: left; -webkit-font-smoothing: antialiased; }
  .crm.pc { width: 1440px; height: 810px; }
  .crm.pc.mac { height: 900px; }
  .crm.ipad { width: 1180px; height: 796px; }
  .crm.telefon { width: 402px; height: 874px; }
  .crm :is(button) { font-family: var(--f-body); }
  .ink { color: var(--ink); }
  .meta { font-size: 14px; color: var(--muted); }
  .s, .s2, .fl { font-size: 13px; color: var(--muted); }
  .s2 { font-size: 12px; }
  .serif { font-family: var(--f-display); font-weight: var(--skrift-vekt-fet); font-size: 26px; line-height: 1.15; }

  /* Sidemeny (PC, iPad) */
  .side { flex: none; padding: 24px 12px; box-sizing: border-box; display: flex; flex-direction: column; gap: 2px; border-right: 1px solid var(--line); background: var(--surface-soft); }
  .pc .side { width: 248px; } .ipad .side { width: 220px; }
  .logo { display: flex; flex-direction: column; gap: 8px; padding: 6px 12px 22px; }
  .dinlogo { display: flex; flex-direction: column; gap: 3px; align-items: flex-start; }
  .dinlogo .boks { height: 40px; padding: 0 18px; border: 1.5px dashed var(--kant); border-radius: var(--radius-felt); display: flex; align-items: center; font-size: 15px; font-weight: 600; letter-spacing: .02em; color: var(--ink); box-sizing: border-box; }
  .telefon .dinlogo .boks { height: 34px; padding: 0 15px; font-size: 14px; }
  .mi { display: flex; justify-content: space-between; align-items: center; min-height: 40px; padding: 0 14px; border-radius: var(--radius-kort-lite); font-size: 15px; }
  .mi.aktiv { font-weight: 600; background: var(--surface-highlight-strong); }
  .mi .n { color: var(--muted); font-size: 13px; font-weight: 400; }
  .hengsel-crm { padding: 0 12px 4px; display: flex; align-items: center; gap: 8px; }
  .hengsel-crm span { font-size: 11px; color: var(--muted); }
  .hengsel-crm img { display: block; height: 16px; width: auto; }
  .bruker { margin-top: auto; padding: 12px; font-size: 14px; line-height: 1.5; color: var(--muted); }

  .hoved { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 20px; box-sizing: border-box; overflow: hidden; }
  .pc .hoved { padding: 32px 40px; } .ipad .hoved { padding: 28px; }
  .telefon .hoved { padding: 0 16px 100px; gap: 14px; }
  .tomrom { height: 54px; flex: none; }
  .topp { display: flex; align-items: center; justify-content: space-between; padding: 0 0 12px; }
  .kb { width: 36px; height: 36px; border-radius: var(--radius-pille); background: var(--surface-highlight-strong); display: grid; place-items: center; font-size: 13px; font-weight: 600; }

  .hode { display: flex; flex-direction: column; gap: 4px; }
  .h { font-family: var(--f-display); font-weight: var(--skrift-vekt-fet); font-size: 46px; line-height: 1.08; letter-spacing: -.015em; }
  .telefon .h { font-size: 32px; }
  .grid2 { display: grid; gap: 16px; align-items: start; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
  .ordre .grid2 { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }
  .telefon .grid2 { grid-template-columns: minmax(0, 1fr); }
  .kort { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-kort-stor); padding: 18px 20px; min-width: 0; box-sizing: border-box; }
  .ktit { font-weight: 600; font-size: 16px; display: block; }

  /* Min dag */
  .liste { display: flex; flex-direction: column; gap: 4px; }
  .kh { display: flex; align-items: baseline; gap: 10px; padding-bottom: 8px; }
  .kh b { font-weight: 600; font-size: 16px; }
  .rad { display: flex; align-items: center; gap: 14px; padding: 10px 12px; border-radius: var(--radius-kort-lite); background: transparent; border: 0; color: inherit; text-align: left; font-size: 16px; width: 100%; box-sizing: border-box; }
  .rad.hast { cursor: pointer; background: var(--surface-highlight); box-shadow: inset 3px 0 0 var(--bad), 0 0 0 2px var(--accent); }
  .rad:hover { background: var(--surface-soft); }
  .ring { width: 20px; height: 20px; border-radius: var(--radius-pille); border: 1.5px solid var(--kant); flex: none; box-sizing: border-box; }
  .tekst { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .tekst .t { font-size: 15px; }
  .tekst .s { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .avvik { display: flex; flex-direction: column; gap: 14px; padding: 20px 22px; }
  .avvik-topp { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
  .felter { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .felt { background: var(--surface-soft); border-radius: var(--radius-kort-lite); padding: 10px 14px; }
  .fv { font-size: 16px; }
  .knapperad { display: flex; gap: 8px; align-items: center; }
  .knapperad.vis { flex-wrap: wrap; }
  .knapp { min-height: 44px; padding: 0 20px; border-radius: var(--radius-pille); border: 0; background: var(--accent); color: var(--accent-ink); font: 500 15px var(--f-body); cursor: pointer; }
  .knapp.omriss { border: 1px solid var(--ink); background: transparent; color: var(--ink); }
  .knapp.ingen { background: transparent; color: var(--ink); }
  .knapp.ring-fokus { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--accent); }
  .knapp.ring-fokus-kort { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--accent); }
  .tall { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .tk { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-kort-stor); padding: 16px 20px; }
  .tv { font-family: var(--f-display); font-weight: var(--skrift-vekt-fet); font-size: 34px; line-height: 1.1; font-variant-numeric: tabular-nums; }

  /* Piller (designsystemets Pill): prikk og tekst, furutonet for info */
  .pil { display: inline-flex; align-items: center; gap: 6px; min-height: 24px; padding: 0 10px; border-radius: var(--radius-pille); font: 500 12px/1 var(--f-body); white-space: nowrap; flex: none; background: var(--surface-highlight-strong); color: var(--ink); }
  .pil::before { content: ""; width: 6px; height: 6px; border-radius: var(--radius-pille); background: currentColor; }
  .pil.info { background: var(--accent-soft); color: var(--info-tekst); }
  .pil.bad { background: var(--bad-soft); color: var(--bad); }
  .pil.ok { background: var(--ok-soft); color: var(--ok); }
  .pil.warn { background: var(--warn-soft); color: var(--warn); }

  /* Banner */
  .banner { border-radius: var(--radius-kort-lite); padding: 14px 18px; font-size: 15px; }
  .banner.bad { background: var(--bad-soft); box-shadow: inset 3px 0 0 var(--bad); }
  .banner.bad b { color: var(--bad); font-weight: 600; }
  .banner.ok { background: var(--ok-soft); box-shadow: inset 3px 0 0 var(--ok); }
  .banner.ok b { color: var(--ok); font-weight: 600; }

  /* Ordre */
  .ob { display: flex; flex-direction: column; gap: 2px; }
  .ob .ktit { padding-bottom: 10px; }
  .obrad { display: grid; grid-template-columns: 1.4fr 1fr 1fr auto; gap: 8px; font-size: 14px; padding: 10px 0; border-bottom: 1px solid var(--line); align-items: center; }
  .obrad.hd { font-size: 13px; color: var(--muted); padding: 6px 0; }
  .ob .knapperad { padding-top: 14px; }
  .logg { display: flex; flex-direction: column; gap: 12px; }
  .lr { display: flex; gap: 12px; font-size: 14px; }
  .lt { color: var(--muted); width: 46px; flex: none; font-variant-numeric: tabular-nums; }

  /* Tilbud */
  .cet { background: var(--surface); border-radius: var(--radius-kort-stor); padding: 22px 24px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 14px; max-width: 720px; }
  .telefon .cet { max-width: none; padding: 18px; gap: 12px; }
  .cet-topp { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .serif.stor { font-size: 28px; }
  .felter3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }
  .telefon .felter3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .dr { display: flex; gap: 12px; font-size: 14px; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .ds { width: 16px; color: var(--accent); font-weight: 600; }
  .dx { flex: 1; }
  .dk { color: var(--muted); font-variant-numeric: tabular-nums; }
  .pris { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 4px; font-size: 15px; }
  .prisv { font-size: 30px; font-variant-numeric: tabular-nums; }

  /* Montasje */
  .plan { padding: 18px 20px; }
  .plrad { display: grid; grid-template-columns: 180px repeat(5, minmax(0, 1fr)); gap: 8px; padding: 12px 0; border-bottom: 1px solid var(--line); align-items: center; min-height: 56px; }
  .plrad.hd { font-size: 13px; color: var(--muted); padding: 0 0 10px; min-height: 0; }
  .pn { display: flex; flex-direction: column; }
  .pt { font-size: 15px; }
  .celle { display: flex; flex-direction: column; gap: 2px; border-radius: var(--radius-kort-lite); padding: 8px 10px; min-width: 0; background: var(--surface-soft); box-shadow: inset 3px 0 0 var(--linje); }
  .celle.ny { background: var(--accent-soft); box-shadow: inset 3px 0 0 var(--accent); }
  .celle.warn { background: var(--warn-soft); box-shadow: inset 3px 0 0 var(--warn); }
  .celle.bad { background: var(--bad-soft); box-shadow: inset 3px 0 0 var(--bad); }
  .ct { font-size: 14px; }
  .tom { min-height: 44px; }
  .pliste { padding: 6px 16px; }
  .pl { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .pl:last-child { border-bottom: 0; }

  /* Telefon: fanelinje nederst */
  .faner { position: absolute; left: 0; right: 0; bottom: 0; height: 84px; background: var(--surface); border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(4, 1fr); padding: 10px 8px 0; box-sizing: border-box; }
  .fane { text-align: center; font-size: 12px; color: var(--muted); }
  .fane.aktiv { font-weight: 600; color: var(--accent); }
</style>

---
import { PRODUKTLOGO } from "@sngroup/hengsel-tokens/produktlogo";
/**
 * Sidehodet på /apptest og passordsiden (Apptest.dc.html): bare logoen og «Meld feil». Ingen hovedmeny, siden lenkes ikke fra menyen.
 */
interface Props { meldFeil?: boolean }
const { meldFeil = false } = Astro.props;
---
<header class="sidehode">
  <div class="rad h-innhold">
    <a class="logo" href="/" aria-label="Hengsel – til forsiden">
      <picture>
        <img src={PRODUKTLOGO.nettsider.src} alt={PRODUKTLOGO.nettsider.alt} width={PRODUKTLOGO.nettsider.width} height={PRODUKTLOGO.nettsider.height} />
      </picture>
    </a>
    {meldFeil && <a class="meld" href="#meld-feil">Meld feil</a>}
  </div>
</header>

<style>
  .sidehode { border-bottom: 1px solid var(--line); background: var(--a-flate, var(--bg)); }
  .rad { height: var(--topp); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .logo { display: flex; align-items: center; min-height: 44px; }
  .logo img { display: block; height: 30px; width: auto; }
  .meld { color: var(--a-lenke, var(--accent)); font-size: 0.95rem; min-height: 44px; display: flex; align-items: center; }
</style>

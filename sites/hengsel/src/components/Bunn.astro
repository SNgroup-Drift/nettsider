---
/** Bunnen (Bunn.dc.html): Hengsel-merket, to lenkegrupper, kontakt og selskapslinja. Tekst ordrett fra LES-MEG.md. */
import { PRODUKTLOGO } from "@sngroup/hengsel-tokens/produktlogo";
import { BUNN_MER, BUNN_PRODUKT } from "../content/nav";
import { EPOST, TEL, TEL_HREF } from "../content/forside";
import KundeLogo from "./KundeLogo.astro";
import { kundeHref, type Kunde } from "../kunde";
interface Props { /** Kundeutgave (K-223) */ kunde?: Kunde }
const { kunde } = Astro.props;
const produkt = kunde ? kunde.bunnProdukt.map(([t, h]) => [t, kundeHref(kunde, h)] as const) : BUNN_PRODUKT;
---
<footer class="bunn">
  <div class="rutenett">
    <div class="merke">
      {kunde ? (
        <KundeLogo kunde={kunde} />
      ) : (
        <picture>
          <img src={PRODUKTLOGO.nettsider.src} alt={PRODUKTLOGO.nettsider.alt} width={PRODUKTLOGO.nettsider.width} height={PRODUKTLOGO.nettsider.height} loading="lazy" />
        </picture>
      )}
      <p>{kunde ? `${kunde.produkt}: CRM, montørapp og kundeportal for Sigdals butikker.` : "CRM, montørapp og kundeportal for kjøkken- og interiørbutikker."}</p>
    </div>
    <nav aria-label="Produkt">
      <span class="tittel">Produkt</span>
      {produkt.map(([t, h]) => <a href={h}>{t}</a>)}
    </nav>
    <nav aria-label="Mer">
      <span class="tittel">Mer</span>
      {kunde
        ? <><a href={kundeHref(kunde, "/slik-virker-det")}>Slik virker det</a><a href={kundeHref(kunde, "/integrasjoner")}>Integrasjoner og sikkerhet</a><a href={kunde.vis}>Visningsrommet</a></>
        : BUNN_MER.map(([t, h]) => <a href={h}>{t}</a>)}
    </nav>
    {kunde?.reklamasjon && (
      <nav aria-label="Meld reklamasjon">
        <span class="tittel">Meld reklamasjon</span>
        {kunde.reklamasjon.map(([t, h]) => <a href={h}>Meld reklamasjon · {t}</a>)}
      </nav>
    )}
    <div class="kontakt">
      <span class="tittel">Kontakt</span>
      <a href={TEL_HREF}>{TEL}</a>
      <a href={`mailto:${EPOST}`}>{EPOST}</a>
      <span class="dempet">Enromvegen 173, 7026 Trondheim</span>
    </div>
  </div>
  <div class="linje">
    <div class="linje-inn">
      <span>{kunde ? `${kunde.produkt} · levert av Hengsel · ES-HOLDING AS · org.nr. 927 363 585` : "Hengsel · ES-HOLDING AS · org.nr. 927 363 585"}</span>
      <span>Skjermbildene viser demodata. Navn og tall er ikke ekte.</span>
      <a href={kunde ? "https://hengsel.no/personvern" : "/personvern"}>Personvern</a>
    </div>
  </div>
</footer>

<style>
  .bunn { background: var(--bg); color: var(--ink); border-top: 1px solid var(--line); font-size: 0.95rem; }
  .rutenett, .linje-inn { max-width: var(--ramme); margin: 0 auto; box-sizing: border-box; padding-inline: var(--marg); }
  .rutenett { padding-block: 48px 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; }
  .merke { display: flex; flex-direction: column; gap: 12px; }
  .merke img { height: 30px; width: auto; align-self: flex-start; }
  .merke p { color: var(--muted); line-height: 1.55; max-width: 30ch; }
  nav, .kontakt { display: flex; flex-direction: column; gap: 4px; }
  .tittel { font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  a { color: var(--ink); display: inline-flex; align-items: center; min-height: 32px; }
  a:hover { color: var(--accent); }
  .dempet { color: var(--muted); }
  .linje { border-top: 1px solid var(--line); }
  .linje-inn { padding-block: 20px 28px; display: flex; flex-wrap: wrap; gap: 8px 28px; justify-content: space-between; font-size: 0.88rem; color: var(--muted); }
  .linje-inn a { min-height: 0; color: inherit; text-decoration: underline; text-underline-offset: 3px; }
</style>

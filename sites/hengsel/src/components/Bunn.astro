---
/** Bunnen (Bunn.dc.html): Hengsel-merket, to lenkegrupper, kontakt og selskapslinja. Tekst ordrett fra LES-MEG.md. */
import { BUNN_MER, BUNN_PRODUKT } from "../content/nav";
import { EPOST, TEL, TEL_HREF } from "../content/forside";
---
<footer class="bunn">
  <div class="rutenett">
    <div class="merke">
      <picture>
        <img src="/logo/hengsel-aksent-lys.svg" alt="Hengsel" width="422" height="100" loading="lazy" />
      </picture>
      <p>CRM, montørapp og kundeportal for kjøkken- og interiørbutikker.</p>
    </div>
    <nav aria-label="Produkt">
      <span class="tittel">Produkt</span>
      {BUNN_PRODUKT.map(([t, h]) => <a href={h}>{t}</a>)}
    </nav>
    <nav aria-label="Mer">
      <span class="tittel">Mer</span>
      {BUNN_MER.map(([t, h]) => <a href={h}>{t}</a>)}
    </nav>
    <div class="kontakt">
      <span class="tittel">Kontakt</span>
      <a href={TEL_HREF}>{TEL}</a>
      <a href={`mailto:${EPOST}`}>{EPOST}</a>
      <span class="dempet">Enromvegen 173, 7026 Trondheim</span>
    </div>
  </div>
  <div class="linje">
    <div class="linje-inn">
      <span>Hengsel · ES-HOLDING AS · org.nr. 927 363 585</span>
      <span>Skjermbildene viser demodata. Navn og tall er ikke ekte.</span>
      <a href="/personvern">Personvern</a>
    </div>
  </div>
</footer>

<style>
  .bunn { background: var(--bg); color: var(--ink); border-top: 1px solid var(--line); font-size: 0.95rem; }
  .rutenett, .linje-inn { max-width: calc(var(--wrap) + 2 * var(--pad)); margin: 0 auto; box-sizing: border-box; padding-inline: var(--pad); }
  .rutenett { padding-block: 48px 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; }
  .merke { display: flex; flex-direction: column; gap: 12px; }
  .merke img { height: 30px; width: auto; align-self: flex-start; }
  .merke p { color: var(--muted); line-height: 1.55; max-width: 30ch; }
  nav, .kontakt { display: flex; flex-direction: column; gap: 4px; }
  .tittel { font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  a { color: var(--ink); display: inline-flex; align-items: center; min-height: 32px; }
  a:hover { color: var(--accent); }
  .dempet { color: var(--muted); }
  .linje { border-top: 1px solid var(--line); }
  .linje-inn { padding-block: 20px 28px; display: flex; flex-wrap: wrap; gap: 8px 28px; justify-content: space-between; font-size: 0.88rem; color: var(--muted); }
  .linje-inn a { min-height: 0; color: inherit; text-decoration: underline; text-underline-offset: 3px; }
</style>

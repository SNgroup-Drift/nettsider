---
/**
 * Ett dokument i Dokumentvisning: «Slik lages det»-stripen, arket med bla-knapper og innholdslisten.
 * Brukes både direkte (første dokument) og inni <template> (de andre, så de ikke gir DOM før de velges).
 */
import { LAGES_STEG, type Dokument } from "@sngroup/hengsel-dokumenter/data";
import A4Side from "./A4Side.astro";

interface Props { dok: Dokument; forst?: boolean }
const { dok, forst = false } = Astro.props;
const total = dok.sider.length;
---
<div class="dv-lages">
  <span class="dv-eb">Slik lages det</span>
  <ol class="dv-steg">
    {dok.lages.map((t, i) => (
      <li><span class="dv-eb liten">{i + 1} · {LAGES_STEG[i]}</span><span>{t}</span></li>
    ))}
  </ol>
</div>
<div class="dv-vis">
  <div class="dv-ark-kol">
    <div class:list={["dv-ark", { ligg: dok.ligg }]} data-ark tabindex="0" role="group" aria-label={`${dok.t}: bla med piltastene eller sveip`}>
      {dok.sider.map((side, i) => (
        <div class="dv-side" data-side hidden={i > 0}>
          <A4Side side={side} fot={dok.fot} nr={i + 1} total={total} ligg={dok.ligg} forst={forst && i === 0} />
        </div>
      ))}
      <button type="button" class="dv-zoom" data-apne aria-label="Åpne siden i lysboksen"></button>
    </div>
    <div class="dv-nav">
      <button type="button" class="dv-rund" data-forrige aria-label="Forrige side" disabled>‹</button>
      <span class="dv-teller" data-teller aria-live="polite">Side 1 av {total}</span>
      <button type="button" class="dv-rund" data-neste aria-label="Neste side" disabled={total < 2}>›</button>
      <button type="button" class="dv-lys-knapp" data-apne>Åpne i lysboks</button>
    </div>
  </div>
  <div class="dv-info">
    <div class="dv-tittelrad">
      <h2 class="dv-tittel" data-dok-tittel>{dok.t}</h2>
      <span class="eks">Eksempel</span>
    </div>
    <p class="dv-under">{dok.s}</p>
    <ol class="dv-innhold">
      {dok.sider.map((s, i) => (
        <li><button type="button" data-gaa={i} aria-current={i === 0 ? "page" : undefined}><span class="nr">Side {i + 1}</span><span>{s.navn}</span></button></li>
      ))}
    </ol>
  </div>
</div>

---
/**
 * Én A4-side (fasit: A4Side.dc.html), stående eller liggende. Markeringen lages av den felles gjengiveren
 * (packages/hengsel-dokumenter/src/render.js), som Visningsrommet også bruker, så sidene er like begge steder.
 *
 * Siden skalerer med bredden den får (CSS container-enheter, se a4.css): sett bredden på omslaget eller i --a4-maks. Ingen skript.
 * Kolonnemaler og bildehøyder blir klasser; reglene lages av a4DynamiskCss() (Dokumentvisning legger dem i én <style>).
 * Merket øverst er «Din logo | Butikknavn Hamar», og Hengsel-logoen står i bunnlinjen til høyre. Papiret er alltid lyst.
 * Forsidebildet er nettsidenes eget (K-233: LOKALE_BILDER i packages/hengsel-tokens/skjermbilder.mjs), ikke fra skjermbildebiblioteket.
 */
import "@sngroup/hengsel-dokumenter/a4.css";
import type { DokSide } from "@sngroup/hengsel-dokumenter/data";
import { renderA4Side } from "@sngroup/hengsel-dokumenter/render";
import { lokalUrl } from "@sngroup/hengsel-tokens/skjermbilder.mjs";
import { kundeFra } from "../../kunde";

interface Props {
  side: DokSide;
  /** Bunnlinjen, venstre side */
  fot: string;
  nr: number;
  total: number;
  ligg?: boolean;
  /** Forsidebildet lastes med en gang (ellers lazy) */
  forst?: boolean;
  class?: string;
}
const { side, fot, nr, total, ligg = false, forst = false, class: klasse } = Astro.props;
// K-233: forsidebildet (dok-forside.webp, 1200 × 768) er nettsidenes eget (LOKALE_BILDER, public/img) og kommer ikke fra biblioteket; i Sigdal-utgaven
// (/kunde/sigdal) finnes det ikke, og plassholderen tegnes (som K-223)
const tema = kundeFra(Astro.url.pathname)?.nokkel ?? "hengsel";
const html = renderA4Side(side, { fot, nr, total, ligg, forst, klasse, bildeSti: tema === "hengsel" ? lokalUrl("dok-forside.webp") : null });
---
<Fragment set:html={html} />

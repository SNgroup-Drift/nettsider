---
/**
 * Én A4-side (fasit: A4Side.dc.html), stående eller liggende. Markeringen lages av den felles gjengiveren
 * (packages/design/src/dokumenter/render.js), som Visningsrommet også bruker, så sidene er like begge steder.
 *
 * Siden skalerer med bredden den får (CSS container-enheter, se a4.css): sett bredden på omslaget eller i --a4-maks. Ingen skript.
 * Kolonnemaler og bildehøyder blir klasser; reglene lages av a4DynamiskCss() (Dokumentvisning legger dem i én <style>).
 * Merket øverst er «Din logo | Butikknavn Hamar», og «by Hengsel» står i bunnlinjen. Papiret er alltid lyst.
 */
import "@sngroup/design/dokumenter/a4.css";
import type { DokSide } from "@sngroup/design/dokumenter/data";
import { renderA4Side } from "@sngroup/design/dokumenter/render";

interface Props {
  side: DokSide;
  /** Bunnlinjen, venstre side */
  fot: string;
  nr: number;
  total: number;
  ligg?: boolean;
  /** Forsidebildet lastes med en gang (ellers lazy) */
  forst?: boolean;
  class?: string;
}
const { side, fot, nr, total, ligg = false, forst = false, class: klasse } = Astro.props;
const html = renderA4Side(side, { fot, nr, total, ligg, forst, klasse });
---
<Fragment set:html={html} />

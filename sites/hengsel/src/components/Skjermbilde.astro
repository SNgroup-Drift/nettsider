---
/** Bildet inne i en enhetsramme: <picture>, bredde og høyde (ingen CLS), lazy med mindre det er øverst. */
interface Props { src: string; w: number; h: number; alt: string; forst?: boolean; topp?: boolean; hd?: boolean }
const { src, w, h, alt, forst = false, topp = false, hd = false } = Astro.props;
// hd: src er 2×, og @1x-utgaven ligger ved siden av
const sett = (s: string) => (hd ? `${s.replace(/\.webp$/, "@1x.webp")} 1x, ${s} 2x` : s);
---
<picture>
  <img class:list={["innhold", { topp }]} src={src} srcset={hd ? sett(src) : undefined} alt={alt} width={w} height={h} loading={forst ? "eager" : "lazy"} fetchpriority={forst ? "high" : undefined} decoding="async" />
</picture>
<style>
  img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  img.topp { object-position: top left; }
</style>

---
/**
 * Ny forside (prøveside): en tydelig plassholder der Eirik har materiale (film, bilde eller tekst). Stiplet kant (--kant, ≥ 3:1), pillen «Plassholder»
 * og hva som skal stå der. Film og bilde får fast format (16:9 og 4:3), så siden ikke hopper når materialet kommer. Ingen style= (CSP).
 */
import Flis, { type Bredde } from "./kit/Flis.astro";
import Pille from "./kit/Pille.astro";

interface Props {
  type: "film" | "bilde" | "tekst";
  tittel: string;
  hva: string;
  tekst: string;
  bredde?: Bredde;
  id?: string;
}
const { type, tittel, hva, tekst, bredde = "1/2", id } = Astro.props;
---
<Flis bredde={bredde} tittel={tittel} id={id} klasse="plassholderflis">
  <Pille slot="verktoy" tone="venter">Plassholder</Pille>
  <figure class:list={["ph", type]} data-plassholder={type} role="img" aria-label={`Plassholder. ${hva}. ${tekst}`}>
    {type === "film" && (
      <svg class="symbol" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="22" /><path d="M19 15.5v17c0 1.2 1.3 1.9 2.3 1.3l13.4-8.5c.9-.6.9-2 0-2.6L21.3 14.2c-1-.6-2.3.1-2.3 1.3z" /></svg>
    )}
    {type === "bilde" && (
      <svg class="symbol" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><rect x="4" y="9" width="40" height="30" rx="4" /><circle cx="16" cy="19" r="4" /><path d="M8 35l10-10 7 7 6-6 9 9" /></svg>
    )}
    {type === "tekst" && (
      <svg class="symbol" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M10 14h28M10 22h28M10 30h18" /></svg>
    )}
    <b>{hva}</b>
    <span>{tekst}</span>
  </figure>
</Flis>

<style>
  .ph { flex: 1; display: grid; align-content: center; justify-items: center; gap: 8px; margin: 4px 0 0; padding: 24px; border: 2px dashed var(--kant); border-radius: var(--radius-kort-lite); background: var(--flate-senket); color: var(--tekst-dempet); text-align: center; font-size: 14px; line-height: 20px; }
  .ph.film { aspect-ratio: 16 / 9; flex: none; }
  .ph.bilde { aspect-ratio: 4 / 3; flex: none; }
  .ph b { color: var(--tekst); font-weight: var(--skrift-vekt-sterk); }
  .ph span { max-width: 360px; }
  .symbol { width: 48px; height: 48px; fill: none; stroke: var(--kant); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .film .symbol path { fill: var(--kant); stroke: none; }
</style>

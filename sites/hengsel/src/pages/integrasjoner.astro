---
/**
 * /integrasjoner, sidekartet 25-005 (S-68): toppen og to rader i nettside-kitet:
 *  rad 1 (480) Tabell «Koblinger» (8 rader; raden åpner «om»-teksten, på telefon også kolonnene imellom) ·
 *  rad 2 (320) Tabell «Kundens data, trygt lagret.» (4 rader fra sidekartet + eierlinja med databehandleravtalen, se N-3-rapporten).
 * Tekster i content/integrasjoner.ts. Systemkartet (K-160) er erstattet av tabellen etter sidekartet.
 */
import Side from "../layouts/Side.astro";
import Sidetopp from "../components/kit/Sidetopp.astro";
import Innhold from "../components/kit/Innhold.astro";
import Rad from "../components/kit/Rad.astro";
import Tabellflis, { tabellHoyde } from "../components/kit/Tabellflis.astro";
import { HERO, PANEL, KOBLINGER, SIKKERHET } from "../content/integrasjoner";
const koblinger = KOBLINGER.filter((k) => !("midten" in k)).map((k) => ({ celler: [k.t, k.s, k.inn, k.ut, k.hvor], mer: k.om }));
const sikkerhet = [...SIKKERHET.kort.map(([t, s]) => [t, s]), ["Eier", `${SIKKERHET.selskap} ${SIKKERHET.epost}`]];
---
<Side
  title="Integrasjoner og sikkerhet – Hengsel"
  description={HERO.ingress}
  aktiv="int"
>
  <main id="innhold">
    <Sidetopp tittel={HERO.tittel} ingress={HERO.ingress} />
    <Innhold>
      <Rad hoyde={tabellHoyde(koblinger.length)}>
        <Tabellflis id="koblinger" tittel="Koblinger" kolonner={["Kobling", "Hva", PANEL.inn, PANEL.ut, "Brukes i"]} rader={koblinger} />
      </Rad>
      <Rad hoyde={tabellHoyde(sikkerhet.length)}>
        <Tabellflis id="sikkerhet" tittel={SIKKERHET.tittel} kolonner={["Hva", "Hvordan"]} rader={sikkerhet} />
      </Rad>
    </Innhold>
  </main>
</Side>

---
/**
 * Passordsiden for /apptest (K-107), i samme profil som apptest.astro (10.10.2026).
 * Serveres av Workeren (worker/apptest.ts) i stedet for /apptest når informasjonskapselen mangler eller er ugyldig.
 * Tilstand tom: som bygget. Tilstand feil: Workeren fjerner «hidden» på [data-feil] og setter aria-invalid på #passord.
 * Ligger under /apptest/, så den nås bare gjennom Workeren.
 */
import Side from "../../layouts/Side.astro";
import { APPTEST } from "../../apptest-lenker";

const { epost } = APPTEST;
---
<Side
  title="Test Hengsel Ute · Hengsel"
  description="Siden er for inviterte testere."
  robots="noindex,nofollow"
>
  <div class="side">
    <main id="innhold" class="midt">
      <form method="post" action="/apptest" class="skjema">
        <div class="tekst">
          <h1>Test Hengsel Ute</h1>
          <p class="dempet">Skriv passordet du fikk sammen med lenken.</p>
        </div>
        <div class="felt">
          <label for="passord">Passord</label>
          <input class="input" id="passord" name="passord" type="password" autocomplete="current-password" required aria-describedby="passord-feil" />
        </div>
        <p class="feil" id="passord-feil" role="alert" data-feil hidden>Feil passord. Prøv igjen, eller spør Eirik.</p>
        <button class="knapp" type="submit">Åpne</button>
      </form>
    </main>
  </div>
</Side>

<style>
  /* Samme profil som apptest.astro: Off White, Beige 3 kort og bunn, pillknapper */
  .side { flex: 1; display: flex; flex-direction: column; background: var(--bg); color: var(--ink); }
  .dempet { color: var(--muted); margin: 0; }
  a { color: var(--accent); }
  .rad { display: flex; align-items: center; justify-content: space-between; gap: 16px 24px; }
  .midt { display: grid; place-items: center; padding: clamp(32px, 8vw, 96px) clamp(16px, 4vw, 40px); }
  .skjema { width: 100%; max-width: 440px; box-sizing: border-box; padding: clamp(24px, 4vw, 36px); background: var(--flate); display: grid; gap: 18px; }
  .tekst { display: grid; gap: 8px; }
  h1 { font-size: var(--t-h1); line-height: 1.08; }
  .felt { display: grid; gap: 6px; }
  .felt label { font: 500 0.9rem var(--f-body); }
  .input { border-radius: 0; min-height: 48px; }
  .feil { margin: 0; padding: 12px 14px; background: var(--flate-myk); box-shadow: inset 3px 0 0 var(--bad); font-weight: 600; }
  .knapp {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; border-radius: var(--r-pill);
    border: 1px solid var(--accent); background: var(--accent); color: var(--bg); font: 650 1rem var(--f-body); cursor: pointer;
  }
  .knapp:hover { background: var(--accent); border-color: var(--accent); }
</style>

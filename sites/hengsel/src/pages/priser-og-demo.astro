---
/**
 * /priser-og-demo: sidekartet 25-006 (Priser) og 25-007 (Demo, skjema, #demo) på samme side, i nettside-kitet:
 *  25-006: rad 1 (480) Tabell «Dette inngår» (7 rader) · rad 2 (320) Tabell «Oppstart» (4 steg).
 *  25-007: egen topp «Be om demo» (#demo) · rad 1 (480) Skjema 1/2 (Navn, Firma, Telefon, E-post, «Be om demo») + Tekst 1/2 «Kontakt».
 * Ingen priser (Eirik): «Pris etter antall butikker og brukere. Be om tilbud.» Tekster og data i content/priser.ts.
 *
 * Skjemaet er <form method="post" action="/api/demo"> (Workeren, worker/demo.ts). scripts/demo.ts sender det med fetch uten sideskifte,
 * setter tidsfeltet «t» og viser feil, takk og mailto-reserven. Uten skript kan skjemaet ikke sendes (tidsfeltet mangler, og knappen er
 * deaktivert fra bygget), så en <noscript>-melding viser e-postlenken i stedet.
 */
import Side from "../layouts/Side.astro";
import Sidetopp from "../components/kit/Sidetopp.astro";
import Innhold from "../components/kit/Innhold.astro";
import Rad from "../components/kit/Rad.astro";
import Flis from "../components/kit/Flis.astro";
import Tabellflis, { tabellHoyde } from "../components/kit/Tabellflis.astro";
import Tekstflis from "../components/kit/Tekstflis.astro";
import Enhet from "../components/Enhet.astro";
import Simuleringsflis from "../components/kit/Simuleringsflis.astro";
import { STILL_PRISER as S } from "../content/simuleringer";
import { SIDE, INNGAR, OPPSTART, DEMO, KONTAKT, MAILTO } from "../content/priser";
import { TEL_HREF } from "../content/forside";
const f = DEMO.felt;
---
<Side title={SIDE.tittel} description={SIDE.beskrivelse} aktiv="pris">
  <main id="innhold">
    <Sidetopp tittel={SIDE.h1} ingress={SIDE.lede} />
    <Innhold>
      <Rad hoyde={tabellHoyde(INNGAR.length)}>
        <Tabellflis id="inngar" tittel="Dette inngår" kolonner={["Hva", "Innhold"]} rader={INNGAR} />
      </Rad>
      <Rad hoyde={tabellHoyde(OPPSTART.steg.length)}>
        <Tabellflis id="oppstart" tittel={OPPSTART.eyebrow} kolonner={["Steg", "Hva"]} rader={OPPSTART.steg} />
      </Rad>
      <Simuleringsflis id="i-bruk" tittel="Slik ser det ut">
        <Enhet type="display" bilde={S.display.bilde} alt={S.display.alt} />
        <Enhet type="iphone" bilde={S.iphone.bilde} alt={S.iphone.alt} utenStatus symboler={false} />
      </Simuleringsflis>
    </Innhold>

    <Sidetopp id="demo" niva={2} tittel={DEMO.h2} ingress={DEMO.ingress} />
    <Innhold>
      <Rad hoyde={480}>
        <Flis id="be-om-demo" bredde="1/2" tittel={DEMO.h2} klasse="skjemaflis">
          <form id="demo-skjema" method="post" action="/api/demo" novalidate data-demo data-epost={DEMO.kontakt.epost} data-reserve-emne={DEMO.reserve.emne} data-noytral-tittel={DEMO.reserveNoytral.tittel} data-noytral-lenke={DEMO.reserveNoytral.lenke}>
            <div class="felter">
              <div class="felt">
                <label for="demo-navn">{f.navn.l}</label>
                <input class="inn" id="demo-navn" name="navn" type="text" autocomplete="name" placeholder={f.navn.ph} maxlength="120" required aria-required="true" aria-describedby="demo-feil" />
              </div>
              <div class="felt">
                <label for="demo-butikk">{f.butikk.l}</label>
                <input class="inn" id="demo-butikk" name="butikk" type="text" autocomplete="organization" placeholder={f.butikk.ph} maxlength="120" />
              </div>
              <div class="felt">
                <label for="demo-tlf">{f.tlf.l}</label>
                <input class="inn" id="demo-tlf" name="tlf" type="tel" autocomplete="tel" placeholder={f.tlf.ph} maxlength="30" aria-describedby="demo-feil demo-tlf-feil" />
                <p class="felt-feil" id="demo-tlf-feil" data-felt-feil="tlf" hidden>{DEMO.feltFeil.tlf}</p>
              </div>
              <div class="felt">
                <label for="demo-epost">{f.epost.l}</label>
                <input class="inn" id="demo-epost" name="epost" type="email" autocomplete="email" placeholder={f.epost.ph} maxlength="254" aria-describedby="demo-feil demo-epost-feil" />
                <p class="felt-feil" id="demo-epost-feil" data-felt-feil="epost" hidden>{DEMO.feltFeil.epost}</p>
              </div>
            </div>

            <!-- Honeypot: skjult for alle, også skjermlesere. Roboter fyller det ut. -->
            <div class="skjult" aria-hidden="true">
              <label for="demo-nettsted">Nettsted</label>
              <input type="text" id="demo-nettsted" name="nettsted" tabindex="-1" autocomplete="off" value="" />
            </div>
            <input type="hidden" name="t" value="" data-tid />

            <div class="varsel" id="demo-feil" role="alert" tabindex="-1" data-feil hidden>
              <b>{DEMO.feilTittel}</b> {DEMO.feilTekst}
            </div>
            <div class="varsel" role="alert" tabindex="-1" data-reserve hidden>
              <b data-reserve-tittel>{DEMO.reserve.tittel}</b>
              <a href={MAILTO} data-mailto>{DEMO.reserve.lenke}</a>
            </div>
            <noscript>
              <p class="varsel">{DEMO.utenSkript} <a href={MAILTO}>{DEMO.utenSkriptLenke}</a></p>
            </noscript>

            <div class="send">
              <button class="btn primary" type="submit" data-send disabled>{DEMO.send}</button>
            </div>
          </form>

          <div class="takk" tabindex="-1" role="status" data-takk hidden>
            <b class="takk-h" data-takk-tekst data-ufullstendig={DEMO.takk(DEMO.takkReserveNavn)}>{DEMO.takk(DEMO.takkReserveNavn)}</b>
            <p>{DEMO.takkTekst}</p>
            <div class="send"><button class="btn" type="button" data-ny>{DEMO.ny}</button></div>
          </div>
        </Flis>
        <Tekstflis bredde="1/2" tittel={KONTAKT.tittel}>
          <p><a href={TEL_HREF}>{DEMO.kontakt.tel}</a> · <a href={MAILTO}>{DEMO.kontakt.epost}</a> · {KONTAKT.adresse} {KONTAKT.demodata}</p>
        </Tekstflis>
      </Rad>
    </Innhold>
  </main>
</Side>

<script>
  import "../scripts/demo";
</script>

<style>
  form, .takk { flex: 1; display: flex; flex-direction: column; min-height: 0; }
  .felter { display: flex; flex-direction: column; gap: 12px; }
  .felt { display: flex; flex-direction: column; gap: 8px; }
  .felt label { font-size: 12px; line-height: 16px; color: var(--tekst-dempet); }
  .inn { height: 40px; padding: 0 12px; box-sizing: border-box; width: 100%; border: 1px solid var(--kant); border-radius: var(--radius-kort-lite); background: var(--flate-kort); color: var(--tekst); font-size: 14px; }
  .inn::placeholder { color: var(--tekst-svak); }
  .inn:focus { outline: none; border-color: var(--aksent); box-shadow: 0 0 0 3px var(--flate-valgt); }
  .inn[aria-invalid="true"] { border-color: var(--status-feil-kant); }
  .felt-feil { font-size: 12px; line-height: 16px; color: var(--feil-tekst); }
  .varsel { margin-top: 12px; padding: 8px 12px; border-radius: var(--radius-kort-lite); background: var(--varsel-flate); color: var(--varsel-tekst); font-size: 14px; line-height: 20px; }
  .varsel a { color: inherit; text-decoration: underline; text-underline-offset: 3px; margin-left: 4px; }
  .send { margin-top: auto; padding-top: 12px; display: flex; justify-content: flex-end; }
  .send .btn { min-height: 36px; padding-inline: 16px; font-size: 14px; font-weight: var(--skrift-vekt-sterk); border-radius: var(--radius-kort-lite); }
  .takk { gap: 8px; }
  .takk-h { font-size: 16px; line-height: 22px; }
  .takk p { color: var(--tekst-dempet); }
</style>

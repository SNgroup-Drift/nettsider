---
/**
 * /ute, sidekartet 25-003 (S-68): toppen og tre rader i nettside-kitet:
 *  rad 1 (120) Status 1/3 ×3 (Uten dekning, KS, Punkter) · rad 2 (480) Tabell «Gjennom dagen» (6 steg) ·
 *  rad 3 (480) Tekst «Virker uten dekning» 1/2 + Tegning «Hengsel Ute, I dag» 1/2 (iPhone-ramme, skjermbildet fra biblioteket på bilder.hengsel.no).
 * N-3c: I dag på iPhone (app/idag-lys.webp fra biblioteket, som første steg i toppen før N-3) til høyre i toppen.
 * Tekster i content/ute.ts.
 */
import Side from "../layouts/Side.astro";
import Enhet from "../components/Enhet.astro";
import Sidetopp from "../components/kit/Sidetopp.astro";
import Innhold from "../components/kit/Innhold.astro";
import Rad from "../components/kit/Rad.astro";
import Flis from "../components/kit/Flis.astro";
import Statusflis from "../components/kit/Statusflis.astro";
import Tabellflis, { tabellHoyde } from "../components/kit/Tabellflis.astro";
import Tekstflis from "../components/kit/Tekstflis.astro";
import { GJENNOM_DAGEN, HERO, STATUS, STEG, TEGNING, UTEN_NETT } from "../content/ute";
const rader = STEG.map((s) => [s.tittel, s.tekst]);
---
<Side
  title="Hengsel Ute – montørappen for iPhone og iPad"
  description={HERO.ingress}
  aktiv="ute"
>
  <main id="innhold">
    <Sidetopp tittel={HERO.tittel} ingress={HERO.ingress}>
      <div class="topp-telefon" slot="komposisjon"><Enhet type="iphone" bilde={HERO.bilde} alt={HERO.alt} forst /></div>
    </Sidetopp>
    <Innhold>
      <Rad hoyde={120}>
        {STATUS.map(([t, p, tone, s]) => <Statusflis tittel={t} pille={p} tone={tone} tekst={s} />)}
      </Rad>
      <Rad hoyde={tabellHoyde(rader.length)}>
        <Tabellflis id="gjennom-dagen" tittel={GJENNOM_DAGEN.tittel} kolonner={GJENNOM_DAGEN.kolonner} rader={rader} />
      </Rad>
      <Rad hoyde={480}>
        <Tekstflis bredde="1/2" tittel={UTEN_NETT.eyebrow}>
          <p>{UTEN_NETT.tittel} {UTEN_NETT.tekst}</p>
        </Tekstflis>
        <Flis bredde="1/2" tittel={TEGNING.tittel} klasse="tegningflis">
          <div class="tegning">
            <div class="telefon"><Enhet type="iphone" bilde={TEGNING.bilde} alt={TEGNING.alt} symboler={false} /></div>
          </div>
        </Flis>
      </Rad>
    </Innhold>
  </main>
</Side>

<style>
  .tegning { flex: 1; min-height: 0; display: grid; place-items: center; padding: 16px; border-radius: var(--radius-kort-lite); background: var(--flate-side); overflow: hidden; }
  .telefon { width: 168px; }
  .topp-telefon { width: min(100%, 260px); margin-inline: auto; }
  @media (max-width: 959px) { .topp-telefon { width: 220px; } }
</style>

---
/**
 * hengsel.no/kunde/hjelp (K-229, før /hjelp): brukerveiledningen for kunder og interessenter Eirik inviterer (K-226). Utkast 0.1, kilde docs/hjelp/hengsel-brukerveiledning.html.
 *
 * Ligger bak Cloudflare Access (e-postkode, samme innlogging som resten av /kunde): Workeren (worker/kunde.ts) svarer 403 på /kunde/* uten gyldig
 * Cf-Access-Jwt-Assertion. Siden har noindex,nofollow, står ikke i sitemap.txt og lenkes ikke fra menyen eller bunnen (scripts/sjekk-lenker.mjs passer på det).
 * Innholdet ligger i src/data/hjelp.ts (samme oppbygging som Hjelp i CRM-et, K-225). Én side med rollevelger øverst; velgeren er ankere, uten skript.
 */
import { PRODUKTLOGO } from "@sngroup/hengsel-tokens/produktlogo";
import Side from "../../layouts/Side.astro";
import Hjelpebunn from "../../components/Hjelpebunn.astro";
import { HJELP, HJELP_OPPGAVER, HJELP_ROLLER, type Skjermbilde } from "../../data/hjelp";
import { skjermbilde } from "@sngroup/hengsel-tokens/skjermbilder.mjs";

// K-233: skjermbildene hentes fra biblioteket på bilder.hengsel.no (hjelp/<id>.webp, 2× med @1x). Hjelp finnes bare i Hengsel-utgave (tema hengsel).
// Et bilde som ikke står i manifestet, vises som plassholderen «Skjermbilde kommer» (data-skjermbilde="hjelp/<id>").
const bilde = (s: Skjermbilde) => skjermbilde("hengsel", `hjelp/${s.id}.webp`, { hd: true });
---
<Side title="Brukerveiledning · Hengsel" description="Brukerveiledning for Hengsel CRM, Hengsel Ute og Min side." robots="noindex,nofollow" utenMeny utenBunn>
  <header slot="hode" class="sidehode">
    <div class="rad h-innhold">
      <a class="logo" href="/" aria-label="Hengsel – til forsiden">
        <picture>
          <img src={PRODUKTLOGO.nettsider.src} alt={PRODUKTLOGO.nettsider.alt} width={PRODUKTLOGO.nettsider.width} height={PRODUKTLOGO.nettsider.height} />
        </picture>
      </a>
      <a class="merke" href="/kunde">‹ Kundeområdet</a>
    </div>
  </header>

  <main id="innhold" class="hjelp">
    <div class="spalte">
      <div class="hode">
        <span class="eyebrow">Hengsel · Håndbok</span>
        <h1>{HJELP.overskrift}</h1>
        <p class="lede">{HJELP.ingress}</p>
        <span class="status">{HJELP.status}</span>
      </div>

      <nav class="roller" aria-label="Velg rolle">
        {HJELP_ROLLER.map((r) => <a href={`#${r.id}`}>{r.valg}</a>)}
      </nav>

      {HJELP_ROLLER.map((r) => {
        const oppgaver = HJELP_OPPGAVER.filter((o) => o.rolle === r.id);
        return (
          <section class="kap" id={r.id} aria-labelledby={`${r.id}-h`}>
            <div class="kap-hode">
              <h2 id={`${r.id}-h`}>{r.kapittel}</h2>
              <p class="dempet">{r.ingress}</p>
            </div>
            {r.meny && (
              <div class="meny">
                {r.meny.map(([gruppe, innhold]) => (
                  <div class="meny-rad"><span class="gr">{gruppe}</span><span>{innhold}</span></div>
                ))}
              </div>
            )}
            <div class:list={["oppgaver", r.rutenett && "rutenett"]}>
              {oppgaver.map((o) => (
                <article class="oppg">
                  <h3>{o.tittel}</h3>
                  {o.menyvei && <p class="vei">{o.menyvei}</p>}
                  {o.tekst && <p>{o.tekst}</p>}
                  {o.steg && <ol>{o.steg.map((s) => <li>{s}</li>)}</ol>}
                  {o.tips && <p class="tips"><b>{o.tips.etikett}:</b> {o.tips.tekst}</p>}
                  {o.skjermbilde && (() => { const b = bilde(o.skjermbilde); return b
                      ? <img class="bilde" src={b.x1?.url ?? b.url} srcset={b.srcset} width={b.x1?.bredde ?? b.bredde} height={b.x1?.hoyde ?? b.hoyde} alt={`Skjermbilde: ${o.skjermbilde.navn}`} loading="lazy" decoding="async" />
                      : <figure class="bilde plassholder" data-skjermbilde={`hjelp/${o.skjermbilde.id}`} role="img" aria-label={`${HJELP.plassholder}: ${o.skjermbilde.navn}`}><b>{HJELP.plassholder}</b><span>{o.skjermbilde.navn}</span></figure>; })()}
                </article>
              ))}
            </div>
            {r.merknad && <p class="dempet liten">{r.merknad}</p>}
          </section>
        );
      })}

      <p class="dempet liten">{HJELP.fotnote}</p>
    </div>
  </main>
  <Hjelpebunn />
</Side>

<style>
  .sidehode { border-bottom: 1px solid var(--line); background: var(--bg); }
  .rad { height: var(--topp); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .logo { display: flex; align-items: center; min-height: 44px; }
  .logo img { display: block; height: 30px; width: auto; }
  .merke { color: var(--muted); font-size: 0.95rem; min-height: 44px; display: inline-flex; align-items: center; }

  .hjelp { padding-block: 32px 72px; }
  .spalte { max-width: 820px; margin: 0 auto; padding-inline: var(--pad); display: grid; gap: 28px; box-sizing: border-box; }
  .hode { display: grid; gap: 10px; justify-items: start; }
  .hode h1 { font-size: clamp(2rem, 6vw, 2.75rem); line-height: 1.05; }
  .dempet { color: var(--muted); }
  .liten { font-size: 0.88rem; }
  .status { display: inline-flex; align-items: center; min-height: 28px; padding: 2px 12px; border-radius: var(--r-pill); background: var(--warn-soft); color: var(--warn); font: 500 0.82rem/1.3 var(--f-body); }

  .roller { position: sticky; top: 0; z-index: 5; display: flex; gap: 6px; overflow-x: auto; padding-block: 10px; background: var(--flate-side); border-bottom: 1px solid var(--line); }
  .roller a { flex: none; display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: var(--r-pill); border: 1px solid var(--line); background: var(--surface); color: var(--muted); font: 500 0.92rem var(--f-body); }
  .roller a:hover, .roller a:focus-visible { color: var(--ink); border-color: var(--accent); text-decoration: none; }

  .kap { display: grid; gap: 14px; }
  .kap-hode { display: grid; gap: 6px; }
  .kap-hode h2 { font-size: 1.75rem; line-height: 1.15; }

  .meny { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 14px 16px; display: grid; gap: 8px; font-size: 0.92rem; }
  .meny-rad { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 12px; align-items: baseline; }
  .gr { font: 600 0.72rem var(--f-body); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }

  .oppgaver { display: grid; gap: 14px; }
  .oppgaver.rutenett { grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .oppg { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 16px; display: grid; gap: 10px; min-width: 0; align-content: start; }
  .oppg h3 { font-size: 1.1rem; line-height: 1.3; font-weight: var(--skrift-vekt-sterk); letter-spacing: 0; }
  .vei { font: 500 0.82rem/1.4 var(--f-body); color: var(--muted); }
  ol { margin: 0; padding-left: 22px; display: grid; gap: 5px; }

  .tips { background: var(--accent-soft); border-radius: var(--r-sm); padding: 10px 12px; font-size: 0.92rem; }
  .tips b { color: var(--aksent-tekst); }

  .bilde { display: block; width: 100%; height: auto; margin: 0; border-radius: var(--radius-bilde); border: 1px solid var(--line); box-sizing: border-box; }
  .plassholder { display: grid; gap: 2px; justify-items: center; padding: 22px 18px; border: 1.5px dashed var(--line); background: var(--surface-soft); color: var(--muted); font-size: 0.88rem; text-align: center; }
  .plassholder b { font-weight: var(--w-medium); color: var(--ink); }
</style>

---
/**
 * hengsel.no/apptest: slik tester du Hengsel Ute (10.10.2026). Fasit: «55 Hengsel apptest.dc.html» i Claude Design-arkivet,
 * samme profil som forsiden. Ingen skript, ingen sporing.
 * Ligger bak passord: Workeren (worker/apptest.ts) slipper bare inn med gyldig informasjonskapsel (K-107).
 *
 * Siden har noindex,nofollow, står ikke i sitemap.txt og lenkes ikke fra forsiden, menyen eller bunnen
 * (scripts/sjekk-lenker.mjs passer på det). Lenker og versjon ligger i src/apptest-lenker.ts; en verdi som begynner
 * med «TODO_» gir en deaktivert knapp («Lenke kommer»).
 */
import BaseLayout from "@sngroup/design/components/BaseLayout.astro";
import "@sngroup/design/fonts.css";
import "../styles/tokens.css";
import "../styles/hengsel.css";
import Enhet from "../components/Enhet.astro";
import UteLogo from "../components/UteLogo.astro";
import { APPTEST, erTodo } from "../apptest-lenker";

const { versjon, epost, oppdatert } = APPTEST;
// «Siste oppdatering»: datoen står som ÅÅÅÅ-MM-DD i apptest-lenker.ts
const oppdatertTekst = new Intl.DateTimeFormat("nb-NO", { day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Oslo" }).format(new Date(`${oppdatert}T12:00:00Z`));
const skrifter = ["/fonts/RecklessStandardM-Regular.woff2", "/fonts/TWKLausanne-350.woff2", "/fonts/TWKLausanne-650.woff2"];

const BOKSER = [
  {
    tittel: "iPhone",
    steg: ["Installer TestFlight fra App Store.", "Åpne lenken under på telefonen.", "Trykk «Installer»."],
    knapp: "Åpne i TestFlight", href: APPTEST.testflight, primar: true,
  },
  {
    tittel: "Android via Google Play",
    steg: ["Åpne lenken under med Google-kontoen du bruker på telefonen.", "Trykk «Bli testbruker».", "Installer fra Play."],
    knapp: "Bli testbruker", href: APPTEST.play, primar: true,
  },
  {
    tittel: "Android uten Play",
    steg: ["Last ned APK-fila på telefonen.", "Tillat installasjon fra ukjent kilde når telefonen spør.", "Åpne fila og installer."],
    knapp: "Last ned APK", href: APPTEST.apk, primar: false,
  },
];

// Faste demobrukere (K-114). Brukernavn = rollen, e-post = brukernavn@demo.invalid. Passordet står ikke her: Workeren setter det inn
// fra hemmeligheten DEMO_PASSORD for innloggede (worker/apptest.ts).
const demoHengsel = [
  ["montor1", "Montør", "I dag, jobbsiden, mål og skisse, KS, avvik og Ferdig montert."],
  ["montor2", "Montør, polsk", "Appen på polsk."],
  ["firmaleder1", "Firmaleder med team", "Forespørsler, svar og fordeling av jobber."],
  ["firmaleder2", "Firmaleder uten ansatte", "Egne jobber og forespørsler."],
  ["firmaleder3", "Firmaleder", "Garderobe, skyvedører og bad."],
  ["utkjorer", "Utkjører", "Ruten, mottak på lager, levering og skade."],
  ["selger1", "Selger", "Selgermodus i appen."],
];
const demoCrm = [
  ["selger1 – selger6", "Selgere i tre butikker (selger2 og selger6 er prosjektselgere)"],
  ["leder", "Leder og admin"],
  ["montasjeleder", "Montasjeleder og bestilling"],
  ["bestilling", "Bestilling"],
  ["superadmin", "Superadmin"],
];

const NYTT = APPTEST.nytt;
// Tre skjermer fra appen i iPhone 18-ramme (pakke CRM_v4, INSTRUKS.md)
const SKJERMER = [
  { bilde: "ute-i-dag", tekst: "I dag", alt: "Hengsel Ute: I dag med neste jobb" },
  { bilde: "ute-ks", tekst: "KS", alt: "Hengsel Ute: KS-sjekkliste" },
  { bilde: "ute-laser", tekst: "Laser", alt: "Laseren kobles til og måler rett inn i bildet" },
];
const KJENT_AVVIK = "";
---
<BaseLayout
  title={`Test Hengsel Ute · Hengsel`}
  description="Slik installerer du testversjonen av Hengsel Ute på iPhone, iPad eller Android."
  robots="noindex,nofollow"
  tema="light"
  temafarge={["#FBF9F6", "#1B1713"]}
  forhandslast={skrifter}
>
  <div class="side">
    <header class="topp">
      <div class="h-innhold rad">
        <UteLogo />
        <a class="tilbake" href="/">‹ Tilbake til hengsel.no</a>
      </div>
    </header>

    <main id="innhold">
      <section class="hero h-innhold">
        <img src="/img/hengsel-app-ikon-lys.svg" alt="" width="96" height="96" class="ikon" />
        <div class="hero-tekst">
          <h1>Test Hengsel Ute</h1>
          <p class="lede">Versjon {versjon}. Du logger inn med kontoen du har fått fra arbeidsgiveren din. Velg telefonen din under.</p>
        </div>
      </section>

      <section class="h-innhold" aria-label="Slik installerer du appen">
        <div class="bokser">
          {BOKSER.map((b) => (
            <article class="boks">
              <h2>{b.tittel}</h2>
              <ol>
                {b.steg.map((s) => <li>{s}</li>)}
              </ol>
              {erTodo(b.href)
                ? <button type="button" class:list={["knapp", { primar: b.primar }]} disabled aria-disabled="true" title="Lenke kommer">{b.knapp}</button>
                : <a class:list={["knapp", { primar: b.primar }]} href={b.href}>{b.knapp}</a>}
            </article>
          ))}
        </div>
      </section>

      <section class="h-innhold demo" aria-labelledby="demo-tittel">
        <div class="demotekst">
          <h2 id="demo-tittel">Prøv med demobrukerne</h2>
          <p class="dempet">I demoen er alt oppdiktet, og ingenting sendes ut. Velg «Demo» nederst på innloggingen i appen, og logg inn med brukernavnet og demopassordet. Alle brukerne har samme passord.</p>
          <div class="passord" data-demopassord hidden>
            <span>Demopassord</span>
            <code data-demopassord-verdi></code>
            <button type="button" class="knapp" data-kopier>Kopier</button>
            <span class="skjult" role="status" data-kopier-status></span>
          </div>
          <p class="dempet" data-uten-demopassord>Passordet får du av den som inviterte deg.</p>
          <p class="merknad">Foreløpig skriver du hele adressen: brukernavnet med <b>@demo.invalid</b> bak, for eksempel <b>montor1@demo.invalid</b>. Snart holder det med <b>montor1</b>.</p>
          <a class="knapp" href="/apptest/Logg_inn_i_demoen.pdf" download>Last ned oversikten (PDF)</a>
        </div>
        <div class="brukerkort">
          <div class="korthode"><h3>I appen</h3><span class="dempet">velg «Demo»</span></div>
          <dl class="brukere">
            {demoHengsel.map(([b, rolle, hva]) => (
              <div><dt><code>{b}</code></dt><dd><span>{rolle}</span><span class="dempet">{hva}</span></dd></div>
            ))}
          </dl>
        </div>
        <div class="brukerkort">
          <div class="korthode"><h3>I CRM-et</h3><span class="dempet">nettleseren</span></div>
          <dl class="brukere">
            {demoCrm.map(([b, rolle]) => (
              <div><dt><code>{b}</code></dt><dd><span>{rolle}</span></dd></div>
            ))}
          </dl>
        </div>
      </section>

      <section class="h-innhold skjermer" aria-label="Slik ser appen ut">
        {SKJERMER.map((k) => (
          <figure>
            <Enhet bilde={k.bilde} type="phone" alt={k.alt} ratio={2.1} zoom={false} />
            <figcaption class="dempet">{k.tekst}</figcaption>
          </figure>
        ))}
      </section>

      <section class="kolonner-baand">
        <div class="h-innhold kolonner">
          <div class="kolonne">
            <h2>Slik melder du feil</h2>
            <ul>
              <li><b>I appen:</b> Meg › Send feilrapport. Skriv hva du gjorde og hva som skjedde. Skjermbilde og logg følger med automatisk.</li>
              <li><b>På e-post:</b> <a href={`mailto:${epost}`}>{epost}</a>.</li>
            </ul>
          </div>
          <div class="kolonne">
            <h2>Hva er nytt i {versjon}</h2>
            <p class="dempet oppdatert">Siste oppdatering: {oppdatertTekst}</p>
            <ul>
              {NYTT.length ? NYTT.map((p) => <li>{p}</li>) : <li class="dempet">Punktene kommer.</li>}
              {KJENT_AVVIK && <li><b>Kjent avvik:</b> {KJENT_AVVIK}</li>}
            </ul>
          </div>
        </div>
      </section>
      <section class="h-innhold testere" aria-labelledby="testere">
        <h2 id="testere">Testere</h2>
        <p>Tilgang har montører, firmaledere, utkjørere og ansatte som er invitert av Hengsel. Nye testere ber om tilgang på <a href={`mailto:${epost}`}>{epost}</a>. Oppgi navn og, for Android, e-postadressen til Google-kontoen på telefonen.</p>
      </section>
    </main>

    <footer class="bunn">
      <div class="h-innhold rad">
        <img src="/img/hengsel-merke-lys.svg" alt="" height="24" class="merke" />
        <span>© 2026 SN Group</span>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  import "../scripts/kopier";
</script>

<style>
  /* Profil: Off White, Warm Black, Deep Blue bare på primærknapper og lenker, linjer 1 px Beige 2, kvadratiske hjørner, ingen skygger */
  .side { min-height: 100vh; display: flex; flex-direction: column; background: var(--off-white); color: var(--warm-black); }
  main { flex: 1; }
  .dempet { color: var(--muted); }
  a { color: var(--deep-blue); }
  .rad { display: flex; align-items: center; justify-content: space-between; gap: 16px 24px; }

  .topp { border-bottom: 1px solid var(--beige-2); }
  .topp .rad { min-height: 64px; padding-block: 10px; }
  .tilbake { font-size: 0.94rem; }
  .merke { height: 24px; width: auto; display: block; }

  .hero { display: flex; align-items: flex-start; gap: clamp(20px, 3vw, 32px); padding-block: clamp(40px, 6vw, 72px) clamp(32px, 5vw, 56px); }
  .ikon { width: 96px; height: 96px; flex: none; display: block; }
  .hero-tekst { display: grid; gap: 16px; }
  h1 { font-size: var(--t-hero); line-height: 1.02; }

  /* Tre kort i Beige 3 uten kantlinje, pillknapper (fil 60 W2) */
  .bokser { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .boks { background: var(--beige-3); padding: 32px; display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .boks h2 { font-size: 1.75rem; line-height: 1.1; }
  ol { margin: 0; padding-left: 1.4em; display: grid; gap: 4px; font-size: 0.94rem; line-height: 1.5; color: var(--muted); }
  ol li::marker { font-weight: 650; }

  .knapp {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; margin-top: auto;
    border: 1px solid var(--warm-black); background: transparent; color: var(--warm-black); font: 500 1rem var(--f-body);
    text-decoration: none; border-radius: var(--r-pill); box-sizing: border-box; white-space: nowrap;
  }
  .knapp.primar { background: var(--deep-blue); border-color: var(--deep-blue); color: var(--off-white); font-weight: 650; }
  .knapp.primar:hover { background: var(--info-tekst); border-color: var(--info-tekst); text-decoration: none; }
  .knapp:disabled { opacity: 0.45; cursor: not-allowed; }
  .knapp:disabled:hover { opacity: 0.45; }

  /* Demobrukerne (K-114): tekst øverst, to brukerkort under */
  .demo { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; align-items: start; padding-block: clamp(40px, 6vw, 72px) 0; }
  .demotekst { display: grid; gap: 16px; justify-items: start; }
  .demotekst h2 { font-size: var(--t-h1); line-height: 1.08; }
  .demotekst p { margin: 0; max-width: 62ch; }
  .merknad { padding: 12px 14px; background: var(--beige-3); font-size: 0.94rem; }
  .passord { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding: 16px 20px; background: var(--beige-3); font-size: 1.125rem; }
  .passord[hidden] { display: none; }
  .passord code { font-family: ui-monospace, Menlo, monospace; font-weight: 650; word-break: break-all; }
  .passord .knapp { min-height: 40px; padding: 0 18px; margin-top: 0; }
  .skjult { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .brukerkort { background: var(--beige-3); padding: 24px 28px; display: grid; gap: 8px; align-content: start; min-width: 0; }
  .korthode { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .korthode h3 { font-size: var(--t-h2); line-height: 1.15; margin: 0; }
  .brukere { margin: 0; display: grid; }
  .brukere > div { display: grid; grid-template-columns: minmax(0, 9rem) minmax(0, 1fr); gap: 4px 16px; padding-block: 10px; border-top: 1px solid var(--beige-2); }
  .brukere dt { font-weight: 650; }
  .brukere dd { margin: 0; display: grid; gap: 2px; }
  .brukere code { font-family: ui-monospace, Menlo, monospace; font-size: 0.95rem; }

  .testere { display: grid; gap: 12px; padding-block: clamp(40px, 6vw, 64px); }
  .testere h2 { font-size: var(--t-h2); line-height: 1.15; }
  .testere p { margin: 0; max-width: 62ch; }

  .skjermer { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 3vw, 40px); max-width: 920px; margin-top: clamp(40px, 6vw, 72px); }
  .skjermer figure { margin: 0; display: grid; gap: 12px; justify-items: center; min-width: 0; }
  .skjermer figcaption { font-size: 0.92rem; }

  .kolonner-baand { background: var(--beige-3); margin-top: clamp(48px, 7vw, 96px); padding-block: clamp(48px, 7vw, 80px); }
  .kolonner { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); }
  .kolonne { display: grid; gap: 16px; align-content: start; }
  .kolonne h2 { font-size: var(--t-h2); line-height: 1.15; }
  .oppdatert { margin: 0; font-size: 0.92rem; }
  .kolonne ul { margin: 0; padding-left: 1.2em; display: grid; gap: 10px; max-width: 62ch; }
  /* Deep Blue gir bare 3,95:1 mot Beige 3; den mørkere blåen fra tokens.css gir 4,5:1 */
  .kolonne a { color: var(--info-tekst); text-decoration: underline; text-underline-offset: 3px; }

  .bunn { background: var(--beige-3); font-size: 0.92rem; color: var(--muted); }
  .bunn .rad { padding-block: 24px; flex-wrap: wrap; }
  .bunn a { color: inherit; }

  @media (min-width: 860px) {
    .bokser { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .kolonner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .demo { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .demotekst { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .hero { flex-direction: column; }
    .knapp { white-space: normal; text-align: center; }
  }
</style>

---
/**
 * hengsel.no/apptest: slik tester du Hengsel Ute (K-172, etter Claude Design «apptest v3», docs/design/hengsel/apptest-v3/).
 * Fasit: Apptest.dc.html og Apptest-valg.md. Komponentene og tokenene er hengsel.no 2.0 (Side, Enhet, Bunn, tokens.css).
 *
 * Ligger bak passord: Workeren (worker/apptest.ts) slipper bare inn med gyldig informasjonskapsel (K-107) og setter demopassordet
 * inn i [data-demopassord] (K-114). Siden har noindex,nofollow, står ikke i sitemap.txt og lenkes ikke fra menyen
 * (scripts/sjekk-lenker.mjs passer på det).
 *
 * Innholdet som endres: lenker, versjon og dato i apptest-lenker.ts; byggene, kjente feil, sjekkliste, roller og spørsmål i apptest-innhold.ts.
 * Siden virker uten skript (scripts/apptest.ts): bildet står stille, alle tre installeringsveiene vises og rollene byttes med radioknapper.
 */
import Side from "../layouts/Side.astro";
import Enhet from "../components/Enhet.astro";
import ApptestHode from "../components/ApptestHode.astro";
import UteMotion from "../components/UteMotion.astro";
import { APPTEST, erTodo } from "../apptest-lenker";
import { BYGG, KJENTE_FEIL, ROLLER, SJEKKLISTE, SPORSMAL } from "../apptest-innhold";
import { lagQr } from "../apptest-qr";
import { EPOST } from "../content/forside";

const { versjon, oppdatert } = APPTEST;
const dato = (iso: string) => new Intl.DateTimeFormat("nb-NO", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "Europe/Oslo" }).format(new Date(`${iso}T12:00:00Z`)); // dd.mm.åååå
const qr = lagQr();

const VEIER = [
  {
    id: "iphone", tittel: "iPhone og iPad", via: "TestFlight", knapp: "Åpne i TestFlight", href: APPTEST.testflight,
    steg: ["Installer TestFlight fra App Store.", "Trykk «Åpne i TestFlight» og så «Installer».", "Åpne Hengsel Ute og logg inn med demobrukeren."],
  },
  {
    id: "android", tittel: "Android", via: "Google Play", knapp: "Bli tester i Google Play", href: APPTEST.play,
    steg: ["Trykk knappen og godta invitasjonen.", "Installer Hengsel Ute fra Google Play.", "Åpne Hengsel Ute og logg inn med demobrukeren."],
  },
  {
    id: "apk", tittel: "Android uten Google Play", via: "APK-fil", knapp: "Last ned APK", href: APPTEST.apk,
    steg: ["Last ned APK-fila.", "Åpne fila og tillat installering fra denne kilden.", "Installer, åpne Hengsel og logg inn."],
  },
];

const SLIDES = [
  { bilde: "idag", navn: "I dag", alt: "Hengsel Ute: I dag med neste jobb, adresse og knappen Jeg er på vei" },
  { bilde: "jobben", navn: "Jobben", alt: "Hengsel Ute: jobben med KS, På vei og tegning" },
  { bilde: "ks", navn: "KS", alt: "Hengsel Ute: KS-sjekkliste punkt for punkt" },
  { bilde: "ferdig", navn: "Ferdig montert", alt: "Hengsel Ute: meld ferdig montert" },
];

// Skjermene er de fiktive demo-skjermene fra designet: iOS-skjermene (img/app, 402 × 874) og rollene uten iOS-skjerm (img/apptest, 2× og 1×, lages av scripts/fiktive-skjermer.mjs)
const APP = new Set(["idag", "jobben", "ks", "avvik", "ferdig"]);
const bildeSrc = (b: string, tema: "lys") => (APP.has(b) ? `/img/app/${b}-${tema}.webp` : `/img/apptest/${b}-${tema}.webp`);
const maal = (b: string) => (APP.has(b) ? { w: 402, h: 874 } : { w: 780, h: 1688 });
const harFeil = KJENTE_FEIL.length > 0;
---
<Side
  delingsbilde="https://hengsel.no/og-apptest.png"
  title="Test Hengsel Ute – testversjon av montørappen"
  description="Slik installerer og tester du testversjonen av Hengsel Ute på iPhone, iPad eller Android."
  robots="noindex,nofollow"
  utenMeny
>
  <ApptestHode slot="hode" meldFeil />
  <main id="innhold" class="a-side">
    <section class="hero" aria-label="Test Hengsel Ute">
      <div class="h-innhold hero-rutenett">
        <div class="hero-tekst">
          <span class="eyebrow">Testversjon {versjon} · sist oppdatert {dato(oppdatert)}</span>
          <h1>Test Hengsel Ute</h1>
          <p class="lede">Appen montørene bruker på jobben. Installer testversjonen, logg inn med demobrukerne og si fra om alt som ikke virker.</p>
          <div class="ikon"><UteMotion class="ikon-motion" /></div>
        </div>
        <div class="hero-bilder">
          <div class="slides">
            {SLIDES.map((s, i) => (
              <div class:list={["slide", { on: i === 0 }]} data-slide aria-hidden={i === 0 ? undefined : "true"}>
                <Enhet type="iphone" src={bildeSrc(s.bilde, "lys")} w={maal(s.bilde).w} h={maal(s.bilde).h} hd={!APP.has(s.bilde)} alt={s.alt} forst={i === 0} symboler={i === 0} />
              </div>
            ))}
          </div>
          <div class="prikker" role="tablist" aria-label="Skjermbilder">
            {SLIDES.map((s, i) => (
              <button type="button" role="tab" class:list={["prikk", { on: i === 0 }]} aria-selected={i === 0 ? "true" : "false"} aria-label={s.navn} data-prikk><span></span></button>
            ))}
          </div>
          <span class="slidenavn" aria-live="polite" data-slidenavn>{SLIDES[0].navn}</span>
        </div>
      </div>
    </section>

    <section id="installer" class="band installer" aria-labelledby="installer-tittel" data-install>
      <div class="h-innhold seksjon">
        <div class="hode">
          <span class="eyebrow">Installer</span>
          <h2 id="installer-tittel"><span class="t-tlf">Installer på telefonen din.</span><span class="t-pc">Åpne siden på telefonen.</span></h2>
        </div>
        <div class="veier">
          <div class="kort qr">
            <div class="qr-rute">
              <svg viewBox={`-2 -2 ${qr.storrelse + 4} ${qr.storrelse + 4}`} width="168" height="168" role="img" aria-label="QR-kode til hengsel.no/apptest" shape-rendering="crispEdges"><path d={qr.sti} /></svg>
            </div>
            <span>Skann med telefonen for å åpne siden der</span>
          </div>
          {VEIER.map((v) => (
            <div class="kort vei" data-vei={v.id}>
              <div class="vei-hode"><b>{v.tittel}</b><span>{v.via}</span></div>
              <ol class="steg">
                {v.steg.map((t, n) => <li><span class="nr">{n + 1}</span><span>{t}</span></li>)}
              </ol>
              {erTodo(v.href)
                ? <button type="button" class="btn primary blokk" disabled aria-disabled="true">Lenke kommer</button>
                : <a class="btn primary blokk" href={v.href}>{v.knapp}</a>}
            </div>
          ))}
          <button type="button" class="andre" data-andre aria-expanded="false">Andre telefoner</button>
        </div>
      </div>
    </section>

    <section class="seksjon-luft" aria-labelledby="roller-tittel">
      <div class="h-innhold seksjon roller">
        <div class="roller-hode">
          <div class="hode">
            <span class="eyebrow">Hva du kan teste</span>
            <h2 id="roller-tittel">Velg rollen din.</h2>
          </div>
        </div>
        {ROLLER.map((r, i) => <input type="radio" class="radio" name="rolle" id={`rolle-${r.id}`} checked={i === 0} />)}
        <div class="chips" role="group" aria-label="Roller">
          {ROLLER.map((r) => <label class="chip" for={`rolle-${r.id}`}>{r.chip}</label>)}
        </div>
        {ROLLER.map((r) => (
          <div class="rollekort" data-rolle={r.id}>
            <div class="rolle-tekst">
              <div class="rolle-hode">
                <h3>{r.tittel}</h3>
                <span class="dempet">{r.under}</span>
              </div>
              <ul class="punkter">
                {r.punkter.map((p) => <li><span aria-hidden="true">→</span><span>{p}</span></li>)}
              </ul>
              <div class="bruker">
                <span class="eyebrow">Demobruker</span>
                <div class="bruker-rad">
                  <div><span class="liten dempet">Brukernavn</span><span class="verdi" id={`bruker-${r.id}`}>{r.bruker}</span></div>
                  <button type="button" class="btn liten-knapp kopier" data-kopier={`#bruker-${r.id}`}>Kopier</button>
                </div>
                <div class="strek"></div>
                <div class="bruker-rad">
                  <div>
                    <span class="liten dempet">Passord</span>
                    <span class="verdi passord" id={`passord-${r.id}`} data-demopassord={r.id}>••••••••</span>
                    <span class="liten dempet" data-uten-demopassord>Passordet får du av den som inviterte deg.</span>
                  </div>
                  <button type="button" class="btn liten-knapp kopier" data-kopier={`#passord-${r.id}`} data-demopassord-knapp hidden>Kopier</button>
                </div>
                {r.merknad && <p class="liten dempet merknad">{r.merknad}</p>}
              </div>
              <a class="pdf" href="/apptest/Logg_inn_i_demoen.pdf" download>Alle demobrukere (PDF)</a>
            </div>
            <div class="rolle-bilde">
              <Enhet type="iphone" src={bildeSrc(r.bilde, "lys")} w={maal(r.bilde).w} h={maal(r.bilde).h} hd={!APP.has(r.bilde)} alt={r.alt} symboler={false} />
            </div>
          </div>
        ))}
        <span class="skjult" role="status" data-kopier-status></span>
      </div>
    </section>

    <section class="band" aria-label="Sjekkliste og hva som er nytt">
      <div class="h-innhold to-kolonner">
        <div class="kolonne">
          <div class="hode">
            <span class="eyebrow">Sjekkliste for {versjon}</span>
            <h2>Dette vil vi at du prøver.</h2>
          </div>
          <div class="kort sjekk" data-sjekk data-versjon={versjon}>
            <div class="sjekk-topp">
              <div class="sjekk-rad">
                <b data-fremdrift>0 av {SJEKKLISTE.length}</b>
                <span class="liten dempet">Huskes bare på denne telefonen</span>
              </div>
              <progress class="stolpe" value="0" max={SJEKKLISTE.length} aria-label="Fremdrift" data-stolpe>0 av {SJEKKLISTE.length}</progress>
            </div>
            <ul class="sjekk-liste">
              {SJEKKLISTE.map((t, i) => (
                <li>
                  <label class="sjekk-punkt">
                    <input type="checkbox" id={`sjekk-${i}`} />
                    <span class="boks" aria-hidden="true"></span>
                    <span class="sjekk-tekst">{t}</span>
                  </label>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="kolonne">
          <div class="hode">
            <span class="eyebrow">Hva er nytt</span>
            <h2>De siste byggene.</h2>
          </div>
          <ol class="tidslinje">
            {BYGG.map((b, i) => (
              <li class:list={["tid", { forst: i === 0, sist: i === BYGG.length - 1 }]}>
                <div class="tid-spor" aria-hidden="true"><span class="prikkt"></span><span class="linje"></span></div>
                <details open={i === 0}>
                  <summary>
                    <span class="tid-tittel">
                      <b>Bygg {b.bygg} · {b.versjon}</b>
                      <span class="dempet">{dato(b.dato)}</span>
                      <span class="dempet liten">{[b.nummer.ios && `iOS ${b.nummer.ios}`, b.nummer.play && `Play ${b.nummer.play}`, b.nummer.apk && `APK ${b.nummer.apk}`].filter(Boolean).join(" · ")}</span>
                    </span>
                    <span class="pil" aria-hidden="true"></span>
                  </summary>
                  <ul>
                    {b.nytt.map((l) => <li>{l}</li>)}
                  </ul>
                </details>
              </li>
            ))}
          </ol>
          <div class="kort feil">
            <div class="feil-hode">
              <b>Kjente feil</b>
              {harFeil && <span class="pille warn">{KJENTE_FEIL.length === 1 ? "1 feil" : `${KJENTE_FEIL.length} feil`}</span>}
            </div>
            {harFeil
              ? (
                <ul class="feil-liste">
                  {KJENTE_FEIL.map((f) => <li><span>{f.tekst}</span>{f.detalj && <span class="liten dempet">{f.detalj}</span>}</li>)}
                </ul>
              )
              : <span class="pille ok">Ingen kjente feil akkurat nå</span>}
          </div>
        </div>
      </div>
    </section>

    <section id="meld-feil" class="seksjon-luft" aria-labelledby="meld-tittel">
      <div class="h-innhold seksjon">
        <div class="hode">
          <span class="eyebrow">Meld feil</span>
          <h2 id="meld-tittel">Si fra om alt som ikke virker.</h2>
        </div>
        <div class="meld-rutenett">
          <div class="kort meld">
            <span class="meld-ikon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="8" r="5" /><path d="M20 21a8 8 0 0 0-16 0" /></svg></span>
            <div><b>Meg › Send feilrapport</b><span class="dempet">i appen</span></div>
          </div>
          <div class="kort meld">
            <span class="meld-ikon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z" /><circle cx="12" cy="13" r="3" /></svg></span>
            <div><b>Ta skjermbilde og send på e-post</b><a href={`mailto:${EPOST}?subject=Feil%20i%20testversjonen`}>{EPOST}</a></div>
          </div>
          <div class="kort meld">
            <span class="meld-ikon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2" /><path d="M12 18h.01" /></svg></span>
            <div><b>TestFlight: rist telefonen</b><span class="pille">Bare iPhone</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="sporsmal-tittel">
      <div class="h-innhold sporsmal">
        <div class="hode">
          <span class="eyebrow">Spørsmål og svar</span>
          <h2 id="sporsmal-tittel">Står du fast?</h2>
        </div>
        <div class="kort faq">
          {SPORSMAL.map((s) => (
            <details>
              <summary><span>{s.q}</span><span class="pluss" aria-hidden="true"></span></summary>
              <p>{s.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</Side>

<script>
  import "../scripts/apptest";
</script>

<style>
  /* Flatene er --flate-senket, båndene --flate-side og kortene --flate-kort. Deep Blue bare på hovedknapper og lenker. Stegnummer, avkrysning, prikker og tidslinje er Warm Black. */
  .a-side { --a-flate: var(--flate-senket); --a-lenke: var(--aksent-tekst); background: var(--a-flate); color: var(--ink); }
  :global(header.sidehode) { --a-flate: var(--flate-senket); --a-lenke: var(--aksent-tekst); }

  .a-side a:not(.btn) { color: var(--a-lenke); }
  .dempet { color: var(--muted); }
  .liten { font-size: 0.88rem; }
  .hode { display: flex; flex-direction: column; gap: 10px; }
  .hode h2 { font-size: clamp(2rem, 3.6vw, 2.9rem); line-height: 1.08; }
  .seksjon { display: flex; flex-direction: column; gap: 28px; }
  .band { background: var(--surface-highlight); padding-block: clamp(48px, 6vw, 88px); }
  .seksjon-luft { padding-block: clamp(48px, 6vw, 88px); }
  .kort { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); box-sizing: border-box; }

  /* Hero */
  .hero { padding-block: clamp(36px, 6vw, 80px) clamp(40px, 6vw, 88px); }
  .hero-rutenett { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: clamp(36px, 6vw, 80px); align-items: center; }
  .hero-tekst { display: flex; flex-direction: column; gap: 20px; min-width: 0; align-items: flex-start; }
  .hero h1 { font-size: clamp(2.75rem, 6vw, 4.6rem); line-height: 1; }
  .hero .lede { font-size: 1.18rem; max-width: 44ch; }
  .ikon { margin-top: 8px; }
  .ikon :global(.ikon-motion) { width: 160px; }
  .hero-bilder { display: flex; flex-direction: column; align-items: center; gap: 14px; min-width: 0; }
  .slides { position: relative; width: 100%; max-width: 320px; }
  .slide { position: absolute; inset: 0; opacity: 0; pointer-events: none; transition: opacity 700ms var(--ease); }
  .slide:first-child { position: relative; }
  .slide.on { opacity: 1; pointer-events: auto; }
  .prikker { display: flex; gap: 2px; align-items: center; visibility: hidden; }
  :global(html.js) .prikker { visibility: visible; }
  .prikk { width: 28px; height: 28px; min-height: 44px; min-width: 44px; margin-inline: -8px; border: 0; background: transparent; padding: 0; display: grid; place-items: center; cursor: pointer; }
  .prikk span { width: 8px; height: 8px; border-radius: var(--radius-pille); background: var(--surface-highlight-strong); transition: background var(--dur); }
  .prikk.on span { background: var(--ink); }
  .slidenavn { font-size: 0.9rem; color: var(--muted); margin-top: -6px; min-height: 1.4em; }
  @media (max-width: 759px) { .slides { max-width: 250px; } }

  /* Installer: PC viser QR-koden og alle tre veiene i fire kort; telefonen én vei med tre steg og en stor knapp */
  .veier { display: flex; flex-direction: column; gap: 16px; max-width: 560px; }
  .qr { display: none; }
  .vei { padding: 22px; display: flex; flex-direction: column; gap: 18px; }
  .vei-hode { display: flex; flex-direction: column; gap: 2px; }
  .vei-hode b { font-weight: var(--w-strong); font-size: 1.1rem; }
  .vei-hode span { color: var(--muted); font-size: 0.95rem; }
  .steg { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .steg li { display: flex; gap: 12px; align-items: flex-start; font-size: 0.98rem; line-height: 1.5; }
  .nr { width: 26px; height: 26px; flex: none; border-radius: var(--radius-pille); border: 1px solid var(--line); background: var(--a-flate); display: grid; place-items: center; font-size: 13px; font-weight: var(--w-strong); font-variant-numeric: tabular-nums; margin-top: 1px; }
  .blokk { width: 100%; }
  .t-pc { display: none; }
  .andre { display: none; align-self: flex-start; min-height: 44px; padding: 0; border: 0; background: transparent; color: var(--a-lenke); font-size: 1rem; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

  /* Uten skript: PC-bredde viser fire kort, smalt viser alle tre veiene under hverandre */
  @media (min-width: 760px) {
    .installer:not([data-modus]) .veier { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); align-items: stretch; max-width: none; }
    .installer:not([data-modus]) .qr { display: flex; }
    .installer:not([data-modus]) .t-pc { display: inline; }
    .installer:not([data-modus]) .t-tlf { display: none; }
  }
  .installer[data-modus="pc"] .veier { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); align-items: stretch; max-width: none; }
  .installer[data-modus="pc"] .qr { display: flex; }
  .installer[data-modus="pc"] .t-pc { display: inline; }
  .installer[data-modus="pc"] .t-tlf { display: none; }
  .qr { padding: 22px; flex-direction: column; align-items: center; justify-content: center; gap: 16px; text-align: center; }
  .qr-rute { background: var(--flate-kort); border-radius: var(--r-field); padding: 12px; line-height: 0; }
  .qr-rute path { fill: var(--tekst); }
  .qr span { font-size: 0.98rem; max-width: 22ch; }

  /* Telefonvisning med skript: hovedveien først, de andre bak «Andre telefoner» */
  .installer[data-modus="tlf"] .hoved, .installer[data-modus="tlf"] .vei.hoved { order: -1; }
  .installer[data-modus="tlf"] .vei.hoved { padding: 22px; gap: 20px; }
  .installer[data-modus="tlf"] .vei.hoved .vei-hode b { font-size: 1.15rem; }
  .installer[data-modus="tlf"] .vei.hoved .btn { min-height: 56px; font-size: 1.05rem; }
  .installer[data-modus="tlf"] .vei:not(.hoved) { display: none; }
  .installer[data-modus="tlf"].andre-apen .vei:not(.hoved) { display: flex; }
  .installer[data-modus="tlf"] .vei:not(.hoved) .btn { background: transparent; color: var(--ink); border-color: var(--ink); }
  .installer[data-modus="tlf"] .andre { display: inline-flex; align-items: center; order: 1; }
  .installer[data-modus="tlf"] .vei:not(.hoved) { order: 2; }

  /* Roller: radioknapper i stedet for skript. Uten skript fungerer fanene også */
  .roller-hode { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 32px; }
  .radio { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: -4px; }
  .chip { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; box-sizing: border-box; border-radius: var(--radius-pille); border: 1px solid var(--ink); background: transparent; color: var(--ink); font: 500 0.95rem var(--f-body); cursor: pointer; transition: background var(--dur) var(--ease), color var(--dur) var(--ease); }
  .chip:hover { background: var(--surface-highlight); }
  .rollekort { display: none; padding: clamp(20px, 3vw, 40px); border-radius: var(--r-lg); grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: clamp(24px, 5vw, 64px); align-items: center; background: var(--surface); border: 1px solid var(--line); box-sizing: border-box; }
  #rolle-montor:checked ~ .rollekort[data-rolle="montor"],
  #rolle-firmaleder:checked ~ .rollekort[data-rolle="firmaleder"],
  #rolle-utkjorer:checked ~ .rollekort[data-rolle="utkjorer"],

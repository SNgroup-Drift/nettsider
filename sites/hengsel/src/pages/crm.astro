---
/**
 * /crm, sidekartet 25-002 (S-68): toppen og to rader i nettside-kitet:
 *  rad 1 (320) Tabell «Før og med Hengsel» (5 rader) · rad 2 (480) Tabell «Samme kundekort for selger, kontor og leder.» (9 rader, CRM_MODULER).
 * Tekster i content/crm.ts. Den klikkbare demoen (K-160) er erstattet av tabellene etter sidekartet; demoen finnes på demo.hengsel.no.
 */
import Side from "../layouts/Side.astro";
import Sidetopp from "../components/kit/Sidetopp.astro";
import Innhold from "../components/kit/Innhold.astro";
import Rad from "../components/kit/Rad.astro";
import Tabellflis, { tabellHoyde } from "../components/kit/Tabellflis.astro";
import { CRM_MODULER, CRM_SIDE as T, FOR_OG_MED, MODULER_KOLONNER } from "../content/crm";
---
<Side title="Hengsel CRM – Min dag, ordre og montasjeplan" description="Hengsel CRM: Min dag, avvik, CET-tegninger og montasjeplan på samme kundekort. Se demoen på demo.hengsel.no." aktiv="crm">
  <main id="innhold">
    <Sidetopp tittel={T.h1} ingress={T.lede} />
    <Innhold>
      <Rad hoyde={tabellHoyde(FOR_OG_MED.rader.length)}>
        <Tabellflis id="for-og-med" tittel={FOR_OG_MED.tittel} kolonner={FOR_OG_MED.kolonner} rader={FOR_OG_MED.rader} />
      </Rad>
      <Rad hoyde={tabellHoyde(CRM_MODULER.length)}>
        <Tabellflis id="moduler" tittel={T.modulerH2} kolonner={MODULER_KOLONNER} rader={CRM_MODULER} />
      </Rad>
    </Innhold>
  </main>
</Side>

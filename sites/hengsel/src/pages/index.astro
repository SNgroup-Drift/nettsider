---
/**
 * Forsiden, sidekartet 25-001 (S-68): toppen med «Prøv selv» til demoen (K-229) og «Be om demo», og tre rader i nettside-kitet:
 *  rad 1 (120) Status 1/3 ×3 · rad 2 (480) Tabell «En dag i butikken» (6 rader) · rad 3 (320) Liste «Bygget for» 1/2 + Tekst «Film» 1/2.
 * Tekster og data i content/forside.ts.
 */
import Side from "../layouts/Side.astro";
import Sidetopp from "../components/kit/Sidetopp.astro";
import Innhold from "../components/kit/Innhold.astro";
import Rad from "../components/kit/Rad.astro";
import Statusflis from "../components/kit/Statusflis.astro";
import Tabellflis, { tabellHoyde } from "../components/kit/Tabellflis.astro";
import Listeflis from "../components/kit/Listeflis.astro";
import Tekstflis from "../components/kit/Tekstflis.astro";
import { BYGGET_FOR, EN_DAG, FILM, HERO, PROV_SELV, STATUS } from "../content/forside";
---
<Side title="Hengsel – CRM, montørapp og kundeportal for kjøkkenbutikker" description={HERO.lede} aktiv="">
  <main id="innhold">
    <Sidetopp tittel={HERO.h1} ingress={HERO.lede}>
      <a class="btn primary" href={PROV_SELV}>{HERO.prov}</a>
      <a class="btn" href="/priser-og-demo#demo">{HERO.demo}</a>
    </Sidetopp>
    <Innhold>
      <Rad hoyde={120}>
        {STATUS.map(([t, p, tone, s]) => <Statusflis tittel={t} pille={p} tone={tone} tekst={s} />)}
      </Rad>
      <Rad hoyde={tabellHoyde(EN_DAG.rader.length)}>
        <Tabellflis id="en-dag" tittel={EN_DAG.tittel} kolonner={EN_DAG.kolonner} rader={EN_DAG.rader} tall />
      </Rad>
      <Rad hoyde={320}>
        <Listeflis id="bygget-for" tittel={BYGGET_FOR.tittel} rader={BYGGET_FOR.rader} />
        <Tekstflis bredde="1/2" tittel={FILM.tittel} tekst={FILM.tekst} />
      </Rad>
    </Innhold>
  </main>
</Side>

<script>
  import "../scripts/gamle-ankere";
</script>

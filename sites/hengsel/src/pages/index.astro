---
/**
 * Forsiden, sidekartet 25-001 (S-68): toppen med «Prøv selv» til demoen (K-229) og «Be om demo», komposisjonen fra før N-3 til høyre i toppen
 * (N-3c: Studio Display med Min dag som HTML i CrmSkjerm, iPhone med I dag fra biblioteket nede til høyre), og tre rader i nettside-kitet:
 *  rad 1 (120) Status 1/3 ×3 · rad 2 (480) Tabell «En dag i butikken» (6 rader) · rad 3 (320) Liste «Bygget for» 1/2 + Tekst «Film» 1/2.
 * Tekster og data i content/forside.ts.
 * N-6: «Fra tilbud til ferdig montert» (simulering på Studio Display, content/simuleringer.ts) og «Tre enheter» under raden «En dag i butikken».
 * N-8: produktkortene (rad 1) har lenken «På telefon» til /telefon (ikke i kundeutgavene).
 * N-6b: bare den første rammen (Studio Display i toppen) definerer statuslinjens symboler (sb-*); alle andre rammer på siden har symboler={false}.
 */
import Side from "../layouts/Side.astro";
import Enhet from "../components/Enhet.astro";
import CrmSkjerm from "../components/CrmSkjerm.astro";
import Sidetopp from "../components/kit/Sidetopp.astro";
import Innhold from "../components/kit/Innhold.astro";
import Rad from "../components/kit/Rad.astro";
import Statusflis from "../components/kit/Statusflis.astro";
import Tabellflis, { tabellHoyde } from "../components/kit/Tabellflis.astro";
import Listeflis from "../components/kit/Listeflis.astro";
import Tekstflis from "../components/kit/Tekstflis.astro";
import Simulering from "../components/Simulering.astro";
import Simuleringsflis from "../components/kit/Simuleringsflis.astro";
import TreEnheter from "../components/TreEnheter.astro";
import { FORSIDE_FLYT } from "../content/simuleringer";
import { kundeFra } from "../kunde";
import { BYGGET_FOR, EN_DAG, FILM, HERO, PROV_SELV, STATUS } from "../content/forside";
// N-8: lenke til /telefon i produktkortene; /telefon finnes ikke i kundeutgavene (/kunde/sigdal)
const telefonLenke = kundeFra(Astro.url.pathname) ? undefined : { tekst: "På telefon", href: "/telefon" };
---
<Side title="Hengsel – CRM, montørapp og kundeportal for kjøkkenbutikker" description={HERO.lede} aktiv="">
  <main id="innhold">
    <Sidetopp tittel={HERO.h1} ingress={HERO.lede}>
      <a class="btn primary" href={PROV_SELV}>{HERO.prov}</a>
      <a class="btn" href="/priser-og-demo#demo">{HERO.demo}</a>
      <div class="komposisjon" slot="komposisjon">
        <div class="pc"><Enhet type="display" forst><CrmSkjerm skjerm="minDag" enhet="pc" /></Enhet></div>
        <div class="iphone"><Enhet type="iphone" bilde="app/idag-lys.webp" alt={HERO.altIphone} symboler={false} /></div>
      </div>
    </Sidetopp>
    <Innhold>
      <Rad hoyde={120}>
        {STATUS.map(([t, p, tone, s]) => <Statusflis tittel={t} pille={p} tone={tone} tekst={s} lenke={telefonLenke} />)}
      </Rad>
      <Rad hoyde={tabellHoyde(EN_DAG.rader.length)}>
        <Tabellflis id="en-dag" tittel={EN_DAG.tittel} kolonner={EN_DAG.kolonner} rader={EN_DAG.rader} tall />
      </Rad>
      <Simuleringsflis id="fra-tilbud-til-montert" tittel="Fra tilbud til ferdig montert" tekst="Slik går en jobb gjennom Hengsel CRM, fra tilbud til etterkalkyle.">
        <Simulering type="display" steg={FORSIDE_FLYT} etikett="Fra tilbud til ferdig montert" />
      </Simuleringsflis>
      <Simuleringsflis id="tre-enheter" tittel="Samme ordre på alle enheter" tekst="Kontoret på Studio Display, butikken på iPad og selgeren på iPhone ser den samme ordren.">
        <TreEnheter />
      </Simuleringsflis>
      <Rad hoyde={320}>
        <Listeflis id="bygget-for" tittel={BYGGET_FOR.tittel} rader={BYGGET_FOR.rader} />
        <Tekstflis bredde="1/2" tittel={FILM.tittel} tekst={FILM.tekst} />
      </Rad>
    </Innhold>
  </main>
</Side>

<script>
  import "../scripts/gamle-ankere";
</script>

<style>
  /* Komposisjonen fra før N-3: Studio Display bak, iPhone nede til høyre over rammen (også på 390) */
  .komposisjon { position: relative; width: 100%; padding-bottom: 6%; }
  .pc { width: 80%; margin-left: auto; margin-right: 4%; }
  .iphone { position: absolute; right: 0; bottom: 0; width: 17%; }
</style>

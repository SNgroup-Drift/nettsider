---
/**
 * hengsel.no – forsiden. Fasit: docs/design/hengsel/56 Hengsel forside.dc.html (Claude Design, 10.10.2026).
 * Fjorten deler: sidehode og bunn (layouts/Side.astro), hero med Min dag på PC, tre løfter, tre flater, sju steg som
 * pillefaner, moduler (11), Hengsel Ute (åtte grep, iPad, utkjører/firmaleder), for kontoret som faner, kundeportalen,
 * integrasjoner og trygghet, priser, om, be om demo (skjema + plantegning). Tekst ordrett i content/forside.ts.
 * Skript (ingen inline, CSP script-src 'self'): fanene (scripts/faner.ts), lysboksen (scripts/lysboks.ts),
 * demoskjemaet (scripts/kontakt.ts), som åpner en ferdig utfylt e-post, og koordinatene i plantegningen
 * (scripts/plantegning.ts). Uten skript vises steg 1 og første rolle. Ingenting lagres. Ingen lenke til /apptest.
 */
import Side from "../layouts/Side.astro";
import Enhet from "../components/Enhet.astro";
import PlantegningEntre from "../components/PlantegningEntre.astro";
import { EPOST, FLOW, GREP, INTEG, KONTOR, LOFTER, MODULER, PORTAL, STEG, TEL, TEL_HREF, TRYGG } from "../content/forside";

const nr = (i: number) => String(i + 1).padStart(2, "0");
---
<Side
  title="Hengsel – kjøkkenbutikkens arbeidsflate"
  description="Hengsel samler salg, bestilling, montering og oppfølging i ett system. CRM på kontoret, Hengsel Ute på telefonen hos kunden."
  delingsbilde="https://hengsel.no/og.png"
  forside
  demo
>
  <main id="innhold">
    <section class="hero" aria-label="Hengsel">
      <div class="h-innhold hero-inn">
        <div class="hero-tekst">
          <span class="eyebrow">For kjøkken- og interiørbutikker</span>
          <h1>Kjøkkenbutikkens arbeidsflate, fra første befaring til siste restpunkt.</h1>
          <p class="lede hero-lede">Hengsel samler salg, bestilling, montering og oppfølging i ett system. CRM på kontoret, Hengsel Ute på telefonen hos kunden.</p>
          <div class="knapper">
            <a class="btn primary" href="#kontakt">Be om demo</a>
            <a class="btn" href="#ute">Se Hengsel Ute</a>
          </div>
        </div>
        <div class="hero-enheter">
          <Enhet bilde="crm-min-dag" type="pc" alt="Min dag i Hengsel CRM: oppgaver og dagens avtaler" ratio={0.8} forst />
          <div class="hero-telefon">
            <Enhet bilde="ute-i-dag" type="phone" alt="I dag i Hengsel Ute: neste jobb med adresse og åpne restpunkter" ratio={2.1} forst />
          </div>
        </div>
      </div>
    </section>

    <section id="produkt" class="seksjon h-flate" aria-label="Tre løfter">
      <div class="h-innhold tre">
        {LOFTER.map(([t, s]) => (
          <article class="card kort"><h2 class="h3">{t}</h2><p class="dempet">{s}</p></article>
        ))}
      </div>
    </section>

    <section id="sammenheng" class="seksjon">
      <div class="h-innhold">
        <div class="hode">
          <span class="eyebrow">Slik henger det sammen</span>
          <h2>Tre flater, samme ordre.</h2>
          <p class="lede">Kontoret jobber i CRM-et, kunden i Min side og montøren i Hengsel Ute. Alt ligger på samme ordre, fra lead til reklamasjon.</p>
        </div>
        <div class="tre">
          {FLOW.map((f) => (
            <article class="card kort"><span class="hvem">{f.who}</span><h3>{f.title}</h3><p class="dempet">{f.text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section id="jobb" class="seksjon h-flate">
      <div class="h-innhold stabel" data-faner>
        <div class="hode-tekst">
          <span class="eyebrow">Sju steg</span>
          <h2>Slik går en jobb gjennom Hengsel.</h2>
          <p class="lede">Trykk på et steg for å se skjermen.</p>
        </div>
        <div role="tablist" aria-label="Steg i jobben" class="faner">
          {STEG.map(([t], i) => (
            <button type="button" role="tab" id={`steg-fane-${i + 1}`} class="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls={`steg-${i + 1}`}>
              <span class="nr">{nr(i)}</span>{t}
            </button>
          ))}
        </div>
        {STEG.map(([t, s, bilde, type, hvor, alt], i) => (
          <div id={`steg-${i + 1}`} role="tabpanel" aria-labelledby={`steg-fane-${i + 1}`} class:list={["steg", type]} data-panel hidden={i !== 0}>
            <div class="steg-tekst">
              <span class="meta">Steg {i + 1} av 7 · {hvor}</span>
              <h3 class="h2">{t}</h3>
              <p class="dempet stor">{s}</p>
              <div class="knapper tett">
                <button type="button" class="btn" data-forrige aria-label="Forrige steg" disabled={i === 0}>← Forrige</button>
                <button type="button" class="btn primary" data-neste aria-label="Neste steg" disabled={i === STEG.length - 1}>Neste →</button>
              </div>
            </div>
            <Enhet bilde={bilde} type={type} alt={alt} ratio={type === "phone" ? 1.1 : 0.8} />
          </div>
        ))}
      </div>
    </section>

    <section id="moduler" class="seksjon">
      <div class="h-innhold">
        <div class="hode">
          <span class="eyebrow">Moduler</span>
          <h2>Start med det dere trenger. Slå på resten etter hvert.</h2>
          <p class="lede">Løsningen er delt i elleve moduler som følger arbeidsflyten. Hver butikk velger hvilke som er på.</p>
        </div>
        <ol class="moduler">
          {MODULER.map(([b, s], i) => (
            <li><span class="meta">{nr(i)}</span><b>{b}</b><span class="dempet liten">{s}</span></li>
          ))}
          <li class="tom" aria-hidden="true"></li>
        </ol>
      </div>
    </section>

    <section id="ute" class="seksjon h-flate">
      <div class="h-innhold stabel-stor">
        <div class="ute-hode">
          <img src="/logo/hengsel-app-ikon-lys.svg" alt="App-ikonet til Hengsel Ute" width="96" height="96" class="ute-ikon" loading="lazy" decoding="async" />
          <div class="hode-tekst">
            <span class="eyebrow">Hengsel Ute</span>
            <h2>Hengsel Ute. Dagen ute, samlet på én skjerm.</h2>
            <p class="lede">Montøren får jobben, tegningene, målene og KS-sjekklista på telefonen. Det som registreres hos kunden, står på ordren hos kontoret med en gang.</p>
            <p class="dempet liten">Hengsel Ute følger med Hengsel, for iPhone, iPad og Android.</p>
          </div>
        </div>
        <div class="grep">
          {GREP.map(([t, s, a, altA, b, altB], i) => (
            <div class:list={["rad", { speilet: i % 2 === 1, to: !!b }]}>
              <div class="rad-tekst">
                <span class="meta">{nr(i)}</span>
                <h3 class="h2">{t}</h3>
                <p class="dempet stor">{s}</p>
              </div>
              <div class="rad-bilder">
                <Enhet bilde={a} type="phone" alt={altA} ratio={1.8} />
                {b && <Enhet bilde={b} type="phone" alt={altB ?? ""} ratio={1.8} />}
              </div>
            </div>
          ))}
        </div>
        <div class="stabel-liten">
          <div class="hode-tekst">
            <h3 class="h2">Merking på iPad</h3>
            <p class="dempet stor bred">Samme bildeverktøy på iPad: bildet til venstre, punktene på kunden i panelet til høyre. Laseren står tilkoblet over målraden.</p>
          </div>
          <Enhet bilde="ute-ipad-bildeverktoy" type="ipad" fit="contain" alt="Bildeverktøyet på iPad: punkter på bildet og punktliste til høyre" ratio={0.75} />
        </div>
        <div class="to">
          <article class="card kort tett-kort">
            <span class="hvem">Også i Hengsel Ute</span>
            <h3>Utkjører</h3>
            <p class="dempet">Ruten for dagen, mottak på lager, levering hos kunden og skade med bilde.</p>
          </article>
          <article class="card kort tett-kort">
            <span class="hvem">Også i Hengsel Ute</span>
            <h3>Firmaleder</h3>
            <p class="dempet">Forespørsler fra butikken, svar og fordeling av jobber på egne montører.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="kontoret" class="seksjon">
      <div class="h-innhold stabel" data-faner>
        <div class="hode-tekst">
          <span class="eyebrow">For kontoret</span>
          <h2>Det kontoret trenger, på én skjerm.</h2>
          <p class="lede">Velg en rolle for å se skjermen.</p>
        </div>
        <div role="tablist" aria-label="Skjermer for kontoret" class="faner">
          {KONTOR.map(([t], i) => (
            <button type="button" role="tab" id={`kontor-fane-${i + 1}`} class="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls={`kontor-${i + 1}`}>{t}</button>
          ))}
        </div>
        {KONTOR.map(([t, s, bilde, alt], i) => (
          <div id={`kontor-${i + 1}`} role="tabpanel" aria-labelledby={`kontor-fane-${i + 1}`} class="kontor" data-panel hidden={i !== 0}>
            <Enhet bilde={bilde} type="pc" alt={alt} ratio={0.8} />
            <div class="steg-tekst">
              <h3 class="h2">{t}</h3>
              <p class="dempet stor">{s}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="kundeportalen" class="seksjon h-flate">
      <div class="h-innhold stabel">
        <div class="portal">
          <div class="hode-tekst">
            <span class="eyebrow">Kundeportalen</span>
            <h2>Kunden følger med selv.</h2>
            <p class="lede">Kunden ser tilvalg, leveringsdag, punkter og FDV-dokumenter på sin egen side. Ingen innlogging å huske, lenken kommer på SMS.</p>
          </div>
          <ul class="punkter">
            {PORTAL.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <Enhet bilde="kundeportalen-pc" type="mac" alt="Kundeportalen: tilbudet med tilvalg, leveringsdag og dokumenter" ratio={0.8} />
      </div>
    </section>

    <section id="integrasjoner" class="seksjon">
      <div class="h-innhold delt to-kol">
        <div class="kolonne">
          <div class="hode-tekst">
            <span class="eyebrow">Integrasjoner</span>
            <h2>Kobler seg på det dere allerede bruker.</h2>
          </div>
          <ul class="integ">
            {INTEG.map(([navn, tekst]) => <li class="card"><b>{navn}</b><span class="dempet liten">{tekst}</span></li>)}
          </ul>
        </div>
        <div class="kolonne">
          <div class="hode-tekst">
            <span class="eyebrow">Trygghet</span>
            <h2>Kort og nøkternt.</h2>
          </div>
          <ul class="trygg">
            {TRYGG.map(([t, s]) => <li><b>{t}</b><span class="dempet liten">{s}</span></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section id="priser" class="seksjon h-flate">
      <div class="h-innhold delt om-grid">
        <div class="hode-tekst">
          <span class="eyebrow">Priser</span>
          <h2>Pris etter antall butikker og brukere.</h2>
        </div>
        <div class="stabel-liten">
          <p class="lede">Dere betaler per butikk per måned, med antall brukere. Ingen bindingstid utover oppsigelsestiden. Vi setter opp løsningen sammen med dere.</p>
          <div><a class="btn primary" href="#kontakt">Be om tilbud</a></div>
        </div>
      </div>
    </section>

    <section id="om" class="seksjon">
      <div class="h-innhold delt om-grid">
        <div class="hode-tekst">
          <span class="eyebrow">Om oss</span>
          <h2>Bygget i en kjøkkenbutikk.</h2>
        </div>
        <div class="om-tekst">
          <p>Hengsel er laget av SN Group, som selv driver kjøkkenbutikker i Innlandet. Vi brukte løsningen i egen drift først, med egne selgere, montører og kunder.</p>
          <p>Det som ikke fungerte i butikken, ble endret. Vi bygde det vi manglet. Nå tilbyr vi det til andre kjøkken- og interiørbutikker i Norden.</p>
          <a href="https://sngroup.no" class="sn">sngroup.no →</a>
        </div>
      </div>
    </section>

    <section id="kontakt" class="seksjon h-flate">
      <div class="h-innhold delt kontakt">
        <div class="kontakt-tekst">
          <span class="eyebrow">Be om demo</span>
          <h2>Se løsningen med deres egne kjøkken.</h2>
          <p class="lede">Vi går gjennom en ordre som ligner deres, fra befaring til faktura. Det tar rundt en time, på Teams eller i butikken.</p>
          <p class="dempet">Eller ta kontakt på <a href={`mailto:${EPOST}`} class="epost">{EPOST}</a> eller <a href={TEL_HREF} class="epost tlf">{TEL}</a></p>
          <div class="plan"><PlantegningEntre /></div>
        </div>
        <form class="card skjema" novalidate data-demo-skjema data-epost={EPOST}>
          <div class="field"><label for="fNavn">Navn</label><input class="input" id="fNavn" name="navn" type="text" autocomplete="name" /></div>
          <div class="field"><label for="fFirma">Butikk</label><input class="input" id="fFirma" name="firma" type="text" autocomplete="organization" /></div>
          <div class="par">
            <div class="field"><label for="fEpost">E-post</label><input class="input" id="fEpost" name="epost" type="email" autocomplete="email" /></div>
            <div class="field"><label for="fTlf">Telefon</label><input class="input" id="fTlf" name="tlf" type="tel" autocomplete="tel" /></div>
          </div>
          <button class="btn primary send" type="submit">Be om demo</button>
          <p class="notis" data-skjema-notis aria-live="polite">Skjemaet åpner en ferdig utfylt e-post i e-postprogrammet ditt. Ingenting lagres på nettsiden.</p>
          <p class="notis">Les hvordan vi behandler henvendelsen i <a href="/personvern">personvernerklæringen</a>.</p>
        </form>
      </div>
    </section>
  </main>

  <dialog class="lysboks" aria-label="Forstørret skjermbilde" data-lysboks>
    <img src="data:," alt="" />
    <button type="button" class="lukk" aria-label="Lukk">×</button>
  </dialog>
</Side>

<script>
  import "../scripts/faner";
  import "../scripts/lysboks";
  import "../scripts/kontakt";
  import "../scripts/plantegning";
</script>

<style>
  .dempet { color: var(--muted); }
  .liten { font-size: 0.95rem; line-height: 1.5; }
  .stor { font-size: 1.08rem; max-width: 44ch; }
  .stor.bred { max-width: 62ch; }
  .meta { font-size: 0.82rem; color: var(--soft); font-variant-numeric: tabular-nums; }
  .hvem { font-size: 0.9rem; color: var(--soft); }
  .h2 { font-size: var(--t-h2); line-height: 1.15; }
  .h3 { font-size: var(--t-h3); line-height: 1.2; }
  .seksjon { padding-block: var(--seksjon); }
  .hode { display: grid; gap: 14px; margin-bottom: clamp(32px, 5vw, 56px); max-width: 760px; }
  .hode-tekst { display: grid; gap: 14px; align-content: start; max-width: 760px; min-width: 0; }
  .stabel { display: grid; gap: clamp(28px, 4vw, 40px); }
  .stabel-stor { display: grid; gap: clamp(32px, 5vw, 56px); }
  .stabel-liten { display: grid; gap: 20px; align-content: start; min-width: 0; }
  .knapper { display: flex; flex-wrap: wrap; gap: 12px; }
  .knapper.tett { gap: 8px; padding-top: 8px; }

  /* Kort: tre i bredden fra 860 px */
  .tre, .to { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .kort { padding: 28px; display: grid; gap: 12px; align-content: start; min-width: 0; }
  .tett-kort { padding: 24px; gap: 8px; }

  /* Hero */
  .hero { padding-block: clamp(48px, 8vw, 104px) clamp(40px, 6vw, 72px); }
  .hero-inn { display: grid; gap: clamp(32px, 5vw, 56px); }
  .hero-tekst { display: grid; gap: 22px; max-width: 820px; }
  .hero-lede { font-size: 1.22rem; }
  /* Studio Display og iPhone sammen. Telefonen står foran skjermens nedre høyre hjørne, litt større enn i virkeligheten (11,6 % av skjermens bredde) for at skjermen skal kunne leses */
  .hero-enheter { position: relative; width: min(856px, 100%); margin-inline: auto; }
  .hero-telefon { position: absolute; right: 2%; bottom: 0; width: 22%; }
  @media (min-width: 700px) { .hero-telefon { width: 18%; } }

  /* Faner (sju steg, for kontoret) */
  .faner { display: flex; flex-wrap: wrap; gap: 8px; }
  .steg, .kontor { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
  .steg-tekst { display: grid; gap: 12px; align-content: start; min-width: 0; }

  /* Moduler: ruter med 1 px skille, radius 14 rundt */
  .moduler {
    list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
    gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden;
  }
  .moduler li { background: var(--surface); padding: 22px 22px 24px; display: grid; gap: 6px; align-content: start; min-width: 0; }

  /* Hengsel Ute */
  .ute-hode { display: flex; flex-direction: column; gap: clamp(20px, 3vw, 40px); align-items: flex-start; }
  .ute-ikon { width: 96px; height: 96px; display: block; flex: none; }
  .grep { display: grid; gap: clamp(40px, 6vw, 80px); }
  .rad { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: center; }
  .rad-tekst { display: grid; gap: 10px; align-content: start; min-width: 0; }
  .rad-bilder { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; justify-items: center; width: 100%; max-width: 360px; justify-self: center; }
  .rad.to .rad-bilder { max-width: none; }

  /* Integrasjoner og trygghet, priser, om, be om demo: to kolonner fra 860 px */
  .delt { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  /* Kundeportalen: tekst (7/12) og punktene (5/12) bunnjustert over skjermen i full bredde; én kolonne på mobil */
  .portal { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: end; }
  .punkter { list-style: none; margin: 0; padding: 0; display: grid; align-self: end; }
  .punkter li { padding: 12px 0; border-top: 1px solid var(--line); color: var(--muted); }
  .kolonne { display: grid; gap: 20px; align-content: start; min-width: 0; }
  .integ { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .integ li { padding: 18px 22px; display: grid; gap: 4px; align-content: start; min-width: 0; }
  .trygg { list-style: none; margin: 0; padding: 0; display: grid; }
  .trygg li { padding: 14px 0; border-top: 1px solid var(--line); display: grid; gap: 2px; }
  .om-tekst { display: grid; gap: 16px; color: var(--muted); font-size: 1.08rem; min-width: 0; }
  .sn { font-weight: 650; color: var(--ink); justify-self: start; }

  .kontakt-tekst { display: grid; gap: 18px; align-content: start; min-width: 0; }
  .epost { font-weight: 650; color: var(--ink); }
  .tlf { white-space: nowrap; }
  .plan { width: 100%; max-width: 440px; margin-top: 8px; }
  .skjema { display: grid; gap: 14px; padding: clamp(20px, 3vw, 32px); border-radius: var(--r-lg); min-width: 0; align-self: start; }
  .par { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 14px; }
  .send { justify-self: start; }
  .notis { font-size: 0.88rem; color: var(--muted); }
  .notis a { text-decoration: underline; text-underline-offset: 3px; } /* lenke i løpende tekst: ikke bare farge */

  @media (max-width: 579px) { .moduler .tom { display: none; } }
  @media (min-width: 860px) {
    .tre { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .to { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* Samme kolonnedeling og fast minste høyde uansett om steget viser telefon eller PC, så siden ikke flytter seg */
    .steg { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); min-height: 720px; }
    .kontor { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); }
    .ute-hode { flex-direction: row; }
    .rad { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .rad.speilet { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .rad.to { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
    .rad.to.speilet { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); }
    .rad.speilet .rad-tekst { order: 2; }
    .rad.speilet .rad-bilder { order: 1; justify-self: start; }
    .rad:not(.speilet) .rad-bilder { justify-self: end; }
    .rad.to .rad-bilder { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .portal { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .to-kol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .om-grid { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); }
    .kontakt { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
  }

  /* Lysboks: ensfarget bakgrunn, bildet i full størrelse, Esc eller klikk lukker */
  .lysboks {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; border: 0;
    background: var(--lysboks); padding: clamp(12px, 3vw, 40px); cursor: zoom-out; box-sizing: border-box;
  }
  .lysboks[open] { display: grid; place-items: center; }
  .lysboks::backdrop { background: var(--lysboks); }
  .lysboks img { max-width: 100%; max-height: 92vh; width: auto; height: auto; object-fit: contain; }
  .lukk {

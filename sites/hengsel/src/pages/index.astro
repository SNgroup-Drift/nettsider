---
/**
 * Forsiden (Forside.dc.html), kortet ned i K-229: hero med Studio Display (CRM Min dag) og iPhone, «Prøv selv» til demoen, tre løfter, «Se nærmere på» og demo.
 * Tekster og data i content/forside.ts, ordrett fra LES-MEG.md. Skjermen i Studio Display er HTML (CrmSkjerm), ikke bilde;
 * bare den rammen lastes med en gang, appbildet i iPhone er lazy og hentes fra biblioteket på bilder.hengsel.no (K-233). Ingen skript utover Enhets skalering.
 */
import Side from "../layouts/Side.astro";
import Enhet from "../components/Enhet.astro";
import CrmSkjerm from "../components/CrmSkjerm.astro";
import { DEMO, HERO, LOFTER, NARMERE, PROV_SELV, TEL, TEL_HREF } from "../content/forside";
---
<Side title="Hengsel – CRM, montørapp og kundeportal for kjøkkenbutikker" description="Hengsel er løsningen for kjøkken- og interiørbutikker. Salg, tilbud, bestilling, montasje og kundeportal ligger på samme ordre og samme kundekort." aktiv="">
  <main id="innhold">
    <section class="hero">
      <div class="h-innhold hero-inn">
        <div class="tekst">
          <span class="eyebrow">{HERO.eyebrow}</span>
          <h1>{HERO.h1}</h1>
          <p class="lede">{HERO.lede}</p>
          <div class="knapper">
            <a class="btn primary" href={PROV_SELV}>{HERO.prov}</a>
            <a class="btn" href="/priser-og-demo#demo">{HERO.demo}</a>
          </div>
        </div>
        <div class="komposisjon">
          <div class="pc">
            <Enhet type="display" forst><CrmSkjerm skjerm="minDag" enhet="pc" /></Enhet>
          </div>
          <div class="iphone">
            <Enhet type="iphone" bilde="app/idag-lys.webp" alt={HERO.altIphone} />
          </div>
        </div>
      </div>
    </section>

    <section class="sek flate">
      <div class="h-innhold lofter">
        {LOFTER.map(([nr, t, s]) => (
          <div class="card lofte"><span class="nr">{nr}</span><h2>{t}</h2><p>{s}</p></div>
        ))}
      </div>
    </section>

    <section class="sek flate">
      <div class="h-innhold narmere-inn">
        <h2>{NARMERE.h2}</h2>
        <div class="kort-rutenett">
          {NARMERE.kort.map(([t, s, cta, href]) => (
            <a class="kort" href={href}>
              <span class="kt">{t}</span>
              <span class="ks">{s}</span>
              <span class="kc">{cta} →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="sek">
      <div class="h-innhold demo">
        <div class="demo-tekst"><h2>{DEMO.h2}</h2><p class="lede">{DEMO.tekst}</p></div>
        <div class="knapper">
          <a class="btn primary" href="/priser-og-demo#demo">{DEMO.knapp}</a>
          <a class="btn" href={TEL_HREF}>{TEL}</a>
        </div>
      </div>
    </section>
  </main>
</Side>

<script>
  import "../scripts/gamle-ankere";
</script>

<style>
  .hero { padding-block: clamp(40px, 6vw, 80px) clamp(48px, 6vw, 88px); }
  .hero-inn { display: flex; flex-direction: column; gap: clamp(32px, 5vw, 56px); }
  .tekst { display: flex; flex-direction: column; gap: 20px; max-width: 820px; }
  .knapper { display: flex; flex-wrap: wrap; gap: 12px; }
  .tekst .knapper { padding-top: 4px; }

  /* Komposisjonen: Studio Display bak, iPad nede til venstre og iPhone nede til høyre overlapper rammen (som i designet, også på 390) */
  .komposisjon { position: relative; width: 100%; padding-bottom: 6%; }
  .pc { width: 80%; margin-left: auto; margin-right: 4%; }
  .iphone { position: absolute; right: 0; bottom: 0; width: 17%; }

  .lofter { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .lofte { padding: 24px 26px; display: flex; flex-direction: column; gap: 10px; }
  .lofte .nr { font-size: 0.82rem; font-weight: 500; letter-spacing: 0.06em; color: var(--muted); }
  .lofte h2 { font-size: 1.75rem; line-height: 1.15; }
  .lofte p { color: var(--muted); }

  .narmere-inn { display: flex; flex-direction: column; gap: 32px; }
  .kort-rutenett { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .kort { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-kort-stor); padding: 22px 24px; display: flex; flex-direction: column; gap: 8px; color: var(--ink); text-decoration: none; min-height: 150px; box-sizing: border-box; }
  .kort:hover { border-color: var(--ink); text-decoration: none; }
  .kt { font-family: var(--f-display); font-weight: var(--skrift-vekt-fet); font-size: 1.6rem; line-height: 1.15; }
  .ks { color: var(--muted); font-size: 0.98rem; line-height: 1.55; flex: 1; }
  .kc { color: var(--accent); font-weight: 500; font-size: 0.95rem; }

  .demo { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px 48px; }
  .demo-tekst { display: flex; flex-direction: column; gap: 12px; max-width: 620px; }
</style>

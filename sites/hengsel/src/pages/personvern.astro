---
import Side from "../layouts/Side.astro";
import PrivacyPage from "../components/PrivacyPage.astro";
import { personvern } from "../content/personvern";
---
<Side title="Personvern · Hengsel" description="Personvernerklæring for nettsiden hengsel.no.">
  {/* Astro fjerner HTML-kommentarer fra malen; set:html legger den inn i kildekoden til siden, uten å vises */}
  <Fragment set:html="<!-- TODO: ny personverntekst kommer -->" />
  <main id="innhold" class="personvern">
    <PrivacyPage {...personvern} />
  </main>
</Side>

<style>
  .personvern { flex: 1; }
  .personvern :global(h2) { font-size: var(--t-h2); }
  .personvern :global(.boks) { background: var(--flate-side); }
</style>

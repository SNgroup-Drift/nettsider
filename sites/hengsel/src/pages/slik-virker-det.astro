---
import Side from "../layouts/Side.astro";
import { SLIK, SCENER, VIDERE } from "../content/slikvirker";
const n = SCENER.length;
---
<Side title={SLIK.tittel} description={SLIK.beskrivelse} aktiv="slik">
  <main id="innhold">
    <section class="sek sv" data-slik>
      <div class="h-innhold sv-in">
        <div class="sv-hode">
          <span class="eyebrow">{SLIK.eyebrow}</span>
          <h1>{SLIK.h1}</h1>
          <p class="lede">{SLIK.ingress}</p>
        </div>

        <div class="sv-faner" role="tablist" aria-label={SLIK.scenerLabel}>
          {SCENER.map((s, i) => (
            <button type="button" role="tab" id={`scene-fane-${i + 1}`} class="sv-fane" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} aria-controls={`scene-${i + 1}`}>
              <span class="nr">{i + 1}</span>
              <span class="navn">{s.t}</span>
            </button>
          ))}
        </div>

        <div class="sv-scener">
          {SCENER.map((s, i) => (
            <article class="sv-scene" id={`scene-${i + 1}`} data-scene aria-labelledby={`scene-tittel-${i + 1}`}>
              <div class="sv-tekst">
                <span class="eyebrow">Scene {i + 1} av {n}</span>
                <h2 id={`scene-tittel-${i + 1}`}>{s.t}</h2>
                <p class="sv-s">{s.s}</p>
                <div class="sv-nav">
                  <button type="button" class="sv-prev" data-forrige aria-label={SLIK.forrigeLabel} disabled={i === 0}>‹</button>
                  <button type="button" class="btn" data-neste disabled={i === n - 1}>{i < n - 1 ? SLIK.neste + SCENER[i + 1].t : SLIK.ferdig}</button>
                </div>
              </div>

              <div class="sv-ser">
                <div class="sv-ser-hode">
                  <span class="eyebrow">{SLIK.selgerenSer}</span>
                  {s.eksempel && <span class="eks">{SLIK.eksempel}</span>}
                </div>
                {s.ser.map(([t, u, merke, tone], r) => (
                  <div class:list={["sv-rad", r === 0 && "forst", tone === "bad" && r === 0 && "avvik"]}>
                    <span class="sv-ring" aria-hidden="true"></span>
                    <span class="sv-rad-tekst"><span class="t">{t}</span><span class="u">{u}</span></span>
                    <span class:list={["sv-merke", tone]}>{merke}</span>
                  </div>
                ))}
                <span class="sv-hvor">{SLIK.visesI}{s.hvor}.</span>
              </div>

              <div class="sv-bak">
                <span class="eyebrow">{SLIK.bakKulissene}</span>
                <ul>
                  {s.bak.map((b) => <li><span class="pil" aria-hidden="true">→</span><span>{b}</span></li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sek flate">
      <div class="h-innhold sv-videre">
        {VIDERE.map((v) => (
          <a href={v.href} class:list={["sv-kort", v.primar && "primar"]}>
            <span class="kt">{v.t}</span>
            <span class="ks">{v.s}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Side>

<script>
  import "../scripts/slik.ts";
</script>

<style>
  .sv { padding-block: clamp(40px, 6vw, 72px) clamp(48px, 6vw, 88px); }
  .sv-in { display: flex; flex-direction: column; gap: 32px; }
  .sv-hode { display: flex; flex-direction: column; gap: 16px; max-width: 780px; }
  .sv-hode h1 { font-size: clamp(2.5rem, 5.6vw, 4.6rem); }

  /* Uten JS: ingen fanelinje, alle scener som liste */
  .sv-faner { display: none; grid-template-columns: repeat(auto-fit, minmax(128px, 1fr)); gap: 8px; }
  .sv:global(.js) .sv-faner { display: grid; }
  .sv-fane {
    display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 12px 14px; min-height: 88px;
    border-radius: var(--r); border: 1px solid var(--line); background: var(--surface); color: var(--ink);
    font: inherit; cursor: pointer; box-sizing: border-box; text-align: left;
  }
  .sv-fane:hover { border-color: var(--ink); }
  .sv-fane[aria-selected="true"] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .nr { font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--muted); }
  .sv-fane[aria-selected="true"] .nr { color: var(--bg); opacity: 0.72; }
  .navn { font-size: 0.92rem; line-height: 1.3; }

  .sv-scener { display: flex; flex-direction: column; gap: 24px; }
  .sv-scene {
    background: var(--surface-highlight); border-radius: var(--r-lg); padding: clamp(20px, 4vw, 40px);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: clamp(20px, 3vw, 32px); align-items: start;
  }
  .sv-tekst { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .sv-tekst h2 { font-size: clamp(2rem, 3.6vw, 2.8rem); }
  .sv-s { color: var(--muted); font-size: 1.05rem; }
  .sv-nav { display: none; gap: 8px; padding-top: 8px; flex-wrap: wrap; }
  .sv:global(.js) .sv-nav { display: flex; }
  /* Med skript på: samme utseende fra første tegning, så scenene ikke hopper når skriptet starter (CLS) */
  @media (scripting: enabled) {
    .sv-faner { display: grid; }
    .sv-nav { display: flex; }
    .sv:not(:global(.js)) .sv-scene:not(:first-of-type) { display: none; }
  }
  .sv-prev {
    width: 44px; height: 44px; border-radius: var(--radius-pille); border: 1px solid var(--line); background: var(--surface);
    color: var(--ink); font-size: 18px; cursor: pointer;
  }
  .sv-prev:hover:not(:disabled) { border-color: var(--ink); }
  .sv-prev:disabled { opacity: 0.45; cursor: not-allowed; }

  .sv-ser { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 20px 22px; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .sv-ser-hode { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 6px; }
  .sv-rad { display: flex; gap: 12px; align-items: flex-start; padding: 12px 10px; border-radius: var(--radius-kort-lite); }
  .sv-rad.forst { background: var(--surface-highlight); }
  .sv-rad.avvik { box-shadow: inset 3px 0 0 var(--bad); }
  .sv-ring { width: 18px; height: 18px; border-radius: var(--radius-pille); border: 1.5px solid var(--beige-1); flex: none; margin-top: 3px; }
  .sv-rad-tekst { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .t { font-size: 0.98rem; overflow-wrap: anywhere; }
  .u { font-size: 0.85rem; color: var(--muted); overflow-wrap: anywhere; }
  .sv-merke { display: inline-flex; align-items: center; min-height: 24px; padding: 0 10px; border-radius: var(--radius-pille); font: 500 0.78rem/1 var(--f-body); white-space: nowrap; flex: none; background: var(--surface-highlight-strong); color: var(--ink); }
  .sv-merke.info { background: var(--surface-highlight-strong); color: var(--info-tekst); }
  .sv-merke.ok { background: var(--ok-soft); color: var(--ok); }
  .sv-merke.warn { background: var(--warn-soft); color: var(--warn); }
  .sv-merke.bad { background: var(--bad-soft); color: var(--bad); }
  .sv-hvor { font-size: 0.85rem; color: var(--muted); padding-top: 8px; }

  .sv-bak { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .sv-bak ul { margin: 0; padding: 0; list-style: none; }
  .sv-bak li { display: flex; gap: 12px; padding: 12px 0; border-top: 1px solid var(--line); }
  .pil { flex: none; }

  .sv-videre { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .sv-kort {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 22px 24px;
    display: flex; flex-direction: column; gap: 6px; color: var(--ink); text-decoration: none;
  }
  .sv-kort:hover { border-color: var(--ink); text-decoration: none; }
  .sv-kort.primar { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .sv-kort.primar:hover { opacity: 0.88; }
  .kt { font-family: var(--f-display); font-size: 1.6rem; }
  .ks { color: var(--muted); }
  .sv-kort.primar .ks { color: inherit; }
</style>

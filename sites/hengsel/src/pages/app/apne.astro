---
/**
 * Fallback for app-lenkene (K-170): https://hengsel.no/app/jobb/<id> og /app/foresporsel/<id>.
 * Har telefonen appen, åpner iOS den direkte via universal links (public/.well-known/apple-app-site-association) og denne siden vises ikke.
 * Uten appen åpnes lenken i nettleseren; _redirects skriver alle disse stiene om til denne siden (200), så adressen er uendret.
 * Ingen skript og ingen innlogging. noindex,nofollow.
 */
import Side from "../../layouts/Side.astro";
---
<Side title="Åpne i Hengsel Ute · Hengsel" description="Lenken åpnes i Hengsel Ute-appen." robots="noindex,nofollow" utenMeny>
  <header slot="hode" class="hode"><a href="/" class="merke">Hengsel</a></header>
  <main id="innhold" class="apne">
    <h1>Åpne i Hengsel Ute</h1>
    <p class="ingress">Denne lenken skal åpnes i Hengsel Ute-appen. Har du appen, trykker du på lenken igjen fra meldingen du fikk, så åpnes jobben i appen.</p>
    <p>Har du ikke appen ennå, finner du den på testsiden.</p>
    <p><a class="btn primary" href="/apptest">Hent Hengsel Ute</a></p>
    <p class="dempet">Du må være innlogget i appen for å se jobben.</p>
  </main>
</Side>

<style>
  .hode { padding: 20px var(--gutter, 16px); }
  .merke { font-family: var(--f-display); font-size: 1.25rem; color: var(--ink); text-decoration: none; }
  .apne { max-width: 34rem; margin: 0 auto; padding: 48px var(--gutter, 16px) 96px; }
  .apne h1 { font-size: var(--t-h2); margin: 0 0 16px; }
  .apne p { margin: 0 0 16px; }
  .ingress { font-size: 1.125rem; }
  .dempet { color: var(--tekst-dempet); font-size: 0.9rem; }
</style>

# Omdirigeringer for hengsel.no (Cloudflare Workers, statiske filer).
#
# www → apex: _redirects støtter bare stier, ikke domener, så www.hengsel.no sendes til https://hengsel.no med en
# Redirect Rule i Cloudflare-sonen. Se docs/hosting.md, «www til apex».
#
# Ankrene på dagens forside (/#produkt, /#ute, /#priser, /#kontakt …) flyttes til egne sider (hengsel.no 2.0, K-160).
# Ankere (#…) sendes ikke til tjeneren og kan ikke omdirigeres her; de tas hånd om av scripts/gamle-ankere.ts på forsiden.
# Her står stiene, for lenker som er skrevet som /produkt, /kontakt osv.
/produkt            /crm                 301
/kontoret           /crm                 301
/kundeportalen      /kundeportal         301
/jobb               /                    301
/priser             /priser-og-demo      301
/kontakt            /priser-og-demo#demo 301
/demo               /priser-og-demo#demo 301
/om                 /                    301

# App-lenker (K-170, K-200): uten appen åpnes lenken i nettleseren. Én side svarer for alle id-er (200 = omskriving, ikke omdirigering,
# så adressen står uendret og iOS kan åpne appen fra den). Siden sender PC videre til CRM-et (src/content/crm-lenke.mjs). /.well-known/* røres ikke.
/app/jobb/*         /app/lenke           200
/app/foresporsel/*  /app/lenke           200

# Kundeområdet (K-229): hjelp, dokumenter og kundens egen utgave bor under /kunde, bak én innlogging (Cloudflare Access, worker/kunde.ts). Gamle adresser
# videresendes med 301, også undersider. Omdirigeringen viser ikke noe innhold, så den trenger ikke innlogging.
# /apptest er ikke med her: passordet gjelder til Access står foran /kunde, så flyttes den av Workeren (APPTEST_VIDERE, worker/index.ts).
# «Slik virker det» (historien) hører hjemme i Visningsrommet (vis.hengsel.no), ikke på hengsel.no
/slik-virker-det    /                            301
/hjelp              /kunde/hjelp                 301
/hjelp.html         /kunde/hjelp                 301
/hjelp/*            /kunde/hjelp/:splat          301
/dokumenter         /kunde/dokumenter            301
/dokumenter.html    /kunde/dokumenter            301
/dokumenter/*       /kunde/dokumenter/:splat     301
/sigdal             /kunde/sigdal                301
/sigdal/*           /kunde/sigdal/:splat         301

// Cloudflare Worker for hengsel: statiske filer fra ./dist. Bygg med `npm run build -w sites/hengsel` først. Se docs/hosting.md.
// Skriptet (worker/index.ts) kjører BARE for /apptest og alt under (passordet, K-107, worker/apptest.ts), for
// /api/demo (demoskjemaet, K-160, worker/demo.ts) og for /sigdal og alt under (kundeutgaven for Sigdal, K-223, worker/sigdal.ts: 403 uten
// Cloudflare Access, noindex og no-store). Resten av hengsel.no serveres som statiske filer uten kode. Hemmelighetene APPTEST_PASSORD, APPTEST_NOKKEL og DEMO_PASSORD (K-114, vises på
// /apptest for innloggede) settes med
// `npx wrangler secret put … -c sites/hengsel/wrangler.jsonc`, aldri i repoet.
// Workers Builds: både Deploy command og Non-production branch deploy command må ha `-c sites/hengsel/wrangler.jsonc`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hengsel",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Bare disse stiene går gjennom skriptet først
    "run_worker_first": ["/apptest", "/apptest/*", "/api/demo", "/sigdal", "/sigdal/*"],
    // Ukjente sider får dist/404.html med status 404
    "not_found_handling": "404-page",
    // /personvern serverer personvern.html; /personvern.html sendes til /personvern
    "html_handling": "auto-trailing-slash"
  }
  // Demoskjemaet (/api/demo): e-postsending er IKKE slått på ennå (Eirik 11.10). Uten send_email-bindingen svarer ruten 200 og siden viser
  // mailto-lenken til hei@hengsel.no uten feilmelding. Slå på e-post senere ved å legge denne blokken tilbake (ingen kodeendring) etter å ha
  // fulgt docs/k160-cloudflare-skjema.md (Email Routing på hengsel.no, hei@hengsel.no verifisert som destinasjon):
  //   "send_email": [{ "name": "DEMO_EPOST", "destination_address": "hei@hengsel.no" }]
}

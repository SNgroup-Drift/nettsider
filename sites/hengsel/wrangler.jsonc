// Cloudflare Worker for hengsel: statiske filer fra ./dist. Bygg med `npm run build -w sites/hengsel` først. Se docs/hosting.md.
// Skriptet (worker/index.ts) kjører BARE for /kunde og alt under (kundeområdet bak Cloudflare Access, K-229, worker/kunde.ts: hjelp, apptest, dokumenter og
// kundens egen utgave), for /api/demo (demoskjemaet, K-160, worker/demo.ts) og for /apptest og alt under (passordet, K-107, worker/apptest.ts, til Access står
// foran /kunde; se APPTEST_VIDERE i worker/index.ts). /kunde/* deler Access-sjekken i worker/access.ts (403 uten gyldig token, også når ACCESS_TEAM_DOMAIN
// og ACCESS_AUD mangler). Resten av hengsel.no serveres som statiske filer uten kode; gamle adresser (/hjelp, /dokumenter, /sigdal) videresendes av
// public/_redirects. Hemmelighetene APPTEST_PASSORD, APPTEST_NOKKEL og DEMO_PASSORD (K-114, settes bare inn på /apptest bak eget passord, aldri på /kunde/*) settes med
// `npx wrangler secret put … -c sites/hengsel/wrangler.jsonc`, aldri i repoet.
// Access (K-226): variablene ACCESS_TEAM_DOMAIN («<team>.cloudflareaccess.com») og ACCESS_AUD (AUD-taggen til Access-appen; flere skilles med komma) er ikke
// hemmeligheter, men settes i dashbordet (Worker → Settings → Variables and Secrets), ikke her. keep_vars sørger for at utrulling ikke overskriver dem.
// K-240: leaden fra /api/demo sendes også til Hengsel Admin når variabelen LEAD_URL (https://admin.hengsel.no/api/lead) er satt i dashbordet; AV som standard.
// Hemmeligheten LEAD_NOKKEL (valgfri, samme verdi i begge Workerne) settes med `npx wrangler secret put LEAD_NOKKEL -c sites/hengsel/wrangler.jsonc`.
// Workers Builds: både Deploy command og Non-production branch deploy command må ha `-c sites/hengsel/wrangler.jsonc`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hengsel",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Bare disse stiene går gjennom skriptet først. Gamle adresser (/hjelp, /dokumenter, /sigdal) har ingen filer lenger og videresendes av public/_redirects
    "run_worker_first": ["/apptest", "/apptest/*", "/api/demo", "/kunde", "/kunde/*"],
    // Ukjente sider får dist/404.html med status 404
    "not_found_handling": "404-page",
    // /personvern serverer personvern.html; /personvern.html sendes til /personvern
    "html_handling": "auto-trailing-slash"
  }
  // Demoskjemaet (/api/demo): e-postsending er IKKE slått på ennå (Eirik 11.10). Uten send_email-bindingen svarer ruten 200 og siden viser
  // mailto-lenken til hei@hengsel.no uten feilmelding. Slå på e-post senere ved å legge denne blokken tilbake (ingen kodeendring) etter å ha
  // fulgt docs/k160-cloudflare-skjema.md (Email Routing på hengsel.no, hei@hengsel.no verifisert som destinasjon):
  //   "send_email": [{ "name": "DEMO_EPOST", "destination_address": "hei@hengsel.no" }]
}

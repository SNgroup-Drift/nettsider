# Sikkerhetshoder for admin.hengsel.no (K-184, K-240). Ingen inline-skript, ingen tredjepart, ingen indeksering. connect-src 'self' er API-et (/api) i samme Worker.
# CSS-en ligger inline; scripts/csp-hasher.mjs legger sha256-hashene til style-src i dist/_headers ved bygging.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Filer med hash i navnet endres aldri (Workeren sender fortsatt «private» fordi alt ligger bak Access)
/_astro/*
  Cache-Control: private, max-age=31536000, immutable
/fonts/*
  Cache-Control: private, max-age=31536000, immutable

// Cloudflare Worker «admin» (admin.hengsel.no, K-184, K-240): Astro-sider fra ./dist bak Cloudflare Access, og et JSON-API mot D1.
// ALLE forespørsler går gjennom worker/index.js først (run_worker_first), og Workeren avviser alt som ikke har en gyldig
// Cf-Access-Jwt-Assertion for riktig Access-app og riktig e-postadresse (unntak: POST /api/lead fra hengsel.no, som har eget vern).
// Variablene ACCESS_TEAM_DOMAIN (f.eks. «<team>.cloudflareaccess.com») og ACCESS_AUD (Application Audience-taggen til Access-appen)
// er ikke hemmeligheter, men settes i dashbordet (Worker → Settings → Variables and Secrets), ikke her; keep_vars sørger for at
// utrulling ikke overskriver dem. Mangler en av dem, svarer Workeren 503 og viser ingenting.
// K-240: Databasen er D1 med binding DB. Migreringene ligger i ./migrations og kjøres med
//   npx wrangler d1 migrations apply hengsel-admin --remote -c sites/admin/wrangler.jsonc   (lokalt: --local)
// Hemmeligheter (settes med `npx wrangler secret put <navn> -c sites/admin/wrangler.jsonc`, aldri her): PENNEO_API_KEY (Penneo er av uten den),
// LEAD_NOKKEL (valgfritt ekstra vern på /api/lead). Variabler: LEAD_ORIGIN (standard https://hengsel.no), PENNEO_API_URL.
// K-259: Hemmelighet HJELP_NOKKEL (valgfri) for POST /api/hjelp. Skjermbilder fra «Hjelp» lagres i R2 med binding SKJERMBILDER; bøtta
//   «hengsel-admin-skjermbilder» finnes ikke ennå, så bindingen står kommentert ut under. Uten den lagres saken uten bilde (claude/k259-rapport.md).
// Workers Builds: både Deploy command og Preview command (eldre Workers: Non-production branch deploy command) må ha `-c sites/admin/wrangler.jsonc`. Se claude/k184-rapport.md og claude/k240-rapport.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "admin",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  // N-4: «admin» er en ny Worker i Workers Builds, så grenbygg (forhåndsvisning) kjører Preview command `npx wrangler preview`, og den stopper
  // uten en previews-blokk («Your Wrangler configuration is missing a `previews` block»). Blokken er tom med vilje: en Preview arver ikke
  // D1, R2 eller variabler fra produksjon, så forhåndsvisningen får verken produksjonsdatabasen eller ACCESS_* og svarer 503 (låst), aldri åpent.
  // Skal forhåndsvisningen vise sider, settes ACCESS_* som Preview-variabler i dashbordet og en egen D1 legges her (se claude/n4-rapport.md).
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hengsel-admin",
      // Databasen «hengsel-admin» (weur) ble laget 15.10.2026 av Oversikt; 0001_fase_a.sql er kjørt mot den.
      "database_id": "1fc32fd1-3d0c-4eae-b6ca-88e45d71c4bd",
      "migrations_dir": "migrations"
    }
  ]
  // K-259: slå på når bøtta er laget (npx wrangler r2 bucket create hengsel-admin-skjermbilder --location weur):
  // ,"r2_buckets": [{ "binding": "SKJERMBILDER", "bucket_name": "hengsel-admin-skjermbilder" }]
}

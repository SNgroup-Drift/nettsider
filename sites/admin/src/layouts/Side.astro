---
/**
 * Ramme for admin.hengsel.no (K-184): Hengsel-profilen, topplinje med søk, og navigasjon (Plattform øverst, så kundene).
 * Lys og mørk følger systemet. Aldri indeksert.
 */
import BaseLayout from "@sngroup/design/components/BaseLayout.astro";
import "@sngroup/design/fonts.css";
import "../styles/profil.css";
import "../styles/admin.css";
import { kunder } from "../lib/data";

interface Props { title: string; description: string; aktiv?: string; sokplassholder?: string }
const { title, description, aktiv = "", sokplassholder = "Søk i lenker og kontoer" } = Astro.props;
const seksjoner = [["lenker", "Lenker"], ["kontoer", "Kontoer"], ["frister", "Frister"], ["rutiner", "Rutiner"]];
---
<BaseLayout
  title={title}
  description={description}
  robots="noindex, nofollow, noarchive"
  temafarge={["#FBF9F6", "#1F1914"]}
  ikon={{ href: "/favicon.svg", type: "image/svg+xml" }}
  ikon32="/favicon-32.png"
  appleIkon="/favicon-180.png"
>
  <div class="ramme">
    <header class="topp">
      <a class="merke" href="/" aria-label="Hengsel Admin, til forsiden">
        <img class="lys" src="/logo/symbol-lys.svg" alt="" width="28" height="28" />
        <img class="mork" src="/logo/symbol-mork.svg" alt="" width="28" height="28" />
        <span>Hengsel Admin</span>
      </a>
      <div class="sok" role="search">
        <label for="sok">Søk</label>
        <input id="sok" type="search" placeholder={sokplassholder} autocomplete="off" spellcheck="false" />
      </div>
    </header>

    <div class="rad">
      <nav class="meny" aria-label="Hovedmeny">
        <p class="etikett">Plattform</p>
        <ul>
          <li><a href="/" aria-current={aktiv === "plattform" ? "page" : undefined}>Oversikt</a></li>
          {seksjoner.map(([id, navn]) => <li class="under"><a href={`/#${id}`}>{navn}</a></li>)}
        </ul>
        <p class="etikett">Kunder</p>
        <ul>
          <li><a href="/kunder" aria-current={aktiv === "kunder" ? "page" : undefined}>Alle kunder</a></li>
          {kunder.map((k) => (
            <li data-sok-nav data-sok={`${k.navn} ${k.id}`.toLowerCase()}>
              <a href={`/kunder/${k.id}`} aria-current={aktiv === k.id ? "page" : undefined}>
                {k.navn}{k.eksempel && <span class="eksempel"> (eksempel)</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <main id="innhold">
        <p class="treff" id="treff" role="status" aria-live="polite"></p>
        <slot />
      </main>
    </div>
  </div>
  <script>
    import "../scripts/admin";
  </script>
</BaseLayout>

---
/**
 * Felles ramme for alle sidene: <head>, tokens og grunnstil.
 * Skriftene importeres av hvert nettsted (sngroup.no og hengsel.no: @sngroup/design/fonts.css), så byggem.no
 * kan bruke Poppins og Inter uten å laste Newsreader.
 * Ingen sporing, ingen informasjonskapsler, ingen eksterne ressurser.
 */
import "../styles/tokens.css";
import "../styles/base.css";
import newsreader from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import inter from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /** Sti uten domene, f.eks. "/" eller "/personvern" */
  path?: string;
  noindex?: boolean;
  /** og:description når den skal være kortere enn description */
  ogBeskrivelse?: string;
  /** Delingsbilde som full URL, f.eks. https://byggem.no/delingsbilde.png */
  delingsbilde?: string;
  /** Favikon (sti og type). Standard: /favicon.svg */
  ikon?: { href: string; type: string };
  /** apple-touch-icon (sti) */
  appleIkon?: string;
  /** Favikon i PNG, 32 × 32 (sti), for nettlesere som ikke viser SVG */
  ikon32?: string;
  /** Web-app-manifest (sti), f.eks. /manifest.webmanifest */
  manifest?: string;
  /** Fargen i nettleserens adressefelt: [lys, mørk] */
  temafarge?: [string, string];
  /** Skriftfiler som skal forhåndslastes. Standard: Newsreader og Inter (sngroup.no og hengsel.no) */
  forhandslast?: string[];
  /** Overstyrer robots-taggen, f.eks. "noindex, nofollow" */
  robots?: string;
  /** Låser fargemodus (data-theme på <html>), f.eks. "light" på forsiden til hengsel.no. Standard: følger systemet */
  tema?: "light" | "dark";
}

const {
  title,
  description,
  path = Astro.url.pathname,
  noindex = false,
  ogBeskrivelse = description,
  delingsbilde,
  ikon = { href: "/favicon.svg", type: "image/svg+xml" },
  appleIkon,
  ikon32,
  manifest,
  temafarge = ["#F7F5F1", "#1F1914"],
  forhandslast = [newsreader, inter],
  robots,
  tema,
} = Astro.props;
// Nettstedene bygger med build.format «file» og trailingSlash «never», så Astro.url.pathname er «/index.html» og
// «/personvern.html». Adressene som publiseres er «/» og «/personvern» (html_handling auto-trailing-slash i Workers).
const renSti = path.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
const canonical = Astro.site ? new URL(renSti, Astro.site).href : undefined;
---
<!doctype html>
<html lang="nb" data-theme={tema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {(robots || noindex) && <meta name="robots" content={robots ?? "noindex"} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogBeskrivelse} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    {delingsbilde && <meta property="og:image" content={delingsbilde} />}
    {delingsbilde && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="theme-color" content={temafarge[0]} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={temafarge[1]} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={ikon.href} type={ikon.type} />
    {ikon32 && <link rel="icon" href={ikon32} sizes="32x32" />}
    {appleIkon && <link rel="apple-touch-icon" href={appleIkon} />}
    {manifest && <link rel="manifest" href={manifest} />}
    {forhandslast.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body>
    <a class="skip" href="#innhold">Hopp til innholdet</a>
    <slot />
  </body>
</html>

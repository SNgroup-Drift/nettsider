  "skrift": {
    "$merknad": "Hengsel har ETT skriftsett: Schibsted Grotesk (variabel woff2, vekt 400–800, OFL, selvhostet; ingen Google Fonts-lenke) til tekst, tall, knapper, felt og overskrifter i CRM, admin, nettsidene og montørappen (Expo). Hengsel Ute (SwiftUI) bruker SF Pro (system) og røres ikke her. Kundetemaet beholder sine skrifter (Inter og Newsreader ligger igjen i assets/fonts/ for kundeportalen og PDF). Tall i tabeller bruker tabular-nums (egenskap.tabell); ikke på store visningstall med komma eller kolon.",
    "familie": {
      "hengsel": {
        "tekst": "'Schibsted Grotesk', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif",
        "overskrift": "'Schibsted Grotesk', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif"
      },
      "ios": {
        "tekst": "system"
